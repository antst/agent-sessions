#!/usr/bin/env python3
"""Create one non-secret OS gate manifest for immutable release evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import re
import subprocess


GATES = (
    "normal", "race", "vet", "lint", "focused_contracts", "quickstart",
    "permissions", "federation", "prebuilt_install", "owner_nonmutation",
)


def version(command: list[str]) -> str:
    result = subprocess.run(command, check=True, text=True, stdout=subprocess.PIPE,
                            stderr=subprocess.STDOUT)
    line = next((row.strip() for row in result.stdout.splitlines() if row.strip()), "")
    if not line or len(line) > 256:
        raise SystemExit(f"invalid version output from {command[0]}")
    return line


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--os", choices=("linux", "macos"), required=True)
    parser.add_argument("--job-url", required=True)
    parser.add_argument("--evidence-dir", type=pathlib.Path, required=True)
    parser.add_argument("--output", type=pathlib.Path, required=True)
    args = parser.parse_args()
    if not re.fullmatch(r"https://github\.com/.+/actions/runs/[0-9]+/job/[0-9]+", args.job_url):
        raise SystemExit("job URL is not an exact GitHub Actions job URL")

    gates: dict[str, object] = {}
    for gate in GATES:
        name = f"{args.os}-{gate}.txt"
        path = args.evidence_dir / name
        if not path.is_file() or path.is_symlink() or path.stat().st_size == 0:
            raise SystemExit(f"required gate evidence is missing or unsafe: {path}")
        gates[gate] = {
            "status": "passed",
            "job_url": args.job_url,
            "evidence_artifact": name,
            "evidence_sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        }

    document = {
        "toolchain": {
            "go": version(["go", "version"]),
            "golangci_lint": version(["bin/tools/golangci-lint", "version"]),
        },
        "native_clients": {
            "qwen": version(["qwen", "--version"]),
            "codex": version(["codex", "--version"]),
            "claude": version(["claude", "--version"]),
            "grok": version(["grok", "--version"]),
        },
        "gates": gates,
    }
    args.output.parent.mkdir(parents=True, exist_ok=True)
    temporary = args.output.with_name(f".{args.output.name}.tmp")
    temporary.write_text(json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n",
                         encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
