#!/usr/bin/env bash
set -euo pipefail

# Real Qwen lifecycle acceptance. The caller must provide an already
# authenticated, test-owned Qwen profile; this runner never copies credentials
# from another profile and never falls back to the owner's default profile.
: "${QWEN_TEST_HOME:?set QWEN_TEST_HOME to an authenticated test-owned Qwen profile}"
: "${QWEN_TEST_RUNTIME_DIR:?set QWEN_TEST_RUNTIME_DIR to its test-owned runtime directory}"
[[ "$QWEN_TEST_HOME" == /* && "$QWEN_TEST_RUNTIME_DIR" == /* ]] || {
  printf 'QWEN_TEST_HOME and QWEN_TEST_RUNTIME_DIR must be absolute\n' >&2
  exit 2
}

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  link_target="$(readlink -- "$script_path")"
  [[ "$link_target" == /* ]] && script_path="$link_target" || script_path="$script_dir/$link_target"
done
root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"
operator_codex_home="${CODEX_HOME:-$HOME/.codex}"
temporary_parent="$(cd -P -- "${TMPDIR:-/tmp}" && pwd)"
[[ "$(uname -s)" == Darwin ]] && temporary_parent=/tmp
test_root="$(mktemp -d "$temporary_parent/qwen-lane-contract.XXXXXX")"
agent_pid=
success=false
cleanup() {
  owned_pids="$test_root/cleanup-owned-pids"
  : >"$owned_pids"
  snapshot_owned_pids() {
    python3 - "$test_root" >>"$owned_pids" <<'PY' || true
import json, pathlib, sys
for path in pathlib.Path(sys.argv[1]).rglob("*.json"):
    try:
        row = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        continue
    if not isinstance(row, dict) or row.get("type") != "qwen-peer-lane":
        if path.name == "supervisor.json" and isinstance(row, dict):
            pid = row.get("pid")
            if isinstance(pid, int) and pid > 1:
                print(pid)
        continue
    for key in ("managerPid", "workerPid", "managerPID", "workerPID"):
        pid = row.get(key)
        if isinstance(pid, int) and pid > 1:
            print(pid)
PY
  }
  snapshot_owned_pids
  if [[ -x "${lane:-}" && -n "${AGENT_SESSIONS_AGENT_RUNTIME_DIR:-}" &&
        -S "$AGENT_SESSIONS_AGENT_RUNTIME_DIR/agent.sock" ]]; then
    cleanup_list="$test_root/cleanup-list.jsonl"
    cleanup_ids="$test_root/cleanup-ids"
    "$lane" list >"$cleanup_list" 2>/dev/null || true
    python3 - "$cleanup_list" >"$cleanup_ids" <<'PY' || true
import json, sys
for line in open(sys.argv[1], encoding="utf-8"):
    if not line.strip():
        continue
    row = json.loads(line)
    if not isinstance(row, dict):
        continue
    for lane in row.get("lanes", []):
        if not isinstance(lane, dict):
            continue
        thread_id = lane.get("threadId") or lane.get("thread_id")
        if thread_id:
            print(thread_id)
PY
    while IFS= read -r cleanup_id; do
      [[ -n "$cleanup_id" ]] && "$lane" archive "$cleanup_id" >/dev/null 2>&1 || true
    done <"$cleanup_ids"
  fi
  snapshot_owned_pids
  if [[ -n "$agent_pid" ]]; then
    kill "$agent_pid" 2>/dev/null || true
    wait "$agent_pid" 2>/dev/null || true
  fi
  if [[ -x "${runtime:-}" ]]; then
    "$runtime" supervisor stop >/dev/null 2>&1 || true
  fi
  if [[ -n "${CODEX_HOME:-}" && -x "$CODEX_HOME/packages/standalone/current/codex" ]]; then
    "$CODEX_HOME/packages/standalone/current/codex" app-server daemon stop >/dev/null 2>&1 || true
  fi
  live_identities=
  while IFS= read -r process_id; do
    if [[ "$process_id" =~ ^[0-9]+$ ]] && kill -0 "$process_id" 2>/dev/null; then
      live_identities+=" $process_id"
    fi
  done < <(sort -nu "$owned_pids")
  if [[ "$success" != true ]]; then
    while IFS= read -r diagnostic; do
      printf '===== %s =====\n' "$diagnostic" >&2
      sed -n '1,400p' "$diagnostic" >&2 || true
    done < <(find "$test_root" -type f \( -name '*.log' -o -name '*.err' \) -print 2>/dev/null | sort)
  fi
  if [[ -n "$live_identities" ]]; then
    printf 'Qwen lane contract preserved %s because live owned PIDs remain:%s\n' \
      "$test_root" "$live_identities" >&2
    return
  fi
  /usr/bin/find "$test_root" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

export QWEN_HOME="$QWEN_TEST_HOME"
export QWEN_RUNTIME_DIR="$QWEN_TEST_RUNTIME_DIR"
# The operator shell may itself be a managed peer. This isolated lifecycle
# test must not borrow that unrelated parent identity or notification target.
unset CODEX_SESSION_ID CODEX_THREAD_ID AGENT_SESSIONS_SESSION_ID \
  AGENT_SESSIONS_PRODUCT AGENT_SESSIONS_QWEN_CAPABILITY
export CLAUDE_PEER_DATA_DIR="$test_root/state"
export CLAUDE_PEER_CLAUDE_CONFIG_DIR="$test_root/claude"
export CODEX_HOME="$test_root/codex"
export XDG_RUNTIME_DIR="$test_root/xdg-runtime"
export XDG_STATE_HOME="$test_root/xdg-state"
export AGENT_SESSIONS_AGENT_RUNTIME_DIR="$test_root/agent-runtime"
mkdir -p "$CLAUDE_PEER_DATA_DIR" "$CLAUDE_PEER_CLAUDE_CONFIG_DIR" "$CODEX_HOME" \
  "$XDG_RUNTIME_DIR" "$XDG_STATE_HOME" "$AGENT_SESSIONS_AGENT_RUNTIME_DIR"
[[ -d "$operator_codex_home/packages/standalone" && ! -L "$operator_codex_home/packages/standalone" ]] || {
  printf 'Qwen lane contract requires an installed Codex standalone package at %s\n' \
    "$operator_codex_home/packages/standalone" >&2
  exit 2
}
mkdir -p "$CODEX_HOME/packages"
ln -s -- "$operator_codex_home/packages/standalone" "$CODEX_HOME/packages/standalone"

make -s -C "$root" build
platform="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
case "$platform" in
  linux-x86_64) platform=linux-x64 ;;
  linux-aarch64) platform=linux-arm64 ;;
  darwin-x86_64) platform=darwin-x64 ;;
  darwin-arm64) ;;
  *) printf 'unsupported Qwen contract platform %s\n' "$platform" >&2; exit 2 ;;
esac
binary_root="$root/bin/$platform"
lane="$binary_root/qwen-peer-lane"
federator="$binary_root/peer-federator"
runtime="$binary_root/agent-session-runtime"

"$federator" agent --host qwen-lane-contract --runtime-dir "$AGENT_SESSIONS_AGENT_RUNTIME_DIR" \
  --state-dir "$test_root/agent-state" --claude-config-dir "$CLAUDE_PEER_CLAUDE_CONFIG_DIR" \
  >"$test_root/agent.out" 2>"$test_root/agent.err" &
agent_pid=$!
for _ in {1..200}; do
  [[ -S "$AGENT_SESSIONS_AGENT_RUNTIME_DIR/agent.sock" ]] && break
  sleep 0.025
done
[[ -S "$AGENT_SESSIONS_AGENT_RUNTIME_DIR/agent.sock" ]] || {
  printf 'Qwen contract host agent did not start\n' >&2
  exit 1
}

doctor="$test_root/doctor.jsonl"
"$lane" doctor --json --qwen-home "$QWEN_TEST_HOME" -C "$root" >"$doctor"
python3 - "$doctor" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
assert rows and rows[-1].get("type") == "lane.doctor", rows
assert rows[-1].get("ok") is True, rows[-1]
assert rows[-1].get("archive_contract") == "ready", rows[-1]
PY

# Conflicting permission choices must fail before any worker or durable lane is
# created.
before="$test_root/before.jsonl"
"$lane" list --all >"$before"
set +e
printf 'never executed\n' | "$lane" start --name qwen-conflict --qwen-home "$QWEN_TEST_HOME" \
  --yolo --approval-mode plan - >"$test_root/conflict.out" 2>"$test_root/conflict.err"
conflict_status=$?
set -e
[[ "$conflict_status" -eq 2 ]] || { printf 'permission conflict exit=%s, want 2\n' "$conflict_status" >&2; exit 1; }
after="$test_root/after.jsonl"
"$lane" list --all >"$after"
cmp -s "$before" "$after" || { printf 'permission conflict mutated Qwen lane inventory\n' >&2; exit 1; }

run_mode() {
  local label="$1" token="$2"
  shift 2
  local output="$test_root/$label.jsonl"
  printf 'Return only the exact token %s and nothing else.\n' "$token" | \
    "$lane" run --name "qwen-$label" --qwen-home "$QWEN_TEST_HOME" -C "$root" \
      --persistent --no-auto-archive "$@" - >"$output"
  python3 - "$output" "$token" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
ready = next(row for row in rows if row.get("type") == "lane.ready")
terminal = next(row for row in rows if row.get("type") == "turn.completed")
answers = [row.get("item", {}).get("text", "") for row in rows if row.get("item", {}).get("phase") == "final_answer"]
assert terminal.get("outcome") == "completed" and terminal.get("exit") == 0, terminal
assert answers and answers[-1].strip() == sys.argv[2], answers
print(ready["thread_id"])
PY
}

start_mode() {
  local label="$1" prompt="$2"
  shift 2
  local output="$test_root/$label-start.jsonl"
  printf '%s\n' "$prompt" | \
    "$lane" start --name "qwen-$label" --qwen-home "$QWEN_TEST_HOME" -C "$root" \
      --persistent --no-auto-archive "$@" - >"$output"
  python3 - "$output" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
ready = next(row for row in rows if row.get("type") == "lane.ready")
print(ready["thread_id"])
PY
}

lane_status_is() {
  local thread_id="$1" expected="$2"
  local output="$test_root/status-$thread_id.jsonl"
  "$lane" status "$thread_id" >"$output" 2>/dev/null || return 1
  python3 - "$output" "$expected" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
raise SystemExit(0 if rows and rows[-1].get("status") == sys.argv[2] else 1)
PY
}

kill_exact_lane_role() {
  local thread_id="$1" role="$2"
  python3 - "$test_root" "$thread_id" "$role" <<'PY'
import json, os, pathlib, signal, subprocess, sys

root, thread_id, role = pathlib.Path(sys.argv[1]), sys.argv[2], sys.argv[3]
matches = []
for path in root.rglob("*.json"):
    try:
        row = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        continue
    if isinstance(row, dict) and row.get("type") == "qwen-peer-lane" and row.get("threadId") == thread_id:
        matches.append((path, row))
if len(matches) != 1:
    raise SystemExit(f"exact Qwen lane state count for {thread_id} = {len(matches)}")
_, state = matches[0]
prefix = "manager" if role == "manager" else "worker"
pid = state.get(prefix + "Pid")
expected_start = state.get(prefix + "ProcStart")
if not isinstance(pid, int) or pid <= 1 or not isinstance(expected_start, str) or not expected_start:
    raise SystemExit(f"Qwen {role} identity is incomplete: pid={pid!r} start={expected_start!r}")
if sys.platform == "linux":
    body = pathlib.Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    close = body.rfind(")")
    fields = body[close + 1:].split()
    actual_start = fields[19]
    argv = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().rstrip(b"\0").replace(b"\0", b" ").decode(errors="replace")
else:
    environment = dict(os.environ, LC_ALL="C", TZ="UTC")
    actual_start = subprocess.check_output(["ps", "-p", str(pid), "-o", "lstart="], env=environment, text=True).strip()
    argv = subprocess.check_output(["ps", "-p", str(pid), "-o", "command="], text=True).strip()
expected_argv = "qwen-lane-manager" if role == "manager" else "--acp"
if actual_start != expected_start or expected_argv not in argv:
    raise SystemExit(
        f"refuse Qwen {role} signal: pid={pid} start={actual_start!r}/{expected_start!r} argv={argv!r}"
    )
print(json.dumps({"role": role, "pid": pid, "proc_start": expected_start, "argv": argv}, separators=(",", ":")))
os.kill(pid, signal.SIGKILL)
PY
}

default_id="$(run_mode default QWEN_LANE_DEFAULT_OK)"
non_yolo_id="$(run_mode non-yolo QWEN_LANE_NON_YOLO_OK --no-yolo)"
yolo_id="$(run_mode yolo QWEN_LANE_YOLO_OK --yolo)"
plan_id="$(run_mode plan QWEN_LANE_PLAN_OK --approval-mode plan)"

# Follow-up work remains on the exact live Agent Sessions/native transcript.
printf 'Return only QWEN_LANE_FOLLOWUP_OK and nothing else.\n' | \
  "$lane" resume "$default_id" --qwen-home "$QWEN_TEST_HOME" --persistent --no-auto-archive - \
    >"$test_root/follow-up.jsonl"
python3 - "$test_root/follow-up.jsonl" "$default_id" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
assert all(row.get("thread_id", sys.argv[2]) == sys.argv[2] for row in rows), rows
answers = [row.get("item", {}).get("text", "") for row in rows if row.get("item", {}).get("phase") == "final_answer"]
assert answers and answers[-1].strip() == "QWEN_LANE_FOLLOWUP_OK", answers
PY

# Exercise a real active native turn and the common interrupted/130 contract.
interrupt_id="$(start_mode interrupt \
  "Use the bash tool to run 'sleep 120' and wait for it before responding." --yolo)"
interrupt_active=false
for _ in {1..200}; do
  if lane_status_is "$interrupt_id" active; then interrupt_active=true; break; fi
  sleep 0.05
done
[[ "$interrupt_active" == true ]] || { printf 'Qwen interrupt turn never became active\n' >&2; exit 1; }
"$lane" interrupt "$interrupt_id" >"$test_root/interrupt.jsonl"
set +e
"$lane" wait "$interrupt_id" >"$test_root/interrupt-wait.jsonl"
interrupt_status=$?
set -e
[[ "$interrupt_status" -eq 130 ]] || { printf 'Qwen interrupt wait exit=%s, want 130\n' "$interrupt_status" >&2; exit 1; }
python3 - "$test_root/interrupt-wait.jsonl" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
terminal = next(row for row in rows if row.get("type") == "turn.completed")
assert terminal.get("status") == "interrupted", terminal
assert terminal.get("outcome") == "interrupted", terminal
assert terminal.get("exit") == 130, terminal
PY

# Crash an idle manager after collection. Forced archive must retire its exact
# worker and every owned endpoint/tool root without broad process discovery.
manager_crash_id="$(run_mode manager-crash QWEN_LANE_MANAGER_CRASH_OK --yolo)"
kill_exact_lane_role "$manager_crash_id" manager >"$test_root/manager-crash-identity.json"
"$lane" archive "$manager_crash_id" >"$test_root/manager-crash-archive.jsonl"

# Crash the exact ACP worker. The manager must observe EOF, retire itself, and
# archive; an explicit archive is allowed only as a deterministic reconciliation
# trigger if the maintenance loop has not yet completed the transaction.
worker_crash_id="$(run_mode worker-crash QWEN_LANE_WORKER_CRASH_OK --yolo)"
kill_exact_lane_role "$worker_crash_id" worker >"$test_root/worker-crash-identity.json"
worker_archived=false
for _ in {1..400}; do
  if lane_status_is "$worker_crash_id" archived; then worker_archived=true; break; fi
  sleep 0.05
done
if [[ "$worker_archived" != true ]]; then
  "$lane" archive "$worker_crash_id" >"$test_root/worker-crash-archive.jsonl"
fi

# Native archive, idempotence, unarchive/resume, and exact transcript identity.
"$lane" archive "$default_id" >"$test_root/archive-1.jsonl"
"$lane" archive "$default_id" >"$test_root/archive-2.jsonl"
printf 'Return only QWEN_LANE_RESUME_OK and nothing else.\n' | \
  "$lane" resume "$default_id" --qwen-home "$QWEN_TEST_HOME" --persistent --no-auto-archive - \
    >"$test_root/resume.jsonl"
python3 - "$test_root/resume.jsonl" "$default_id" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
assert all(row.get("thread_id", sys.argv[2]) == sys.argv[2] for row in rows), rows
answers = [row.get("item", {}).get("text", "") for row in rows if row.get("item", {}).get("phase") == "final_answer"]
assert answers and answers[-1].strip() == "QWEN_LANE_RESUME_OK", answers
PY

for thread_id in "$default_id" "$non_yolo_id" "$yolo_id" "$plan_id" \
  "$interrupt_id" "$manager_crash_id" "$worker_crash_id"; do
  "$lane" archive "$thread_id" >"$test_root/final-archive-$thread_id.jsonl"
done
"$lane" list >"$test_root/final-list.jsonl"
python3 - "$test_root/final-list.jsonl" <<'PY'
import json, sys
rows = [json.loads(line) for line in open(sys.argv[1], encoding="utf-8") if line.strip()]
assert rows[-1].get("lanes") == [], rows[-1]
PY
if find "$XDG_RUNTIME_DIR" -type s \
  \( -name 'qw-*.sock' -o -name 'session-*.sock' \) -print -quit 2>/dev/null | grep -q .; then
  printf 'Qwen lane contract left a lane runtime socket behind\n' >&2
  exit 1
fi
success=true
printf 'Qwen lane contract: PASS\n'
