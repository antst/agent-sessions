#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
	link_target="$(readlink -- "$script_path")"
	if [[ "$link_target" == /* ]]; then
		script_path="$link_target"
	else
		script_path="$script_dir/$link_target"
	fi
done
repository_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"

fail() {
	printf 'unified migration acceptance: %s\n' "$*" >&2
	exit 1
}

test_root="$(mktemp -d /tmp/asm.XXXXXX)"
log_file="$test_root/acceptance.log"
cleanup() {
	if [[ "${AGENT_SESSIONS_KEEP_ACCEPTANCE_ROOT:-0}" == 1 ]]; then
		printf 'unified migration acceptance: retained diagnostic root %s\n' "$test_root" >&2
		return
	fi
	find "$test_root" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

(
	cd -- "$repository_root"
	AGENT_SESSIONS_UNIFIED_MIGRATION_ACCEPTANCE=1 \
		AGENT_SESSIONS_UNIFIED_MIGRATION_TEST_ROOT="$test_root/fixture" \
		go test ./internal/daemon -run '^TestUnifiedMigrationAcceptance$' -count=1 -v
) >"$log_file" 2>&1 || {
	cat -- "$log_file" >&2
	fail "fixture discriminator failed"
}

cat -- "$log_file"
if grep -Eq '^--- SKIP: TestUnifiedMigrationAcceptance|warning: no tests to run' "$log_file"; then
	fail "fixture discriminator was skipped"
fi
if [[ "$(grep -Ec '^=== RUN   TestUnifiedMigrationAcceptance$' "$log_file")" -ne 1 ]] ||
	[[ "$(grep -Ec '^--- PASS: TestUnifiedMigrationAcceptance \(' "$log_file")" -ne 1 ]]; then
	fail "fixture discriminator did not execute and pass exactly once"
fi
if [[ "$(grep -Ec 'unified\.migration\.fixture\.passed' "$log_file")" -ne 1 ]]; then
	fail "fixture discriminator omitted its closed assertion summary"
fi
for assertion in \
	'"operator_maintenance_window":true' \
	'"replacement_launch_refused":true' \
	'"live_handoff":false' \
	'"compatibility_drain":false' \
	'"installer_legacy_process_actions":0' \
	'"operator_authorities_stopped":4' \
	'"legacy_artifacts_retired":4' \
	'"migration_rollback_process_actions":0' \
	'"rollback_retry_required":true' \
	'"vendor_profiles_mutated":0' \
	'"unrelated_processes_signalled":0'; do
	if ! grep -Fq -- "$assertion" "$log_file"; then
		fail "fixture discriminator omitted assertion $assertion"
	fi
done

printf '%s\n' '{"type":"unified.migration.passed","contract_version":1,"fixture_only":true,"blocker_zero_mutation":true,"operator_maintenance_window":true,"replacement_launch_refused":true,"live_handoff":false,"compatibility_drain":false,"installer_legacy_process_actions":0,"operator_authorities_stopped":4,"adoption_commits":1,"legacy_artifacts_retired":4,"recovery":true,"migration_rollback_process_actions":0,"rollback_retry_required":true,"current_daemon_endpoints":1,"vendor_profiles_mutated":0,"unrelated_processes_signalled":0}'
