#!/usr/bin/env bash

# Native DSH profile operations shared by install and removal transactions.
# The caller owns strict shell options and provides remove_managed_tree.

dsh_profile_command() {
  local dsh_path=$1 pnpm_path=$2
  shift 2
  PATH="$(dirname -- "$pnpm_path"):$PATH" "$dsh_path" plugin --profile agent-sessions "$@"
}

validate_dsh_native_tuple() {
  local dsh_path=$1 pnpm_path=$2 dsh_version pnpm_version
  dsh_version=$("$dsh_path" --version)
  if ! grep -Eq '(^|[[:space:]])0\.1\.2-rc\.1($|[[:space:]])' <<<"$dsh_version"; then
    printf 'DSH version is incompatible; require exact 0.1.2-rc.1.\n' >&2
    return 1
  fi
  pnpm_version=$("$pnpm_path" --version)
  if [[ "$pnpm_version" != 10.28.1 ]]; then
    printf 'pnpm version is incompatible with DSH; require exact 10.28.1.\n' >&2
    return 1
  fi
}

dsh_profile_has_package() {
  local dsh_path=$1 pnpm_path=$2 package_name=$3 inventory
  inventory=$(dsh_profile_command "$dsh_path" "$pnpm_path" list --depth 0 --json)
  grep -Fq "\"$package_name\"" <<<"$inventory"
}

remove_dsh_integrations() {
  local dsh_path=$1 pnpm_path=$2 package_name
  for package_name in @agent-sessions/dsh-lane @agent-sessions/dsh-comms @agent-sessions/dsh-native; do
    if dsh_profile_has_package "$dsh_path" "$pnpm_path" "$package_name"; then
      dsh_profile_command "$dsh_path" "$pnpm_path" remove "$package_name"
    fi
  done
}

install_dsh_integrations() {
  local dsh_path=$1 pnpm_path=$2 npm_path=$3 integration_root=$4 temporary_parent temporary_root status
  temporary_parent=$(cd -P -- "${TMPDIR:-/tmp}" && pwd)
  temporary_root=$(mktemp -d "$temporary_parent/agent-sessions-dsh.XXXXXX")
  status=0
  (
    artifacts="$temporary_root/artifacts"
    NPM="$npm_path" PACKAGE_OUTPUT_DIR="$artifacts" "$integration_root/scripts/pack-packages" >/dev/null || exit $?
    set -- "$artifacts"/agent-sessions-dsh-comms-*.tgz
    [[ $# -eq 1 && -f "$1" ]] || exit 1
    comms_archive="$integration_root/integrations/dsh/$(basename -- "$1")"
    if [[ ! -f "$comms_archive" ]] || ! cmp -s -- "$1" "$comms_archive"; then
      install -m 0644 "$1" "$comms_archive" || exit $?
    fi
    set -- "$artifacts"/agent-sessions-dsh-lane-*.tgz
    [[ $# -eq 1 && -f "$1" ]] || exit 1
    lane_archive="$integration_root/integrations/dsh/$(basename -- "$1")"
    if [[ ! -f "$lane_archive" ]] || ! cmp -s -- "$1" "$lane_archive"; then
      install -m 0644 "$1" "$lane_archive" || exit $?
    fi

    # DSH owns profile/plugin mutation. Keep the exact npm-pack artifacts beside
    # the selected release because the product records the physical source.
    remove_dsh_integrations "$dsh_path" "$pnpm_path" || exit $?
    dsh_profile_command "$dsh_path" "$pnpm_path" add "$comms_archive" || exit $?
    dsh_profile_command "$dsh_path" "$pnpm_path" add "$lane_archive" || exit $?
  ) || status=$?
  remove_managed_tree "$temporary_root" "$temporary_parent"
  return "$status"
}
