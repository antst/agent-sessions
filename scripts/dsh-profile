#!/usr/bin/env bash

# Native DSH profile operations shared by install and removal transactions.
# The caller owns strict shell options and provides remove_managed_tree.

dsh_profile_command() {
  local dsh_path=$1 pnpm_path=$2
  shift 2
  PATH="$(dirname -- "$pnpm_path"):$PATH" "$dsh_path" plugin --profile agent-sessions "$@"
}

validate_dsh_native_tuple() {
  local dsh_path=$1 pnpm_path=$2 dsh_version pnpm_version
  dsh_version=$("$dsh_path" --version)
  if ! grep -Eq '(^|[[:space:]])0\.1\.2-rc\.1($|[[:space:]])' <<<"$dsh_version"; then
    printf 'DSH version is incompatible; require exact 0.1.2-rc.1.\n' >&2
    return 1
  fi
  pnpm_version=$("$pnpm_path" --version)
  if [[ "$pnpm_version" != 10.28.1 ]]; then
    printf 'pnpm version is incompatible with DSH; require exact 10.28.1.\n' >&2
    return 1
  fi
}

remove_dsh_integrations() {
  local dsh_path=$1 pnpm_path=$2 package_name inventory
  inventory=$(dsh_profile_command "$dsh_path" "$pnpm_path" list --depth 0 --json) || return $?
  for package_name in @agent-sessions/dsh-lane @agent-sessions/dsh-comms @agent-sessions/dsh-native; do
    if grep -Eq "\"$package_name\"[[:space:]]*:" <<<"$inventory"; then
      dsh_profile_command "$dsh_path" "$pnpm_path" remove "$package_name"
    fi
  done
}

stage_dsh_integration_archives() {
  local npm_path=$1 integration_root=$2 temporary_parent temporary_root status
  temporary_parent=$(cd -P -- "${TMPDIR:-/tmp}" && pwd)
  temporary_root=$(mktemp -d "$temporary_parent/agent-sessions-dsh.XXXXXX")
  status=0
  (
    artifacts="$temporary_root/artifacts"
    NPM="$npm_path" PACKAGE_OUTPUT_DIR="$artifacts" "$integration_root/scripts/pack-packages" \
      @agent-sessions/dsh-comms @agent-sessions/dsh-lane >/dev/null || exit $?

    shopt -s nullglob
    comms_archives=("$artifacts"/agent-sessions-dsh-comms-*.tgz)
    lane_archives=("$artifacts"/agent-sessions-dsh-lane-*.tgz)
    shopt -u nullglob
    if [[ ${#comms_archives[@]} -ne 1 || ${#lane_archives[@]} -ne 1 ]]; then
      printf 'DSH package staging did not produce exactly one archive per integration.\n' >&2
      exit 1
    fi
    install -m 0644 "${comms_archives[0]}" "$integration_root/integrations/dsh/" || exit $?
    install -m 0644 "${lane_archives[0]}" "$integration_root/integrations/dsh/" || exit $?
    shopt -s nullglob
    comms_archives=("$integration_root"/integrations/dsh/agent-sessions-dsh-comms-*.tgz)
    lane_archives=("$integration_root"/integrations/dsh/agent-sessions-dsh-lane-*.tgz)
    shopt -u nullglob
    [[ ${#comms_archives[@]} -eq 1 && ${#lane_archives[@]} -eq 1 ]] || exit 1
  ) || status=$?
  if ! remove_managed_tree "$temporary_root" "$temporary_parent"; then
    [[ $status -ne 0 ]] || status=1
  fi
  return "$status"
}

install_dsh_integrations() {
  local dsh_path=$1 pnpm_path=$2 integration_root=$3 inventory=$4 had_legacy=0 status
  local -a comms_archives lane_archives
  shopt -s nullglob
  comms_archives=("$integration_root"/integrations/dsh/agent-sessions-dsh-comms-*.tgz)
  lane_archives=("$integration_root"/integrations/dsh/agent-sessions-dsh-lane-*.tgz)
  shopt -u nullglob
  if [[ ${#comms_archives[@]} -ne 1 || ${#lane_archives[@]} -ne 1 ]]; then
    printf 'Selected release does not contain exactly one stable DSH archive per integration.\n' >&2
    return 1
  fi

  if grep -Eq '"@agent-sessions/dsh-native"[[:space:]]*:' <<<"$inventory"; then
    had_legacy=1
  fi

  # One offline native transaction lets pnpm satisfy the lane's exact comms
  # peer from the second local archive without consulting a registry.
  dsh_profile_command "$dsh_path" "$pnpm_path" add --offline "${comms_archives[0]}" "${lane_archives[0]}" || return $?
  if [[ $had_legacy -eq 0 ]]; then return 0; fi

  if dsh_profile_command "$dsh_path" "$pnpm_path" remove @agent-sessions/dsh-native; then
    return 0
  else
    status=$?
  fi
  if ! dsh_profile_command "$dsh_path" "$pnpm_path" remove \
    @agent-sessions/dsh-lane @agent-sessions/dsh-comms; then
    printf 'DSH legacy removal failed and cleanup of the newly added integration pair also failed.\n' >&2
  fi
  return "$status"
}
