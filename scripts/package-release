#!/usr/bin/env bash
set -euo pipefail

if (( $# != 4 )); then
	printf 'usage: %s PLATFORM VERSION BINARY_DIR OUTPUT_DIR\n' "${0##*/}" >&2
	exit 2
fi

platform="$1"
version="$2"
binary_dir="$3"
output_dir="$4"

for component in "$platform" "$version"; do
	if [[ ! "$component" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]]; then
		printf 'invalid release component: %s\n' "$component" >&2
		exit 2
	fi
done
for binary in agent-session-runtime codex-peer codex-peer-lane claude-peer-lane grok-peer grok-peer-lane peer-federator; do
	if [[ ! -x "$binary_dir/$binary" ]]; then
		printf 'release binary is missing or not executable: %s\n' "$binary_dir/$binary" >&2
		exit 1
	fi
done

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
	link_target="$(readlink -- "$script_path")"
	if [[ "$link_target" == /* ]]; then
		script_path="$link_target"
	else
		script_path="$script_dir/$link_target"
	fi
done
plugin_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"

mkdir -p "$output_dir"
output_dir="$(cd -- "$output_dir" && pwd -P)"
package_name="agent-sessions-${version}-${platform}"
temporary_parent="$(cd -P -- "${TMPDIR:-/tmp}" && pwd)"
stage="$(mktemp -d "$temporary_parent/agent-sessions-release.XXXXXX")"
cleanup() {
	rm -rf -- "$stage"
}
trap cleanup EXIT

package_root="$stage/$package_name"
mkdir -p "$package_root/bin/$platform"
cp -R \
	"$plugin_root/.agents" \
	"$plugin_root/.claude-plugin" \
	"$plugin_root/.codex-plugin" \
	"$plugin_root/claude" \
	"$plugin_root/deploy" \
	"$plugin_root/docs" \
	"$plugin_root/grok" \
	"$plugin_root/hooks" \
	"$plugin_root/scripts" \
	"$plugin_root/skills" \
	"$package_root/"
cp \
	"$plugin_root/.mcp.json" \
	"$plugin_root/Makefile" \
	"$plugin_root/README.md" \
	"$package_root/"
for binary in agent-session-runtime codex-peer codex-peer-lane claude-peer-lane grok-peer grok-peer-lane peer-federator; do
	cp "$binary_dir/$binary" "$package_root/bin/$platform/$binary"
	chmod 0755 "$package_root/bin/$platform/$binary"
done
: >"$package_root/.agent-sessions-prebuilt"

archive="$output_dir/$package_name.tar.gz"
tar -C "$stage" -czf "$archive" "$package_name"
printf '%s\n' "$archive"
