#!/usr/bin/env bash
set -euo pipefail

if (( $# != 4 )); then
	printf 'usage: %s PLATFORM VERSION BINARY_DIR OUTPUT_DIR\n' "${0##*/}" >&2
	exit 2
fi

platform="$1"
version="$2"
binary_dir="$3"
output_dir="$4"

for component in "$platform" "$version"; do
	if [[ ! "$component" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]]; then
		printf 'invalid release component: %s\n' "$component" >&2
		exit 2
	fi
done
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
	link_target="$(readlink -- "$script_path")"
	if [[ "$link_target" == /* ]]; then
		script_path="$link_target"
	else
		script_path="$script_dir/$link_target"
	fi
done
plugin_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"
declared_version="$(<"$plugin_root/deploy/agent-sessions/VERSION")"
if [[ "$version" != "$declared_version" ]]; then
	printf 'release version %s does not match deploy/agent-sessions/VERSION (%s)\n' \
		"$version" "$declared_version" >&2
	exit 1
fi
known_platform=false
while IFS='|' read -r _ _ release_platform; do
	if [[ "$release_platform" == "$platform" ]]; then
		known_platform=true
		break
	fi
done < <("$plugin_root/scripts/release-inventory" platforms)
if [[ "$known_platform" != true ]]; then
	printf 'release platform is not in the authoritative four-platform inventory: %s\n' "$platform" >&2
	exit 1
fi
binaries=()
while IFS= read -r binary; do binaries+=("$binary"); done < <("$plugin_root/scripts/release-inventory" binaries)
# This builds one transport archive containing the two independently deployed
# role images. It stages bytes only: host and hub lifecycle remain explicit,
# separate operations and are never invoked by the packager.
package_paths=()
while IFS= read -r path; do package_paths+=("$path"); done < <("$plugin_root/scripts/release-inventory" package-paths)
for binary in "${binaries[@]}"; do
	if [[ ! -x "$binary_dir/$binary" ]]; then
		printf 'release binary is missing or not executable: %s\n' "$binary_dir/$binary" >&2
		exit 1
	fi
done
packager="${AGENT_SESSIONS_RELEASE_PACKAGER:-$binary_dir/agent-sessions}"
if [[ "$packager" != /* ]]; then
	printf 'release packager must be an absolute path: %s\n' "$packager" >&2
	exit 2
fi
if [[ ! -x "$packager" ]]; then
	printf 'host release packager is missing or not executable: %s\n' "$packager" >&2
	exit 1
fi

mkdir -p "$output_dir"
output_dir="$(cd -- "$output_dir" && pwd -P)"
package_name="agent-sessions-${version}-${platform}"
temporary_parent="$(cd -P -- "${TMPDIR:-/tmp}" && pwd)"
stage="$(mktemp -d "$temporary_parent/agent-sessions-release.XXXXXX")"
checksum_temporary=
cleanup() {
	rm -rf -- "$stage"
	if [[ -n "$checksum_temporary" ]]; then
		rm -f -- "$checksum_temporary"
	fi
}
trap cleanup EXIT

sha256_file() {
	local path=$1
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum -- "$path" | awk '{print $1}'
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 -- "$path" | awk '{print $1}'
	else
		printf 'packaging requires sha256sum or shasum\n' >&2
		return 127
	fi
}

package_root="$stage/$package_name"
mkdir -p "$package_root/bin/$platform"
for path in "${package_paths[@]}"; do
	cp -R "$plugin_root/$path" "$package_root/"
done
for binary in "${binaries[@]}"; do
	cp "$binary_dir/$binary" "$package_root/bin/$platform/$binary"
	chmod 0755 "$package_root/bin/$platform/$binary"
done
: >"$package_root/.agent-sessions-prebuilt"
bash "$plugin_root/scripts/stage-release-metadata" "$package_root" "$platform" "$version"

archive="$output_dir/$package_name.tar.gz"
"$packager" release-package "$stage" "$package_name" "$archive"
archive_digest="$(sha256_file "$archive")"
checksum="$archive.sha256"
checksum_temporary="$(mktemp "$output_dir/.agent-sessions-archive-checksum.XXXXXX")"
printf '%s  %s\n' "$archive_digest" "$(basename -- "$archive")" >"$checksum_temporary"
mv -- "$checksum_temporary" "$checksum"
checksum_temporary=
printf '%s\n' "$archive"
