#!/usr/bin/env bash
set -Eeuo pipefail

script_directory=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$script_directory/managed-tree"
source "$script_directory/launchd-control"

if [[ $# -ne 5 ]]; then
  printf 'usage: %s SOURCE_ROOT HOST_BINARY PREFIX VERSION PLATFORM\n' "${0##*/}" >&2
  exit 2
fi

source_root=$1
host_binary=$2
prefix=$3
version=$4
platform=$5
codex=${CODEX:-codex}
claude=${CLAUDE:-claude}
grok=${GROK:-grok}
qwen=${QWEN:-qwen}
opencode=${OPENCODE:-opencode}

binary_release_identity() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
    return
  fi
  shasum -a 256 "$1" | awk '{print $1}'
}

resolve_directory_link() {
  local link=$1 target
  target=$(readlink -- "$link") || return 1
  if [[ "$target" != /* ]]; then
    target="$(dirname -- "$link")/$target"
  fi
  [[ -d "$target" ]] || return 1
  (cd -P -- "$target" && pwd)
}

resolve_product() {
  local configured=$1
  local user_fallback=$2
  if [[ "$configured" == */* ]]; then
    [[ -x "$configured" && ! -d "$configured" ]] || return 1
    printf '%s\n' "$configured"
    return 0
  fi
  if command -v "$configured" >/dev/null 2>&1; then
    command -v "$configured"
    return 0
  fi
  if [[ -x "$user_fallback" && ! -d "$user_fallback" ]]; then
    printf '%s\n' "$user_fallback"
    return 0
  fi
  return 1
}

codex_path=$(resolve_product "$codex" "$HOME/.local/bin/codex" || true)
claude_path=$(resolve_product "$claude" "$HOME/.local/bin/claude" || true)
qwen_path=$(resolve_product "$qwen" "$HOME/.local/bin/qwen" || true)
opencode_path=$(resolve_product "$opencode" "$HOME/.local/bin/opencode" || true)

# Grok Build may be installed only in its native self-managed downloads
# directory, without a PATH or ~/.grok/bin shim. Route every discovery and
# plugin operation through the just-built Agent Sessions launcher so install
# and interactive launches share one contract-probed candidate selection.
grok_override=$(resolve_product "$grok" "$HOME/.grok/bin/grok" || true)
run_grok() {
  if [[ -n "$grok_override" ]]; then
    GROK_PEER_GROK_BIN="$grok_override" "$host_binary" peer grok "$@"
  else
    "$host_binary" peer grok "$@"
  fi
}
grok_available=0
if run_grok --version >/dev/null 2>&1; then
  grok_available=1
else
  grok_status=$?
  if [[ -n "$grok_override" ]]; then
    printf 'Cannot validate the installed Grok CLI (exit %s).\n' "$grok_status" >&2
    exit "$grok_status"
  fi
fi

[[ "$source_root" == /* && -d "$source_root" && ! -L "$source_root" ]] || {
  printf 'source root must be an absolute real directory: %s\n' "$source_root" >&2
  exit 2
}
[[ "$host_binary" == /* && -x "$host_binary" && ! -L "$host_binary" ]] || {
  printf 'host binary must be an absolute real executable: %s\n' "$host_binary" >&2
  exit 2
}
[[ "$prefix" == /* && "$prefix" != *'|'* && "$prefix" != *$'\n'* ]] || {
  printf 'prefix must be an absolute path without reserved characters: %s\n' "$prefix" >&2
  exit 2
}
[[ "$version" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] || {
  printf 'invalid release version: %s\n' "$version" >&2
  exit 2
}

payload=(
  .agents .claude-plugin .codex-plugin
  claude grok hooks integrations qwen skills README.md
)
for path in "${payload[@]}" .codex-plugin/mcp.json scripts/native-entry deploy/agent-sessions; do
  [[ -e "$source_root/$path" && ! -L "$source_root/$path" ]] || {
    printf 'host payload is missing or indirect: %s\n' "$path" >&2
    exit 1
  }
done

# Validate every available native integration before replacing any installed
# plugin. Missing products are optional and do not affect the host service.
if [[ -n "$claude_path" ]]; then
  "$claude_path" plugin validate "$source_root" --strict >/dev/null
  "$claude_path" plugin validate "$source_root/claude" --strict >/dev/null
fi
if [[ $grok_available -eq 1 ]]; then
  run_grok plugin validate "$source_root/grok" >/dev/null
fi

install_root="$prefix/libexec/agent-sessions"
host_root="$install_root/host"
releases="$host_root/releases"
release="$releases/$version"
mkdir -p "$releases" "$prefix/bin"
stage="$(mktemp -d "$releases/.stage.XXXXXX")"
backup=""
cleanup_stage() {
  if [[ -n "$stage" && -d "$stage" ]]; then
    remove_managed_tree "$stage" "$releases"
  fi
}
trap cleanup_stage EXIT

for path in "${payload[@]}"; do
  mkdir -p "$stage/$(dirname -- "$path")"
  cp -R -- "$source_root/$path" "$stage/$(dirname -- "$path")/"
done
cp -- "$stage/.codex-plugin/mcp.json" "$stage/.mcp.json"
rm -- "$stage/.codex-plugin/mcp.json"
mkdir -p "$stage/scripts" "$stage/deploy"
cp -- "$source_root/scripts/native-entry" "$stage/scripts/native-entry"
cp -R -- "$source_root/deploy/agent-sessions" "$stage/deploy/"
mkdir -p "$stage/bin"
install -m 0755 "$host_binary" "$stage/bin/agent-sessions"
chmod 0755 "$stage/scripts/native-entry" "$stage/grok/scripts/native-entry" "$stage/qwen/scripts/native-entry"
printf '%s\n' "$platform" >"$stage/PLATFORM"

# Native products may keep stdio MCP children alive across plugin and daemon
# upgrades. Bind each installed MCP command to the public host image identity;
# Codex's supported config/mcpServer/reload (and the other products' native
# plugin refreshes) can then distinguish and replace only stale connectors
# without restarting vendor sessions or the Codex App Server.
release_identity=$(binary_release_identity "$stage/bin/agent-sessions")
[[ "$release_identity" =~ ^[[:xdigit:]]{64}$ ]] || {
  printf 'cannot derive installed host binary identity\n' >&2
  exit 1
}
for manifest in "$stage/.mcp.json" "$stage/claude/.mcp.json" "$stage/grok/.mcp.json" "$stage/qwen/mcp.json"; do
  grep -Fq '@AGENT_SESSIONS_RELEASE_ID@' "$manifest" || {
    printf 'MCP manifest is missing the release identity placeholder: %s\n' "$manifest" >&2
    exit 1
  }
  sed "s|@AGENT_SESSIONS_RELEASE_ID@|$release_identity|g" "$manifest" >"$manifest.next"
  mv -- "$manifest.next" "$manifest"
done

claude_plugin_install_path() {
  local inventory=$1
  printf '%s\n' "$inventory" | awk \
    -v id='agent-sessions@agent-sessions' -v scope='user' '
      BEGIN { RS = "}" }
      index($0, "\"id\"") && index($0, "\"" id "\"") &&
      index($0, "\"scope\"") && index($0, "\"" scope "\"") &&
      index($0, "\"installPath\"") {
        path = $0
        sub(/^.*\"installPath\"[[:space:]]*:[[:space:]]*\"/, "", path)
        sub(/\".*$/, "", path)
        print path
        exit
      }
    '
}

claude_plugin_cache_matches() {
  local inventory=$1 expected=$2 installed
  installed=$(claude_plugin_install_path "$inventory")
  [[ -n "$installed" && "$installed" == /* && -d "$installed" && ! -L "$installed" ]] || return 1
  diff -qr -- "$expected" "$installed" >/dev/null 2>&1
}

install_exact_claude_plugin() {
  local integration_root=$1 claude_plugins
  "$claude_path" plugin marketplace add --scope user "$integration_root"
  claude_plugins=$("$claude_path" plugin list --json)
  if grep -Eq '"id"[[:space:]]*:[[:space:]]*"agent-sessions@agent-sessions"' <<<"$claude_plugins"; then
    "$claude_path" plugin update --scope user --yes agent-sessions@agent-sessions
    claude_plugins=$("$claude_path" plugin list --json)
    if ! claude_plugin_cache_matches "$claude_plugins" "$integration_root/claude"; then
      # Claude treats equal semantic versions as already current even when a
      # development/recovery installation carries different bytes. Use only
      # its supported plugin lifecycle, retaining persistent plugin data, and
      # let the outer host transaction restore the prior release on failure.
      "$claude_path" plugin uninstall --scope user --keep-data agent-sessions@agent-sessions
      "$claude_path" plugin install --scope user --yes agent-sessions@agent-sessions
    fi
  else
    "$claude_path" plugin install --scope user --yes agent-sessions@agent-sessions
  fi
  claude_plugins=$("$claude_path" plugin list --json)
  if ! claude_plugin_cache_matches "$claude_plugins" "$integration_root/claude"; then
    local installed
    installed=$(claude_plugin_install_path "$claude_plugins")
    printf 'Claude active plugin cache does not match the selected host release: %s\n' \
      "${installed:-not reported by Claude}" >&2
    if [[ -n "$installed" && -d "$installed" ]]; then
      diff -qr -- "$integration_root/claude" "$installed" >&2 || true
    fi
    return 1
  fi
}

install_managed_plugin_link() {
  local link=$1 target=$2 suffix=$3 prior
  mkdir -p "$(dirname -- "$link")"
  if [[ -e "$link" || -L "$link" ]]; then
    [[ -L "$link" ]] || {
      printf 'refuse to replace a non-managed product plugin: %s\n' "$link" >&2
      return 1
    }
    prior=$(readlink -- "$link")
    case "$prior" in
      "$host_root"/releases/*/"$suffix") ;;
      *)
        printf 'refuse to replace a plugin link outside Agent Sessions releases: %s\n' "$link" >&2
        return 1
        ;;
    esac
  fi
  ln -sfn "$target" "$link"
}

install_opencode_plugin() {
  local integration_root=$1 config_root
  [[ -n "$opencode_path" ]] || return 0
  config_root="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  install_managed_plugin_link \
    "$config_root/plugins/agent-sessions.mjs" \
    "$integration_root/integrations/opencode/agent-sessions.mjs" \
    "integrations/opencode/agent-sessions.mjs"
  install_managed_plugin_link \
    "$config_root/shared/live-session.js" \
    "$integration_root/integrations/shared/live-session.js" \
    "integrations/shared/live-session.js"
}

install_integrations() {
  local integration_root=$1
  if [[ -n "$codex_path" ]]; then
    local codex_plugins codex_marketplaces
    codex_plugins=$("$codex_path" plugin list --json)
    if grep -Eq '"pluginId"[[:space:]]*:[[:space:]]*"agent-sessions@agent-sessions"' <<<"$codex_plugins"; then
      "$codex_path" plugin remove agent-sessions@agent-sessions
    fi
    codex_marketplaces=$("$codex_path" plugin marketplace list --json)
    if grep -Eq '"name"[[:space:]]*:[[:space:]]*"agent-sessions"' <<<"$codex_marketplaces"; then
      if ! grep -Fq '"root": "'"$integration_root"'"' <<<"$codex_marketplaces"; then
        "$codex_path" plugin marketplace remove agent-sessions
        "$codex_path" plugin marketplace add "$integration_root"
      fi
    else
      "$codex_path" plugin marketplace add "$integration_root"
    fi
    "$codex_path" plugin add agent-sessions@agent-sessions
  else
    printf 'Skipping Codex integration: %s is not installed.\n' "$codex"
  fi

  if [[ -n "$claude_path" ]]; then
    install_exact_claude_plugin "$integration_root"
  else
    printf 'Skipping Claude integration: %s is not installed.\n' "$claude"
  fi

  if [[ $grok_available -eq 1 ]]; then
    local grok_plugins
    grok_plugins=$(run_grok plugin list --json)
    if grep -Eq '"name"[[:space:]]*:[[:space:]]*"agent-sessions"' <<<"$grok_plugins"; then
      run_grok plugin uninstall agent-sessions --keep-data
    fi
    run_grok plugin install "$integration_root/grok" --trust
  else
    printf 'Skipping Grok integration: %s is not installed.\n' "$grok"
  fi

  if [[ -n "$qwen_path" ]]; then
    local qwen_extensions
    qwen_extensions=$("$qwen_path" extensions list)
    if grep -Eq '^[^[:alnum:]]*agent-sessions[[:space:]]' <<<"$qwen_extensions"; then
      "$qwen_path" extensions uninstall agent-sessions
    fi
    "$qwen_path" extensions install "$integration_root/qwen" --consent --scope user
  else
    printf 'Skipping Qwen integration: %s is not installed.\n' "$qwen"
  fi

  install_opencode_plugin "$integration_root"
}

remove_integrations() {
  if [[ -n "$codex_path" ]]; then
    "$codex_path" plugin remove agent-sessions@agent-sessions >/dev/null 2>&1 || true
    "$codex_path" plugin marketplace remove agent-sessions >/dev/null 2>&1 || true
  fi
  if [[ -n "$claude_path" ]]; then
    "$claude_path" plugin uninstall --scope user agent-sessions@agent-sessions >/dev/null 2>&1 || true
    "$claude_path" plugin marketplace remove --scope user agent-sessions >/dev/null 2>&1 || true
  fi
  if [[ $grok_available -eq 1 ]]; then
    run_grok plugin uninstall agent-sessions --keep-data >/dev/null 2>&1 || true
  fi
  if [[ -n "$qwen_path" ]]; then
    "$qwen_path" extensions uninstall agent-sessions >/dev/null 2>&1 || true
  fi
  if [[ -n "$opencode_path" ]]; then
    local config_root link target
    config_root="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
    for link in "$config_root/plugins/agent-sessions.mjs" "$config_root/shared/live-session.js"; do
      if [[ -L "$link" ]]; then
        target=$(readlink -- "$link")
        case "$target" in
          "$host_root"/releases/*/integrations/*) rm -f -- "$link" ;;
        esac
      fi
    done
  fi
}

write_service_definition() {
  local selected_release=$1
  case "$(uname -s)" in
    Linux)
      local unit_root config_root
      unit_root="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
      config_root="${XDG_CONFIG_HOME:-$HOME/.config}/agent-sessions"
      mkdir -p "$unit_root" "$config_root"
      if [[ ! -e "$config_root/service.env.example" ]]; then
        install -m 0600 "$selected_release/deploy/agent-sessions/service.env.example" "$config_root/service.env.example"
      fi
      sed "s|@PREFIX@|$prefix|g" \
        "$selected_release/deploy/agent-sessions/systemd/user/agent-sessions.service" \
        >"$unit_root/agent-sessions.service"
      systemctl --user daemon-reload
      ;;
    Darwin)
      local state_root config_root unit_root service_path
      state_root="$HOME/.local/state/agent-sessions"
      config_root="${XDG_CONFIG_HOME:-$HOME/.config}/agent-sessions"
      unit_root="$HOME/Library/LaunchAgents"
      service_path="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
      mkdir -p "$unit_root" "$state_root/logs" "$config_root"
      if [[ ! -e "$config_root/service.env.example" ]]; then
        install -m 0600 "$selected_release/deploy/agent-sessions/service.env.example" "$config_root/service.env.example"
      fi
      launchd_render_host_plist \
        "$selected_release/deploy/agent-sessions/launchd/net.antst.agent-sessions.plist" \
        "$unit_root/net.antst.agent-sessions.plist" "$prefix" "$state_root" "$HOME" \
        "$service_path" "$codex_path" "$claude_path" "$grok_override" "$qwen_path"
      plutil -lint "$unit_root/net.antst.agent-sessions.plist" >/dev/null
      ;;
    *)
      printf 'unsupported host service platform: %s\n' "$(uname -s)" >&2
      return 1
      ;;
  esac
}

install_service() {
  local selected_release=$1
  write_service_definition "$selected_release"
  case "$(uname -s)" in
    Linux)
      systemctl --user enable agent-sessions.service
      systemctl --user restart agent-sessions.service
      ;;
    Darwin)
      local domain="gui/$(id -u)" target
      target="$domain/net.antst.agent-sessions"
      launchd_bootout_exact "$target"
      launchd_bootstrap_exact "$domain" "$target" "$HOME/Library/LaunchAgents/net.antst.agent-sessions.plist"
      launchctl enable "$target"
      launchctl kickstart -k "$target"
      ;;
  esac
}

wait_for_host_service() {
  # A surviving Codex App Server may need both its plugin inventory refresh
  # and its MCP-server reload before the replacement daemon can recorroborate
  # live attachments. Each supported App Server operation has a 30-second
  # bound, so the installer must not kill the daemon at the old five-second
  # readiness deadline while that transaction is still in flight.
  local deadline=650
  while ! "$prefix/bin/agent-sessions" status >/dev/null 2>&1; do
    deadline=$((deadline - 1))
    if [[ $deadline -eq 0 ]]; then
      printf 'installed Agent Sessions service did not become ready\n' >&2
      return 1
    fi
    sleep 0.1
  done
}

remove_service() {
  case "$(uname -s)" in
    Linux)
      systemctl --user disable --now agent-sessions.service >/dev/null 2>&1 || true
      rm -f -- "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/agent-sessions.service"
      systemctl --user daemon-reload >/dev/null 2>&1 || true
      ;;
    Darwin)
      local domain="gui/$(id -u)" target
      target="$domain/net.antst.agent-sessions"
      launchd_bootout_exact "$target" || true
      launchctl disable "$target" >/dev/null 2>&1 || true
      rm -f -- "$HOME/Library/LaunchAgents/net.antst.agent-sessions.plist"
      ;;
  esac
}

prior_service_definition=0
prior_service_enabled=0
prior_service_active=0
case "$(uname -s)" in
  Linux)
    [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/agent-sessions.service" ]] && prior_service_definition=1
    systemctl --user is-enabled --quiet agent-sessions.service >/dev/null 2>&1 && prior_service_enabled=1 || true
    systemctl --user is-active --quiet agent-sessions.service >/dev/null 2>&1 && prior_service_active=1 || true
    ;;
  Darwin)
    [[ -f "$HOME/Library/LaunchAgents/net.antst.agent-sessions.plist" ]] && prior_service_definition=1
    launchctl print "gui/$(id -u)/net.antst.agent-sessions" >/dev/null 2>&1 && prior_service_active=1 || true
    if ! launchctl print-disabled "gui/$(id -u)" 2>/dev/null |
      grep -Eq '"net\.antst\.agent-sessions"[[:space:]]*=>[[:space:]]*true'; then
      prior_service_enabled=1
    fi
    ;;
esac

restore_prior_service() {
  local selected_release=$1
  if [[ $prior_service_definition -eq 0 ]]; then
    remove_service
    return
  fi
  write_service_definition "$selected_release"
  case "$(uname -s)" in
    Linux)
      if [[ $prior_service_enabled -eq 1 ]]; then
        systemctl --user enable agent-sessions.service
      else
        systemctl --user disable agent-sessions.service
      fi
      if [[ $prior_service_active -eq 1 ]]; then
        systemctl --user restart agent-sessions.service
      else
        systemctl --user stop agent-sessions.service
      fi
      ;;
    Darwin)
      local domain="gui/$(id -u)" target
      target="$domain/net.antst.agent-sessions"
      if [[ $prior_service_enabled -eq 1 ]]; then
        launchctl enable "$target"
      else
        launchctl disable "$target"
      fi
      if [[ $prior_service_active -eq 1 ]]; then
        launchd_bootstrap_exact "$domain" "$target" "$HOME/Library/LaunchAgents/net.antst.agent-sessions.plist"
        launchctl kickstart -k "$target"
      fi
      ;;
  esac
}

prior_current=""
if [[ -L "$host_root/current" ]]; then
  prior_current=$(resolve_directory_link "$host_root/current" || true)
  if [[ -z "$prior_current" || ! -d "$prior_current" || -L "$prior_current" || "$prior_current" != "$releases"/* ]]; then
    printf 'selected prior release is outside the managed release root: %s\n' "$prior_current" >&2
    exit 1
  fi
elif [[ -e "$host_root/current" ]]; then
  printf 'selected host release is not a symbolic link: %s\n' "$host_root/current" >&2
  exit 1
fi

rollback_install() {
  local status=$1
  trap - ERR EXIT
  set +e
  remove_service
  if [[ -n "$stage" && -d "$stage" ]]; then
    remove_managed_tree "$stage" "$releases"
  fi
  if [[ -e "$release" || -L "$release" ]]; then
    remove_managed_tree "$release" "$releases"
  fi
  if [[ -n "$backup" && -d "$backup" ]]; then mv -- "$backup" "$release"; fi
  if [[ -n "$prior_current" && -d "$prior_current" ]]; then
    ln -sfn "$prior_current" "$host_root/current"
    for alias in agent-sessions $("$source_root/scripts/release-inventory" host-aliases); do
      ln -sfn "$host_root/current/bin/agent-sessions" "$prefix/bin/$alias"
    done
    install_integrations "$prior_current"
    restore_prior_service "$prior_current"
    if [[ $prior_service_active -eq 1 ]]; then wait_for_host_service; fi
  else
    remove_integrations
    rm -f -- "$host_root/current"
    for alias in agent-sessions $("$source_root/scripts/release-inventory" host-aliases); do
      if [[ -L "$prefix/bin/$alias" ]]; then rm -f -- "$prefix/bin/$alias"; fi
    done
  fi
  printf 'Agent Sessions installation failed; restored the prior host release and integrations.\n' >&2
  exit "$status"
}
trap 'rollback_install $?' ERR

if [[ -e "$release" || -L "$release" ]]; then
  [[ -d "$release" && ! -L "$release" ]] || {
    printf 'installed release path is not a real directory: %s\n' "$release" >&2
    exit 1
  }
  backup="$releases/.previous-$version-$$"
  mv -- "$release" "$backup"
fi
mv -- "$stage" "$release"
stage=""
ln -sfn "$release" "$host_root/current"

for alias in agent-sessions $("$source_root/scripts/release-inventory" host-aliases); do
  ln -sfn "$host_root/current/bin/agent-sessions" "$prefix/bin/$alias"
done
install_integrations "$release"
install_service "$release"
wait_for_host_service

if [[ -n "$backup" && -d "$backup" ]]; then
  remove_managed_tree "$backup" "$releases"
fi
trap - ERR
printf 'Installed Agent Sessions %s for %s and restarted the user service.\n' "$version" "$platform"
