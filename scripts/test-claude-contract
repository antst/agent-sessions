#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
  link_target="$(readlink -- "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
plugin_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"

preflight="$plugin_root/claude/skills/codex-lane/scripts/lane-preflight"
grok_preflight="$plugin_root/claude/skills/grok-lane/scripts/lane-preflight"
sh -n "$preflight"
sh -n "$grok_preflight"
if [[ ! -x "$grok_preflight" ]]; then
  printf 'Claude Grok lane preflight is not executable\n' >&2
  exit 1
fi

codex_version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$plugin_root/.codex-plugin/plugin.json" | head -1)"
claude_version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$plugin_root/claude/.claude-plugin/plugin.json" | head -1)"
if [[ -z "$codex_version" || "$claude_version" != "$codex_version" ]]; then
  printf 'Codex and Claude plugin versions differ: %s != %s\n' "$codex_version" "$claude_version" >&2
  exit 1
fi
for manifest in \
  "$plugin_root/.codex-plugin/plugin.json" \
  "$plugin_root/claude/.claude-plugin/plugin.json" \
  "$plugin_root/grok/.grok-plugin/plugin.json"; do
  if [[ "$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -1)" != agent-sessions ]]; then
    printf 'Plugin manifest does not use the uniform agent-sessions identity: %s\n' "$manifest" >&2
    exit 1
  fi
done
marketplace_plugin_name="$(awk '
  /"plugins"[[:space:]]*:/ { plugins = 1; next }
  plugins && /"name"[[:space:]]*:/ {
    line = $0
    sub(/^[^:]*:[[:space:]]*"/, "", line)
    sub(/".*/, "", line)
    print line
    exit
  }
' "$plugin_root/.claude-plugin/marketplace.json")"
if [[ "$marketplace_plugin_name" != agent-sessions ]]; then
  printf 'Claude marketplace plugin entry does not use the agent-sessions identity\n' >&2
  exit 1
fi
codex_marketplace_plugin_name="$(awk '
  /"plugins"[[:space:]]*:/ { plugins = 1; next }
  plugins && /"name"[[:space:]]*:/ {
    line = $0
    sub(/^[^:]*:[[:space:]]*"/, "", line)
    sub(/".*/, "", line)
    print line
    exit
  }
' "$plugin_root/.agents/plugins/marketplace.json")"
if [[ "$codex_marketplace_plugin_name" != agent-sessions ]]; then
  printf 'Codex marketplace plugin entry does not use the agent-sessions identity\n' >&2
  exit 1
fi
if grep -Eq '"version"[[:space:]]*:' "$plugin_root/.claude-plugin/marketplace.json"; then
  printf 'Claude marketplace must not shadow the plugin manifest version\n' >&2
  exit 1
fi

skill="$plugin_root/claude/skills/codex-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$skill" | head -1)" != codex-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$skill" | head -1)" ]]; then
  printf 'Claude skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
grok_skill="$plugin_root/claude/skills/grok-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$grok_skill" | head -1)" != grok-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$grok_skill" | head -1)" ]]; then
  printf 'Claude Grok skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
grok_messaging_skill="$plugin_root/grok/skills/agent-sessions/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$grok_messaging_skill" | head -1)" != agent-sessions ]] ||
   ! grep -Fq 'agent_sessions.list_peers' "$grok_messaging_skill" ||
   ! grep -Fq 'agent_sessions.send_message' "$grok_messaging_skill" ||
   ! grep -Fq 'agent_sessions.broadcast' "$grok_messaging_skill"; then
  printf 'Grok grouped messaging skill is incomplete\n' >&2
  exit 1
fi
self_skill="$plugin_root/claude/skills/claude-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$self_skill" | head -1)" != claude-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$self_skill" | head -1)" ]]; then
  printf 'Claude self-lane skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
messaging_skill="$plugin_root/claude/skills/agent-sessions/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$messaging_skill" | head -1)" != agent-sessions ]] ||
   ! grep -Fq '"type":"broadcast"' "$messaging_skill"; then
  printf 'Claude grouped messaging skill is incomplete\n' >&2
  exit 1
fi
claude_markdown=()
while IFS= read -r file; do
  claude_markdown[${#claude_markdown[@]}]="$file"
done < <(find "$plugin_root/claude" -type f -name '*.md' -print)
if ((${#claude_markdown[@]})) && grep -Hin 'allowed-tools' "${claude_markdown[@]}"; then
  printf 'Claude plugin unexpectedly grants tools\n' >&2
  exit 1
fi
for reference in events failures install policy; do
  file="$plugin_root/claude/skills/codex-lane/references/$reference.md"
  if [[ ! -f "$file" ]] || ! grep -Fq "references/$reference.md" "$skill"; then
    printf 'Claude skill reference %s is missing or unlinked\n' "$reference" >&2
    exit 1
  fi
done
for reference in contract install; do
  file="$plugin_root/claude/skills/grok-lane/references/$reference.md"
  if [[ ! -f "$file" ]] || ! grep -Fq "references/$reference.md" "$grok_skill"; then
    printf 'Claude Grok skill reference %s is missing or unlinked\n' "$reference" >&2
    exit 1
  fi
done

for forbidden in hooks agents settings.json; do
  if [[ -e "$plugin_root/claude/$forbidden" ]]; then
    printf 'Claude plugin isolation violated by %s\n' "$forbidden" >&2
    exit 1
  fi
done
if [[ ! -f "$plugin_root/claude/.mcp.json" ]] ||
   ! grep -Fq '"claude_peer"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"agent-session-runtime"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"mcp"' "$plugin_root/claude/.mcp.json"; then
  printf 'Claude structured messaging MCP inventory is incomplete\n' >&2
  exit 1
fi
if find "$plugin_root/claude" -type l -print -quit | grep -q .; then
  printf 'Claude plugin must be self-contained and may not rely on symlinks\n' >&2
  exit 1
fi
publishable_text=()
while IFS= read -r file; do
  publishable_text[${#publishable_text[@]}]="$file"
done < <(find \
  "$plugin_root/.claude-plugin" "$plugin_root/claude" "$plugin_root/docs" \
  -type f \( -name '*.md' -o -name '*.json' -o -name 'lane-preflight' \) -print)
publishable_text+=("$plugin_root/README.md")
if ((${#publishable_text[@]})) && grep -Hini -E 'builder|umka|kernel-tdd|/home/antst' "${publishable_text[@]}"; then
  printf 'Publishable documentation contains a project-specific reference\n' >&2
  exit 1
fi
cached_plugin_text=()
while IFS= read -r file; do
  cached_plugin_text[${#cached_plugin_text[@]}]="$file"
done < <(find "$plugin_root/claude" -type f \
  \( -name '*.md' -o -name '*.json' -o -name 'lane-preflight' \) -print)
if ((${#cached_plugin_text[@]})) && grep -Hini -E '\.\./docs/|docs/CLAUDE-' "${cached_plugin_text[@]}"; then
  printf 'Cached Claude plugin contains a reference outside its plugin root\n' >&2
  exit 1
fi
if grep -Fq "s/\\r/" "$preflight"; then
  printf 'Claude lane preflight uses GNU-only sed carriage-return matching\n' >&2
  exit 1
fi
if grep -Fq "s/\\r/" "$grok_preflight"; then
  printf 'Grok lane preflight uses GNU-only sed carriage-return matching\n' >&2
  exit 1
fi

contract_gocache="${GOCACHE:-${TMPDIR:-/tmp}/agent-sessions-go-cache}"
mkdir -p "$contract_gocache"
lane_help="$(cd -- "$plugin_root" && GOCACHE="$contract_gocache" go run ./cmd/agent-session-runtime lane --help)"
for command in run start resume wait status interrupt archive list doctor; do
  if ! grep -Fq "codex-peer-lane $command" <<<"$lane_help"; then
    printf 'Claude contract documents missing lane command %s\n' "$command" >&2
    exit 1
  fi
done
grok_lane_help="$(cd -- "$plugin_root" && GOCACHE="$contract_gocache" go run ./cmd/agent-session-runtime grok-lane --help)"
for command in run start resume wait status interrupt archive list doctor; do
  if ! grep -Fq "grok-peer-lane $command" <<<"$grok_lane_help"; then
    printf 'Claude Grok contract documents missing lane command %s\n' "$command" >&2
    exit 1
  fi
done
for event in lane.ready lane.list lane.doctor item.completed turn.completed lane.status lane.archived; do
  if ! grep -R -Fq "$event" "$plugin_root/claude/skills/grok-lane" "$plugin_root/docs/GROK-LANES.md"; then
    printf 'Claude Grok contract omits event %s\n' "$event" >&2
    exit 1
  fi
done
for flag in --name --cd --model --effort --sandbox --approval-policy --web --no-web \
  --config --timeout --persistent --auto-archive-after --no-auto-archive --notify --no-notify --schema --worktree --all --mine --prompt-file; do
  if ! grep -Fq -- "$flag" <<<"$lane_help"; then
    printf 'Claude contract documents missing lane flag %s\n' "$flag" >&2
    exit 1
  fi
done
for event in lane.ready lane.list lane.doctor item.completed turn.schema_retry turn.completed lane.status lane.archived; do
  if ! grep -R -Fq "$event" "$plugin_root/claude/skills/codex-lane" "$plugin_root/docs/CLAUDE-ADAPTER.md"; then
    printf 'Claude contract omits event %s\n' "$event" >&2
    exit 1
  fi
done
if ! grep -Fq 'Do **not** poll' "$plugin_root/claude/skills/codex-lane/SKILL.md"; then
  printf 'Codex lane skill does not document push-based peer delivery\n' >&2
  exit 1
fi

temporary_parent="$(cd -P -- "${TMPDIR:-/tmp}" && pwd)"
temporary_root="$(mktemp -d "$temporary_parent/codex-claude-contract.XXXXXX")"
cleanup() {
  rm -rf -- "$temporary_root"
}
trap cleanup EXIT
mkdir -p "$temporary_root/bin" "$temporary_root/state"

claude_release_root="$temporary_root/releases"
make -s -C "$plugin_root" stage-claude PREFIX="$temporary_root/prefix" \
  CLAUDE_RELEASE_ROOT="$claude_release_root"
staged_marketplace="$claude_release_root/$claude_version"
if [[ ! -f "$staged_marketplace/.claude-plugin/marketplace.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/.claude-plugin/plugin.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/.mcp.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/agent-sessions/SKILL.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/claude-lane/SKILL.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/SKILL.md" ]] ||
   [[ ! -x "$staged_marketplace/claude/skills/grok-lane/scripts/lane-preflight" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/references/contract.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/references/install.md" ]]; then
  printf 'Claude plugin was not staged as an immutable versioned marketplace\n' >&2
  exit 1
fi
printf '\n' >>"$staged_marketplace/claude/.claude-plugin/plugin.json"
set +e
make -s -C "$plugin_root" stage-claude PREFIX="$temporary_root/prefix" \
  CLAUDE_RELEASE_ROOT="$claude_release_root" >"$temporary_root/restage.out" 2>"$temporary_root/restage.err"
restage_status=$?
set -e
if (( restage_status == 0 )) || ! grep -Fq 'already exists with different content' "$temporary_root/restage.err"; then
  printf 'Claude immutable-stage guard accepted same-version content drift\n' >&2
  exit 1
fi

contract_binary_dir="$temporary_root/package-bin"
contract_release_dir="$temporary_root/package-release"
mkdir -p "$contract_binary_dir" "$contract_release_dir"
for binary in agent-session-runtime peer codex-peer claude-peer codex-peer-lane claude-peer-lane grok-peer grok-peer-lane peer-federator; do
  printf '%s\n' '#!/bin/sh' 'exit 0' >"$contract_binary_dir/$binary"
  chmod 0700 "$contract_binary_dir/$binary"
done
contract_archive="$("$plugin_root/scripts/package-release" contract-test contract-test \
  "$contract_binary_dir" "$contract_release_dir")"
contract_extract="$temporary_root/package-extract"
mkdir -p "$contract_extract"
tar -C "$contract_extract" -xzf "$contract_archive"
packaged_grok_skill="$contract_extract/agent-sessions-contract-test-contract-test/claude/skills/grok-lane"
if [[ ! -f "$packaged_grok_skill/SKILL.md" ]] ||
   [[ ! -x "$packaged_grok_skill/scripts/lane-preflight" ]] ||
   [[ ! -f "$packaged_grok_skill/references/contract.md" ]] ||
   [[ ! -f "$packaged_grok_skill/references/install.md" ]]; then
  printf 'Release package omitted part of the Claude Grok lane skill contract\n' >&2
  exit 1
fi

fake_claude="$temporary_root/bin/fake-claude"
claude_record="$temporary_root/claude-commands"
claude_state="$temporary_root/claude-installed"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "$*" >>"$FAKE_CLAUDE_RECORD"' \
  'if [ "$1 $2" = "plugin install" ] || [ "$1 $2" = "plugin update" ]; then' \
  '  if [ "${5-}" = "agent-sessions@agent-sessions" ]; then : >"$FAKE_CLAUDE_STATE"; fi' \
  'fi' \
  'if [ "$1 $2 $3" = "plugin list --json" ]; then' \
  '  if [ "${FAKE_CLAUDE_INSTALLED:-0}" = 1 ] || [ -f "$FAKE_CLAUDE_STATE" ]; then' \
  '    printf "%s\n" '\''[{"id":"agent-sessions@agent-sessions","scope":"user"},{"id":"codex-peer@agent-sessions","scope":"user"},{"id":"codex-peer@codex-messaging","scope":"user"},{"id":"agent-sessions@codex-messaging","scope":"user"}]'\''' \
  '  else' \
  '    printf "%s\n" '\''[{"id":"codex-peer@agent-sessions","scope":"user"},{"id":"codex-peer@codex-messaging","scope":"user"},{"id":"agent-sessions@codex-messaging","scope":"user"}]'\''' \
  '  fi' \
  'elif [ "$1 $2 $3 $4" = "plugin marketplace list --json" ]; then' \
  '  printf "%s\n" '\''[{"name":"codex-messaging"}]'\''' \
  'fi' >"$fake_claude"
chmod 0700 "$fake_claude"
assert_claude_migration_order() {
  local replacement legacy_id legacy_removal
  replacement="$(grep -nFx 'plugin update --scope user agent-sessions@agent-sessions' "$claude_record" | head -1 | cut -d: -f1)"
  for legacy_id in \
    codex-peer@agent-sessions \
    codex-peer@codex-messaging \
    agent-sessions@codex-messaging; do
    legacy_removal="$(grep -nFx "plugin uninstall --scope user $legacy_id" "$claude_record" | head -1 | cut -d: -f1)"
    if [[ -z "$replacement" || -z "$legacy_removal" ]] || (( replacement >= legacy_removal )); then
      printf 'Claude marketplace migration removed %s before accepting its replacement\n' "$legacy_id" >&2
      cat "$claude_record" >&2
      exit 1
    fi
  done
}
: >"$claude_record"
rm -f -- "$claude_state"
FAKE_CLAUDE_RECORD="$claude_record" FAKE_CLAUDE_STATE="$claude_state" FAKE_CLAUDE_INSTALLED=1 \
  make -s -C "$plugin_root" install-claude CLAUDE="$fake_claude" \
    CLAUDE_MARKETPLACE_ROOT="$plugin_root" CLAUDE_SCOPE=user
if ! grep -Fxq "plugin marketplace add --scope user $plugin_root" "$claude_record" ||
   ! grep -Fxq 'plugin update --scope user agent-sessions@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user codex-peer@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user codex-peer@codex-messaging' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user agent-sessions@codex-messaging' "$claude_record" ||
   ! grep -Fxq 'plugin marketplace remove --scope user codex-messaging' "$claude_record"; then
  printf 'Claude plugin update is not add-before-replace at the selected scope:\n' >&2
  cat "$claude_record" >&2
  exit 1
fi
assert_claude_migration_order
: >"$claude_record"
rm -f -- "$claude_state"
FAKE_CLAUDE_RECORD="$claude_record" FAKE_CLAUDE_STATE="$claude_state" FAKE_CLAUDE_INSTALLED=0 \
  make -s -C "$plugin_root" install-claude CLAUDE="$fake_claude" \
    CLAUDE_MARKETPLACE_ROOT="$plugin_root" CLAUDE_SCOPE=user
if ! grep -Fxq 'plugin install --scope user agent-sessions@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin update --scope user agent-sessions@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user codex-peer@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user codex-peer@codex-messaging' "$claude_record" ||
   ! grep -Fxq 'plugin uninstall --scope user agent-sessions@codex-messaging' "$claude_record" ||
   ! grep -Fxq 'plugin marketplace remove --scope user codex-messaging' "$claude_record"; then
  printf 'Claude plugin fresh install did not use the selected scope:\n' >&2
  cat "$claude_record" >&2
  exit 1
fi
assert_claude_migration_order
if ! grep -Fq 'CLAUDE_MARKETPLACE_ROOT ?= $(CLAUDE_STAGED_ROOT)' "$plugin_root/Makefile"; then
  printf 'Claude plugin installation no longer defaults to an immutable staged version\n' >&2
  exit 1
fi

fake_lane="$temporary_root/bin/codex-peer-lane"
fake_runtime="$temporary_root/fake-runtime"
printf '%s\n' '#!/bin/sh' 'exit 99' >"$fake_lane"
chmod 0700 "$fake_lane"
printf '%s\n' \
  '#!/bin/sh' \
  '[ "$1" = lane ] || exit 2' \
  'shift' \
  'case "$1" in' \
  '  --help) printf "%s\\n" "codex-peer-lane list [--all] [--mine]" "codex-peer-lane doctor [--json]" ;;' \
  '  doctor) printf "%s\\n" '\''{"type":"lane.doctor","contract_version":2,"appserver_reachable":true,"supervisor_reachable":true}'\'' ;;' \
  '  *) exit 2 ;;' \
  'esac' >"$fake_runtime"
chmod 0700 "$fake_runtime"
printf '%s\n' "$fake_runtime" >"$temporary_root/state/native-runtime-path"

ready_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" "$preflight")"
if ! grep -Fq '"summary": "ready"' <<<"$ready_report" ||
   ! grep -Fq '"runtime_ready": true' <<<"$ready_report" ||
   ! grep -Fq "\"invocation\": \"$fake_runtime lane\"" <<<"$ready_report"; then
  printf 'Claude lane preflight rejected a contract-1 runtime: %s\n' "$ready_report" >&2
  exit 1
fi

rm -f "$temporary_root/state/native-runtime-path"
set +e
launcher_only_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" "$preflight")"
launcher_only_status=$?
set -e
if (( launcher_only_status == 0 )) ||
   ! grep -Fq '"launcher_found": true' <<<"$launcher_only_report" ||
   ! grep -Fq 'native runtime is not initialized' <<<"$launcher_only_report"; then
  printf 'Claude lane preflight did not distinguish an uninitialized launcher: %s\n' "$launcher_only_report" >&2
  exit 1
fi
printf '%s\n' "$fake_runtime" >"$temporary_root/state/native-runtime-path"

printf '%s\n' \
  '#!/bin/sh' \
  '[ "$1" = lane ] || exit 2' \
  'shift' \
  'case "$1" in' \
  '  --help) printf "%s\\n" "codex-peer-lane list [--all] [--mine]" "codex-peer-lane doctor [--json]" ;;' \
  '  doctor) printf "%s\\n" '\''{"type":"lane.doctor","contract_version":2,"appserver_reachable":false,"supervisor_reachable":false}'\''; exit 1 ;;' \
  '  *) exit 2 ;;' \
  'esac' >"$fake_runtime"
set +e
unreachable_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" "$preflight")"
unreachable_status=$?
set -e
if (( unreachable_status == 0 )) || ! grep -Fq '"contract_ok": true' <<<"$unreachable_report" ||
   ! grep -Fq '"runtime_ready": false' <<<"$unreachable_report"; then
  printf 'Claude lane preflight did not distinguish compatibility from reachability\n' >&2
  exit 1
fi

path_grok_lane="$temporary_root/bin/grok-peer-lane"
fake_grok_lane="$temporary_root/grok-peer-lane"
grok_doctor_record="$temporary_root/grok-doctor-commands"
printf '%s\n' '#!/bin/sh' 'exit 88' >"$path_grok_lane"
chmod 0700 "$path_grok_lane"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "$*" >>"$FAKE_GROK_DOCTOR_RECORD"' \
  '[ "$*" = "doctor --json" ] || exit 2' \
  'case "${FAKE_GROK_DOCTOR_MODE:-ready}" in' \
  '  ready) printf "%s\n" '\''{"type":"lane.doctor","product":"grok","contract_version":1,"grok_available":true,"grok_path":"/fake/grok","grok_version":"grok 1.0.4","grok_error":null,"supervisor_reachable":false}'\'' ;;' \
  '  wrong-contract) printf "%s\n" '\''{"type":"lane.doctor","product":"grok","contract_version":2,"grok_available":true,"grok_error":null}'\'' ;;' \
  '  unavailable) printf "%s\n" '\''{"type":"lane.doctor","product":"grok","contract_version":1,"grok_available":false,"grok_path":null,"grok_error":null}'\''; exit 1 ;;' \
  '  grok-error) printf "%s\n" '\''{"type":"lane.doctor","product":"grok","contract_version":1,"grok_available":true,"grok_path":"/fake/grok","grok_error":"Grok Build version check failed"}'\''; exit 1 ;;' \
  '  *) exit 2 ;;' \
  'esac' >"$fake_grok_lane"
chmod 0700 "$fake_grok_lane"
printf '%s\n' "$fake_runtime" >"$temporary_root/state/native-runtime-path"

: >"$grok_doctor_record"
grok_ready_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  FAKE_GROK_DOCTOR_MODE=ready "$grok_preflight")"
if ! grep -Fq '"summary": "ready"' <<<"$grok_ready_report" ||
   ! grep -Fq '"runtime_ready": true' <<<"$grok_ready_report" ||
   ! grep -Fq '"contract_version": 1' <<<"$grok_ready_report" ||
   ! grep -Fq '"grok_available":true' <<<"$grok_ready_report" ||
   ! grep -Fq '"supervisor_reachable":false' <<<"$grok_ready_report" ||
   ! grep -Fq "\"invocation\": \"$fake_grok_lane\"" <<<"$grok_ready_report" ||
   [[ "$(<"$grok_doctor_record")" != 'doctor --json' ]]; then
  printf 'Claude Grok lane preflight rejected a ready contract-1 runtime: %s\n' "$grok_ready_report" >&2
  exit 1
fi

rm -f "$temporary_root/state/native-runtime-path"
set +e
grok_missing_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  "$grok_preflight")"
grok_missing_status=$?
set -e
if (( grok_missing_status == 0 )) ||
   ! grep -Fq '"launcher_found": true' <<<"$grok_missing_report" ||
   ! grep -Fq '"runtime_found": false' <<<"$grok_missing_report" ||
   ! grep -Fq '"invocation": ""' <<<"$grok_missing_report" ||
   ! grep -Fq 'Grok lane runtime is not installed' <<<"$grok_missing_report"; then
  printf 'Claude Grok lane preflight did not fail closed without the installed runtime marker: %s\n' "$grok_missing_report" >&2
  exit 1
fi
printf '%s\n' "$fake_runtime" >"$temporary_root/state/native-runtime-path"

set +e
grok_wrong_contract_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  FAKE_GROK_DOCTOR_MODE=wrong-contract "$grok_preflight")"
grok_wrong_contract_status=$?
set -e
if (( grok_wrong_contract_status == 0 )) ||
   ! grep -Fq '"contract_version": 2' <<<"$grok_wrong_contract_report" ||
   ! grep -Fq '"runtime_ready": false' <<<"$grok_wrong_contract_report" ||
   ! grep -Fq '"doctor_exit": 0' <<<"$grok_wrong_contract_report"; then
  printf 'Claude Grok lane preflight accepted the wrong contract major: %s\n' "$grok_wrong_contract_report" >&2
  exit 1
fi

set +e
grok_unavailable_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  FAKE_GROK_DOCTOR_MODE=unavailable "$grok_preflight")"
grok_unavailable_status=$?
set -e
if (( grok_unavailable_status == 0 )) ||
   ! grep -Fq '"contract_version": 1' <<<"$grok_unavailable_report" ||
   ! grep -Fq '"runtime_ready": false' <<<"$grok_unavailable_report" ||
   ! grep -Fq '"doctor_exit": 1' <<<"$grok_unavailable_report" ||
   ! grep -Fq '"grok_available":false' <<<"$grok_unavailable_report"; then
  printf 'Claude Grok lane preflight accepted an unavailable Grok Build CLI: %s\n' "$grok_unavailable_report" >&2
  exit 1
fi

set +e
grok_error_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  CLAUDE_PEER_DATA_DIR="$temporary_root/state" FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  FAKE_GROK_DOCTOR_MODE=grok-error "$grok_preflight")"
grok_error_status=$?
set -e
if (( grok_error_status == 0 )) ||
   ! grep -Fq '"runtime_ready": false' <<<"$grok_error_report" ||
   ! grep -Fq '"doctor_exit": 1' <<<"$grok_error_report" ||
   ! grep -Fq '"grok_error":"Grok Build version check failed"' <<<"$grok_error_report"; then
  printf 'Claude Grok lane preflight accepted a failed Grok Build probe: %s\n' "$grok_error_report" >&2
  exit 1
fi

mkdir -p "$temporary_root/cachebuster/.codex-plugin" "$temporary_root/cachebuster/claude/.claude-plugin" \
  "$temporary_root/cachebuster/grok/.grok-plugin" \
  "$temporary_root/cachebuster/scripts"
cp "$plugin_root/.codex-plugin/plugin.json" "$temporary_root/cachebuster/.codex-plugin/plugin.json"
cp "$plugin_root/claude/.claude-plugin/plugin.json" "$temporary_root/cachebuster/claude/.claude-plugin/plugin.json"
cp "$plugin_root/grok/.grok-plugin/plugin.json" "$temporary_root/cachebuster/grok/.grok-plugin/plugin.json"
cp "$plugin_root/scripts/cachebuster" "$temporary_root/cachebuster/scripts/cachebuster"
next_version="$("$temporary_root/cachebuster/scripts/cachebuster")"
next_codex="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/.codex-plugin/plugin.json" | head -1)"
next_claude="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/claude/.claude-plugin/plugin.json" | head -1)"
next_grok="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/grok/.grok-plugin/plugin.json" | head -1)"
if [[ "$next_version" != "$next_codex" || "$next_version" != "$next_claude" ||
   "$next_version" != "$next_grok" ]]; then
  printf 'cachebuster did not update all plugin manifests together\n' >&2
  exit 1
fi

if command -v claude >/dev/null 2>&1; then
  claude plugin validate "$plugin_root" --strict
  claude plugin validate "$plugin_root/claude" --strict
fi
