#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  link_target="$(readlink "$script_path")"
  if [[ "$link_target" == /* ]]; then
    script_path="$link_target"
  else
    script_path="$script_dir/$link_target"
  fi
done
plugin_root="$(cd "$(dirname "$script_path")/.." && pwd -P)"

preflight="$plugin_root/claude/skills/codex-lane/scripts/lane-preflight"
grok_preflight="$plugin_root/claude/skills/grok-lane/scripts/lane-preflight"
sh -n "$preflight"
sh -n "$grok_preflight"
if [[ ! -x "$grok_preflight" ]]; then
  printf 'Claude Grok lane preflight is not executable\n' >&2
  exit 1
fi
if [[ ! -x "$preflight" ]]; then
  printf 'Claude Codex lane preflight is not executable: %s\n' "$preflight" >&2
  exit 1
fi
for dependency in awk sed; do
  if ! PATH=/usr/bin:/bin command -v "$dependency" >/dev/null 2>&1; then
    printf 'Restricted macOS-compatible lane preflight PATH lacks %s\n' "$dependency" >&2
    exit 1
  fi
done
nonportable_preflight="$({
  grep -nF '\|' "$preflight" "$grok_preflight" || true
  grep -En 'sed[[:space:]]+(-E|-r|--)|grep[^[:cntrl:]]*[[:space:]]-P|readlink[[:space:]]+-f|xargs[[:space:]]+-r|stat[[:space:]]+-c|date[[:space:]]+-d' \
    "$preflight" "$grok_preflight" || true
})"
if [[ -n "$nonportable_preflight" ]]; then
  printf 'Lane preflight contains a GNU-only shell dependency:\n%s\n' "$nonportable_preflight" >&2
  exit 1
fi

codex_version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$plugin_root/.codex-plugin/plugin.json" | head -1)"
claude_version="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$plugin_root/claude/.claude-plugin/plugin.json" | head -1)"
if [[ -z "$codex_version" || "$claude_version" != "$codex_version" ]]; then
  printf 'Codex and Claude plugin versions differ: %s != %s\n' "$codex_version" "$claude_version" >&2
  exit 1
fi
for manifest in \
  "$plugin_root/.codex-plugin/plugin.json" \
  "$plugin_root/claude/.claude-plugin/plugin.json" \
  "$plugin_root/grok/.grok-plugin/plugin.json"; do
  if [[ "$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -1)" != agent-sessions ]]; then
    printf 'Plugin manifest does not use the uniform agent-sessions identity: %s\n' "$manifest" >&2
    exit 1
  fi
done
marketplace_plugin_name="$(awk '
  /"plugins"[[:space:]]*:/ { plugins = 1; next }
  plugins && /"name"[[:space:]]*:/ {
    line = $0
    sub(/^[^:]*:[[:space:]]*"/, "", line)
    sub(/".*/, "", line)
    print line
    exit
  }
' "$plugin_root/.claude-plugin/marketplace.json")"
if [[ "$marketplace_plugin_name" != agent-sessions ]]; then
  printf 'Claude marketplace plugin entry does not use the agent-sessions identity\n' >&2
  exit 1
fi
codex_marketplace_plugin_name="$(awk '
  /"plugins"[[:space:]]*:/ { plugins = 1; next }
  plugins && /"name"[[:space:]]*:/ {
    line = $0
    sub(/^[^:]*:[[:space:]]*"/, "", line)
    sub(/".*/, "", line)
    print line
    exit
  }
' "$plugin_root/.agents/plugins/marketplace.json")"
if [[ "$codex_marketplace_plugin_name" != agent-sessions ]]; then
  printf 'Codex marketplace plugin entry does not use the agent-sessions identity\n' >&2
  exit 1
fi
if grep -Eq '"version"[[:space:]]*:' "$plugin_root/.claude-plugin/marketplace.json"; then
  printf 'Claude marketplace must not shadow the plugin manifest version\n' >&2
  exit 1
fi

skill="$plugin_root/claude/skills/codex-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$skill" | head -1)" != codex-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$skill" | head -1)" ]]; then
  printf 'Claude skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
grok_skill="$plugin_root/claude/skills/grok-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$grok_skill" | head -1)" != grok-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$grok_skill" | head -1)" ]]; then
  printf 'Claude Grok skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
grok_messaging_skill="$plugin_root/grok/skills/agent-sessions/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$grok_messaging_skill" | head -1)" != agent-sessions ]] ||
   ! grep -Fq 'agent_sessions.list_peers' "$grok_messaging_skill" ||
   ! grep -Fq 'agent_sessions.send_message' "$grok_messaging_skill" ||
   ! grep -Fq 'agent_sessions.broadcast' "$grok_messaging_skill"; then
  printf 'Grok grouped messaging skill is incomplete\n' >&2
  exit 1
fi
self_skill="$plugin_root/claude/skills/claude-lane/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$self_skill" | head -1)" != claude-lane ]] ||
   [[ -z "$(sed -n 's/^description:[[:space:]]*//p' "$self_skill" | head -1)" ]]; then
  printf 'Claude self-lane skill frontmatter is incomplete or mismatched\n' >&2
  exit 1
fi
messaging_skill="$plugin_root/claude/skills/agent-sessions/SKILL.md"
if [[ "$(sed -n 's/^name:[[:space:]]*//p' "$messaging_skill" | head -1)" != agent-sessions ]] ||
   ! grep -Fq 'agent_sessions.list_peers' "$messaging_skill" ||
   ! grep -Fq 'agent_sessions.send_message' "$messaging_skill" ||
   ! grep -Fq 'agent_sessions.broadcast' "$messaging_skill" ||
   ! grep -Fq "Do not fall back to Claude's native" "$messaging_skill" ||
   grep -Fq 'AGENT_SESSIONS_FRAME' "$messaging_skill"; then
  printf 'Claude grouped messaging skill is incomplete\n' >&2
  exit 1
fi
claude_markdown=()
while IFS= read -r file; do
  claude_markdown[${#claude_markdown[@]}]="$file"
done < <(find "$plugin_root/claude" -type f -name '*.md' -print)
if ((${#claude_markdown[@]})) && grep -Hin 'allowed-tools' "${claude_markdown[@]}"; then
  printf 'Claude plugin unexpectedly grants tools\n' >&2
  exit 1
fi
for reference in events failures install policy; do
  file="$plugin_root/claude/skills/codex-lane/references/$reference.md"
  if [[ ! -f "$file" ]] || ! grep -Fq "references/$reference.md" "$skill"; then
    printf 'Claude skill reference %s is missing or unlinked\n' "$reference" >&2
    exit 1
  fi
done
for reference in contract install; do
  file="$plugin_root/claude/skills/grok-lane/references/$reference.md"
  if [[ ! -f "$file" ]] || ! grep -Fq "references/$reference.md" "$grok_skill"; then
    printf 'Claude Grok skill reference %s is missing or unlinked\n' "$reference" >&2
    exit 1
  fi
done

for forbidden in hooks agents settings.json; do
  if [[ -e "$plugin_root/claude/$forbidden" ]]; then
    printf 'Claude plugin isolation violated by %s\n' "$forbidden" >&2
    exit 1
  fi
done
if [[ ! -f "$plugin_root/claude/.mcp.json" ]] ||
   ! grep -Fq '"agent_sessions"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"agent-sessions"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"connector"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"claude"' "$plugin_root/claude/.mcp.json" ||
   ! grep -Fq '"mcp"' "$plugin_root/claude/.mcp.json"; then
  printf 'Claude structured messaging MCP inventory is incomplete\n' >&2
  exit 1
fi
if find "$plugin_root/claude" -type l -print -quit | grep -q .; then
  printf 'Claude plugin must be self-contained and may not rely on symlinks\n' >&2
  exit 1
fi
publishable_text=()
while IFS= read -r file; do
  publishable_text[${#publishable_text[@]}]="$file"
done < <(find \
  "$plugin_root/.claude-plugin" "$plugin_root/claude" "$plugin_root/docs" \
  -type f \( -name '*.md' -o -name '*.json' -o -name 'lane-preflight' \) -print)
publishable_text+=("$plugin_root/README.md")
if ((${#publishable_text[@]})) && grep -Hini -E 'builder|umka|kernel-tdd|/home/antst' "${publishable_text[@]}"; then
  printf 'Publishable documentation contains a project-specific reference\n' >&2
  exit 1
fi
cached_plugin_text=()
while IFS= read -r file; do
  cached_plugin_text[${#cached_plugin_text[@]}]="$file"
done < <(find "$plugin_root/claude" -type f \
  \( -name '*.md' -o -name '*.json' -o -name 'lane-preflight' \) -print)
if ((${#cached_plugin_text[@]})) && grep -Hini -E '\.\./docs/|docs/CLAUDE-' "${cached_plugin_text[@]}"; then
  printf 'Cached Claude plugin contains a reference outside its plugin root\n' >&2
  exit 1
fi
if grep -Fq "s/\\r/" "$preflight"; then
  printf 'Claude lane preflight uses GNU-only sed carriage-return matching\n' >&2
  exit 1
fi
if grep -Fq "s/\\r/" "$grok_preflight"; then
  printf 'Grok lane preflight uses GNU-only sed carriage-return matching\n' >&2
  exit 1
fi

contract_gocache="${GOCACHE:-${TMPDIR:-/tmp}/agent-sessions-go-cache}"
mkdir -p "$contract_gocache"
contract_help_root="$(mktemp -d "${TMPDIR:-/tmp}/agent-sessions-help.XXXXXX")"
GOCACHE="$contract_gocache" go build -o "$contract_help_root/agent-sessions" "$plugin_root/cmd/agent-sessions"
while IFS= read -r alias; do
  case "$alias" in
    *-peer-lane) ln -s agent-sessions "$contract_help_root/$alias" ;;
  esac
done < <("$plugin_root/scripts/release-inventory" host-aliases)
lane_help="$({
  for command in run start resume wait status interrupt archive list doctor; do
    "$contract_help_root/codex-peer-lane" "$command" --help
  done
})"
for command in run start resume wait status interrupt archive list doctor; do
  if ! grep -Fq "codex-peer-lane $command" <<<"$lane_help"; then
    printf 'Claude contract documents missing lane command %s\n' "$command" >&2
    exit 1
  fi
done
grok_lane_help="$({
  for command in run start resume wait status interrupt archive list doctor; do
    "$contract_help_root/grok-peer-lane" "$command" --help
  done
})"
for command in run start resume wait status interrupt archive list doctor; do
  if ! grep -Fq "grok-peer-lane $command" <<<"$grok_lane_help"; then
    printf 'Claude Grok contract documents missing lane command %s\n' "$command" >&2
    exit 1
  fi
done
find "$contract_help_root" -depth -delete
for event in lane.ready lane.list lane.doctor item.completed turn.completed lane.status lane.archived; do
  if ! grep -R -Fq "$event" "$plugin_root/claude/skills/grok-lane" "$plugin_root/docs/GROK-LANES.md"; then
    printf 'Claude Grok contract omits event %s\n' "$event" >&2
    exit 1
  fi
done
for flag in --name --cd --model --effort --sandbox --approval-policy --web --no-web \
  --config --timeout --persistent --auto-archive-after --no-auto-archive --notify --no-notify --schema --worktree --all --mine --prompt-file; do
  if ! grep -Fq -- "$flag" <<<"$lane_help"; then
    printf 'Claude contract documents missing lane flag %s\n' "$flag" >&2
    exit 1
  fi
done
for event in lane.ready lane.list lane.doctor item.completed turn.schema_retry turn.completed lane.status lane.archived; do
  if ! grep -R -Fq "$event" "$plugin_root/claude/skills/codex-lane" "$plugin_root/docs/CLAUDE-ADAPTER.md"; then
    printf 'Claude contract omits event %s\n' "$event" >&2
    exit 1
  fi
done
if ! grep -Fq 'Do **not** poll' "$plugin_root/claude/skills/codex-lane/SKILL.md"; then
  printf 'Codex lane skill does not document push-based peer delivery\n' >&2
  exit 1
fi

temporary_parent="$(cd -P -- "${TMPDIR:-/tmp}" && pwd)"
temporary_root="$(mktemp -d "$temporary_parent/codex-claude-contract.XXXXXX")"
cleanup() {
  rm -rf -- "$temporary_root"
}
trap cleanup EXIT
mkdir -p "$temporary_root/bin" "$temporary_root/state"

claude_release_root="$temporary_root/releases"
make -s -C "$plugin_root" stage-claude PREFIX="$temporary_root/prefix" \
  CLAUDE_RELEASE_ROOT="$claude_release_root"
staged_marketplace="$claude_release_root/$claude_version"
if [[ ! -f "$staged_marketplace/.claude-plugin/marketplace.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/.claude-plugin/plugin.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/.mcp.json" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/agent-sessions/SKILL.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/claude-lane/SKILL.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/SKILL.md" ]] ||
   [[ ! -x "$staged_marketplace/claude/skills/grok-lane/scripts/lane-preflight" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/references/contract.md" ]] ||
   [[ ! -f "$staged_marketplace/claude/skills/grok-lane/references/install.md" ]]; then
  printf 'Claude plugin was not staged as an immutable versioned marketplace\n' >&2
  exit 1
fi
printf '\n' >>"$staged_marketplace/claude/.claude-plugin/plugin.json"
set +e
make -s -C "$plugin_root" stage-claude PREFIX="$temporary_root/prefix" \
  CLAUDE_RELEASE_ROOT="$claude_release_root" >"$temporary_root/restage.out" 2>"$temporary_root/restage.err"
restage_status=$?
set -e
if (( restage_status == 0 )) || ! grep -Fq 'already exists with different content' "$temporary_root/restage.err"; then
  printf 'Claude immutable-stage guard accepted same-version content drift\n' >&2
  exit 1
fi

contract_binary_dir="$temporary_root/package-bin"
contract_release_dir="$temporary_root/package-release"
mkdir -p "$contract_binary_dir" "$contract_release_dir"
contract_clean_bin="$temporary_root/clean-bin"
if [[ -e "$contract_clean_bin" ]]; then
  printf 'Clean-bin Claude contract fixture unexpectedly exists: %s\n' "$contract_clean_bin" >&2
  exit 1
fi
while IFS= read -r binary; do
  printf '%s\n' '#!/bin/sh' 'exit 0' >"$contract_binary_dir/$binary"
  chmod 0700 "$contract_binary_dir/$binary"
done < <("$plugin_root/scripts/release-inventory" binaries)
rm -f -- "$contract_binary_dir/agent-sessions"
go build -o "$contract_binary_dir/agent-sessions" "$plugin_root/cmd/agent-sessions"
contract_platform="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
case "$contract_platform" in
  linux-x86_64) contract_platform=linux-x64 ;;
  linux-aarch64) contract_platform=linux-arm64 ;;
  darwin-x86_64) contract_platform=darwin-x64 ;;
  darwin-arm64) ;;
  *) printf 'unsupported contract packaging platform %s\n' "$contract_platform" >&2; exit 2 ;;
esac
contract_version="$(<"$plugin_root/deploy/agent-sessions/VERSION")"
contract_archive="$(AGENT_SESSIONS_RELEASE_PACKAGER="$contract_binary_dir/agent-sessions" \
  "$plugin_root/scripts/package-release" "$contract_platform" "$contract_version" \
  "$contract_binary_dir" "$contract_release_dir")"
contract_extract="$temporary_root/package-extract"
mkdir -p "$contract_extract"
tar -C "$contract_extract" -xzf "$contract_archive"
packaged_grok_skill="$contract_extract/agent-sessions-$contract_version-$contract_platform/claude/skills/grok-lane"
if [[ ! -f "$packaged_grok_skill/SKILL.md" ]] ||
   [[ ! -x "$packaged_grok_skill/scripts/lane-preflight" ]] ||
   [[ ! -f "$packaged_grok_skill/references/contract.md" ]] ||
   [[ ! -f "$packaged_grok_skill/references/install.md" ]]; then
  printf 'Release package omitted part of the Claude Grok lane skill contract\n' >&2
  exit 1
fi

fake_claude="$temporary_root/bin/fake-claude"
claude_record="$temporary_root/claude-commands"
claude_plugin_state="$temporary_root/claude-installed"
claude_marketplace_state="$temporary_root/claude-marketplace-source"
prior_claude_source="$temporary_root/prior-claude-marketplace"
mkdir -p "$prior_claude_source"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "$*" >>"$FAKE_CLAUDE_RECORD"' \
  'if [ "$1 $2 $3 $4" = "plugin marketplace list --json" ]; then' \
  '  if [ -s "$FAKE_CLAUDE_MARKETPLACE_STATE" ]; then' \
  '    IFS= read -r source <"$FAKE_CLAUDE_MARKETPLACE_STATE"' \
  '    printf '\''[{"name":"agent-sessions","path":"%s"}]\n'\'' "$source"' \
  '  else' \
  '    printf "%s\n" '\''[]'\''' \
  '  fi' \
  'elif [ "$1 $2 $3" = "plugin list --json" ]; then' \
  '  if [ -f "$FAKE_CLAUDE_PLUGIN_STATE" ]; then' \
  '    printf "%s\n" '\''[{"id":"agent-sessions@agent-sessions","scope":"user"}]'\''' \
  '  else' \
  '    printf "%s\n" '\''[]'\''' \
  '  fi' \
  'elif [ "$1 $2" = "plugin uninstall" ] && [ "${5-}" = "agent-sessions@agent-sessions" ]; then' \
  '  rm -f -- "$FAKE_CLAUDE_PLUGIN_STATE"' \
  'elif [ "$1 $2 $3" = "plugin marketplace remove" ] && [ "${6-}" = "agent-sessions" ]; then' \
  '  rm -f -- "$FAKE_CLAUDE_MARKETPLACE_STATE"' \
  'elif [ "$1 $2 $3" = "plugin marketplace add" ]; then' \
  '  printf "%s\n" "${6-}" >"$FAKE_CLAUDE_MARKETPLACE_STATE"' \
  'elif [ "$1 $2" = "plugin install" ] && [ "${5-}" = "agent-sessions@agent-sessions" ]; then' \
  '  : >"$FAKE_CLAUDE_PLUGIN_STATE"' \
  'fi' >"$fake_claude"
chmod 0700 "$fake_claude"
: >"$claude_record"
printf '%s\n' "$prior_claude_source" >"$claude_marketplace_state"
: >"$claude_plugin_state"
FAKE_CLAUDE_RECORD="$claude_record" \
  FAKE_CLAUDE_PLUGIN_STATE="$claude_plugin_state" \
  FAKE_CLAUDE_MARKETPLACE_STATE="$claude_marketplace_state" \
  make -s -C "$plugin_root" install-claude CLAUDE="$fake_claude" \
    CLAUDE_MARKETPLACE_ROOT="$plugin_root" CLAUDE_SCOPE=user \
    BIN_DIR="$contract_clean_bin" CONNECTOR_INSTALLER="$contract_binary_dir/agent-sessions"
if ! grep -Fxq 'plugin uninstall --scope user agent-sessions@agent-sessions' "$claude_record" ||
   ! grep -Fxq 'plugin marketplace remove --scope user agent-sessions' "$claude_record" ||
   ! grep -Fxq "plugin marketplace add --scope user $plugin_root" "$claude_record" ||
   ! grep -Fxq 'plugin install --scope user agent-sessions@agent-sessions' "$claude_record" ||
   [[ "$(<"$claude_marketplace_state")" != "$plugin_root" ]] ||
   [[ ! -f "$claude_plugin_state" ]]; then
  printf 'Claude connector replacement did not publish the exact selected source and plugin:\n' >&2
  cat "$claude_record" >&2
  exit 1
fi
: >"$claude_record"
rm -f -- "$claude_plugin_state" "$claude_marketplace_state"
FAKE_CLAUDE_RECORD="$claude_record" \
  FAKE_CLAUDE_PLUGIN_STATE="$claude_plugin_state" \
  FAKE_CLAUDE_MARKETPLACE_STATE="$claude_marketplace_state" \
  make -s -C "$plugin_root" install-claude CLAUDE="$fake_claude" \
    CLAUDE_MARKETPLACE_ROOT="$plugin_root" CLAUDE_SCOPE=user \
    BIN_DIR="$contract_clean_bin" CONNECTOR_INSTALLER="$contract_binary_dir/agent-sessions"
if ! grep -Fxq 'plugin install --scope user agent-sessions@agent-sessions' "$claude_record" ||
   ! grep -Fxq "plugin marketplace add --scope user $plugin_root" "$claude_record" ||
   grep -Fq 'plugin uninstall --scope user' "$claude_record" ||
   grep -Fq 'plugin marketplace remove --scope user' "$claude_record" ||
   [[ "$(<"$claude_marketplace_state")" != "$plugin_root" ]] ||
   [[ ! -f "$claude_plugin_state" ]]; then
  printf 'Claude connector fresh install did not publish only the selected source and plugin:\n' >&2
  cat "$claude_record" >&2
  exit 1
fi
if ! grep -Fq 'CLAUDE_MARKETPLACE_ROOT ?= $(CLAUDE_STAGED_ROOT)' "$plugin_root/Makefile"; then
  printf 'Claude plugin installation no longer defaults to an immutable staged version\n' >&2
  exit 1
fi

contract_assert_status() {
  local scenario="$1" expected="$2" actual="$3"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Contract assertion failed: %s status\nexpected: %s\nactual: %s\n' \
      "$scenario" "$expected" "$actual" >&2
    exit 1
  fi
}

contract_assert_contains() {
  local scenario="$1" field="$2" expected="$3" report="$4"
  if ! grep -Fq -- "$expected" <<<"$report"; then
    printf 'Contract assertion failed: %s field %s\nexpected fragment: %s\nreport:\n%s\n' \
      "$scenario" "$field" "$expected" "$report" >&2
    exit 1
  fi
}

contract_assert_command() {
  local scenario="$1" expected="$2" record="$3" actual
  actual="$(<"$record")"
  if [[ "$actual" != "$expected" ]]; then
    printf 'Contract assertion failed: %s command\nexpected: %s\nactual: %s\n' \
      "$scenario" "$expected" "$actual" >&2
    exit 1
  fi
}

assertion_diagnostic="$temporary_root/assertion-diagnostic"
set +e
(
  contract_assert_contains 'diagnostic canary' daemon_ready '"daemon_ready": true' '{"daemon_ready":false}'
) 2>"$assertion_diagnostic"
assertion_diagnostic_status=$?
set -e
if ((assertion_diagnostic_status == 0)) ||
   ! grep -Fq 'diagnostic canary field daemon_ready' "$assertion_diagnostic" ||
   ! grep -Fq 'expected fragment: "daemon_ready": true' "$assertion_diagnostic" ||
   ! grep -Fq 'report:' "$assertion_diagnostic"; then
  printf 'Contract assertion diagnostic canary was silent or unattributable:\n' >&2
  cat "$assertion_diagnostic" >&2
  exit 1
fi

fake_lane="$temporary_root/bin/codex-peer-lane"
codex_doctor_record="$temporary_root/codex-doctor-commands"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "$*" >>"$FAKE_CODEX_DOCTOR_RECORD"' \
  '[ "$*" = "doctor --json" ] || exit 2' \
  'case "${FAKE_CODEX_DOCTOR_MODE:-ready}" in' \
  '  ready) printf "%s\n" '\''{'\'' '\''  "type":"lane.doctor",'\'' '\''  "authority":"daemon",'\'' '\''  "product":"codex",'\'' '\''  "ready":true'\'' '\''}'\'' ;;' \
  '  unavailable) printf "%s\n" '\''{"type":"lane.doctor","authority":"daemon","product":"codex","ready":false}'\''; exit 1 ;;' \
  '  wrong-product) printf "%s\n" '\''{"type":"lane.doctor","authority":"daemon","product":"grok","ready":true}'\'' ;;' \
  '  *) exit 2 ;;' \
  'esac' >"$fake_lane"
chmod 0700 "$fake_lane"

: >"$codex_doctor_record"
set +e
ready_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_CODEX_DOCTOR_RECORD="$codex_doctor_record" FAKE_CODEX_DOCTOR_MODE=ready "$preflight")"
ready_status=$?
set -e
contract_assert_status 'Codex ready preflight' 0 "$ready_status"
contract_assert_contains 'Codex ready preflight' summary '"summary": "ready"' "$ready_report"
contract_assert_contains 'Codex ready preflight' launcher_found '"launcher_found": true' "$ready_report"
contract_assert_contains 'Codex ready preflight' daemon_ready '"daemon_ready": true' "$ready_report"
contract_assert_contains 'Codex ready preflight' doctor_exit '"doctor_exit": 0' "$ready_report"
contract_assert_contains 'Codex ready preflight' authority '"authority": "daemon"' "$ready_report"
contract_assert_contains 'Codex ready preflight' product '"product": "codex"' "$ready_report"
contract_assert_contains 'Codex ready preflight' invocation "\"invocation\": \"$fake_lane\"" "$ready_report"
contract_assert_command 'Codex ready preflight' 'doctor --json' "$codex_doctor_record"

: >"$codex_doctor_record"
set +e
launcher_only_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_CODEX_DOCTOR_RECORD="$codex_doctor_record" FAKE_CODEX_DOCTOR_MODE=unavailable "$preflight")"
launcher_only_status=$?
set -e
contract_assert_status 'Codex unavailable preflight' 1 "$launcher_only_status"
contract_assert_contains 'Codex unavailable preflight' launcher_found '"launcher_found": true' "$launcher_only_report"
contract_assert_contains 'Codex unavailable preflight' daemon_ready '"daemon_ready": false' "$launcher_only_report"
contract_assert_contains 'Codex unavailable preflight' doctor_exit '"doctor_exit": 1' "$launcher_only_report"
contract_assert_contains 'Codex unavailable preflight' authority '"authority": "daemon"' "$launcher_only_report"
contract_assert_contains 'Codex unavailable preflight' product '"product": "codex"' "$launcher_only_report"
contract_assert_contains 'Codex unavailable preflight' summary 'Codex lane daemon or adapter is unavailable' "$launcher_only_report"
contract_assert_command 'Codex unavailable preflight' 'doctor --json' "$codex_doctor_record"

: >"$codex_doctor_record"
set +e
unreachable_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_CODEX_DOCTOR_RECORD="$codex_doctor_record" FAKE_CODEX_DOCTOR_MODE=wrong-product "$preflight")"
unreachable_status=$?
set -e
contract_assert_status 'Codex wrong-product preflight' 1 "$unreachable_status"
contract_assert_contains 'Codex wrong-product preflight' daemon_ready '"daemon_ready": false' "$unreachable_report"
contract_assert_contains 'Codex wrong-product preflight' doctor_exit '"doctor_exit": 0' "$unreachable_report"
contract_assert_contains 'Codex wrong-product preflight' authority '"authority": "daemon"' "$unreachable_report"
contract_assert_contains 'Codex wrong-product preflight' product '"product": "grok"' "$unreachable_report"
contract_assert_command 'Codex wrong-product preflight' 'doctor --json' "$codex_doctor_record"

path_grok_lane="$temporary_root/bin/grok-peer-lane"
grok_doctor_record="$temporary_root/grok-doctor-commands"
printf '%s\n' \
  '#!/bin/sh' \
  'printf "%s\n" "$*" >>"$FAKE_GROK_DOCTOR_RECORD"' \
  '[ "$*" = "doctor --json" ] || exit 2' \
  'case "${FAKE_GROK_DOCTOR_MODE:-ready}" in' \
  '  ready) printf "%s\n" '\''{'\'' '\''  "type":"lane.doctor",'\'' '\''  "authority":"daemon",'\'' '\''  "product":"grok",'\'' '\''  "ready":true'\'' '\''}'\'' ;;' \
  '  unavailable) printf "%s\n" '\''{"type":"lane.doctor","authority":"daemon","product":"grok","ready":false}'\''; exit 1 ;;' \
  '  wrong-product) printf "%s\n" '\''{"type":"lane.doctor","authority":"daemon","product":"codex","ready":true}'\'' ;;' \
  '  wrong-authority) printf "%s\n" '\''{"type":"lane.doctor","authority":"legacy-runtime","product":"grok","ready":true}'\'' ;;' \
  '  *) exit 2 ;;' \
  'esac' >"$path_grok_lane"
chmod 0700 "$path_grok_lane"

: >"$grok_doctor_record"
set +e
grok_ready_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" \
  FAKE_GROK_DOCTOR_MODE=ready "$grok_preflight")"
grok_ready_status=$?
set -e
contract_assert_status 'Grok ready preflight' 0 "$grok_ready_status"
contract_assert_contains 'Grok ready preflight' summary '"summary": "ready"' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' launcher_found '"launcher_found": true' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' daemon_ready '"daemon_ready": true' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' doctor_exit '"doctor_exit": 0' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' authority '"authority": "daemon"' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' product '"product": "grok"' "$grok_ready_report"
contract_assert_contains 'Grok ready preflight' invocation "\"invocation\": \"$path_grok_lane\"" "$grok_ready_report"
contract_assert_command 'Grok ready preflight' 'doctor --json' "$grok_doctor_record"

: >"$grok_doctor_record"
set +e
grok_missing_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" FAKE_GROK_DOCTOR_MODE=unavailable "$grok_preflight")"
grok_missing_status=$?
set -e
contract_assert_status 'Grok unavailable preflight' 1 "$grok_missing_status"
contract_assert_contains 'Grok unavailable preflight' launcher_found '"launcher_found": true' "$grok_missing_report"
contract_assert_contains 'Grok unavailable preflight' daemon_ready '"daemon_ready": false' "$grok_missing_report"
contract_assert_contains 'Grok unavailable preflight' doctor_exit '"doctor_exit": 1' "$grok_missing_report"
contract_assert_contains 'Grok unavailable preflight' authority '"authority": "daemon"' "$grok_missing_report"
contract_assert_contains 'Grok unavailable preflight' product '"product": "grok"' "$grok_missing_report"
contract_assert_contains 'Grok unavailable preflight' summary 'Grok lane daemon or adapter is unavailable' "$grok_missing_report"
contract_assert_command 'Grok unavailable preflight' 'doctor --json' "$grok_doctor_record"

: >"$grok_doctor_record"
set +e
grok_wrong_contract_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" FAKE_GROK_DOCTOR_MODE=wrong-product "$grok_preflight")"
grok_wrong_contract_status=$?
set -e
contract_assert_status 'Grok wrong-product preflight' 1 "$grok_wrong_contract_status"
contract_assert_contains 'Grok wrong-product preflight' daemon_ready '"daemon_ready": false' "$grok_wrong_contract_report"
contract_assert_contains 'Grok wrong-product preflight' doctor_exit '"doctor_exit": 0' "$grok_wrong_contract_report"
contract_assert_contains 'Grok wrong-product preflight' authority '"authority": "daemon"' "$grok_wrong_contract_report"
contract_assert_contains 'Grok wrong-product preflight' product '"product": "codex"' "$grok_wrong_contract_report"
contract_assert_command 'Grok wrong-product preflight' 'doctor --json' "$grok_doctor_record"

: >"$grok_doctor_record"
set +e
grok_unavailable_report="$(PATH="$temporary_root/bin:/usr/bin:/bin" HOME="$temporary_root" \
  FAKE_GROK_DOCTOR_RECORD="$grok_doctor_record" FAKE_GROK_DOCTOR_MODE=wrong-authority "$grok_preflight")"
grok_unavailable_status=$?
set -e
contract_assert_status 'Grok wrong-authority preflight' 1 "$grok_unavailable_status"
contract_assert_contains 'Grok wrong-authority preflight' daemon_ready '"daemon_ready": false' "$grok_unavailable_report"
contract_assert_contains 'Grok wrong-authority preflight' doctor_exit '"doctor_exit": 0' "$grok_unavailable_report"
contract_assert_contains 'Grok wrong-authority preflight' authority '"authority": "legacy-runtime"' "$grok_unavailable_report"
contract_assert_contains 'Grok wrong-authority preflight' product '"product": "grok"' "$grok_unavailable_report"
contract_assert_command 'Grok wrong-authority preflight' 'doctor --json' "$grok_doctor_record"

mkdir -p "$temporary_root/cachebuster/.codex-plugin" "$temporary_root/cachebuster/claude/.claude-plugin" \
  "$temporary_root/cachebuster/grok/.grok-plugin" \
  "$temporary_root/cachebuster/scripts"
cp "$plugin_root/.codex-plugin/plugin.json" "$temporary_root/cachebuster/.codex-plugin/plugin.json"
cp "$plugin_root/claude/.claude-plugin/plugin.json" "$temporary_root/cachebuster/claude/.claude-plugin/plugin.json"
cp "$plugin_root/grok/.grok-plugin/plugin.json" "$temporary_root/cachebuster/grok/.grok-plugin/plugin.json"
cp "$plugin_root/scripts/cachebuster" "$temporary_root/cachebuster/scripts/cachebuster"
next_version="$("$temporary_root/cachebuster/scripts/cachebuster")"
next_codex="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/.codex-plugin/plugin.json" | head -1)"
next_claude="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/claude/.claude-plugin/plugin.json" | head -1)"
next_grok="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$temporary_root/cachebuster/grok/.grok-plugin/plugin.json" | head -1)"
if [[ "$next_version" != "$next_codex" || "$next_version" != "$next_claude" ||
   "$next_version" != "$next_grok" ]]; then
  printf 'cachebuster did not update all plugin manifests together\n' >&2
  exit 1
fi

if command -v claude >/dev/null 2>&1; then
  claude plugin validate "$plugin_root" --strict
  claude plugin validate "$plugin_root/claude" --strict
fi
