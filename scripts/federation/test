#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"

bash -n "$project_root/scripts/federation/test"
python3 - "$project_root" <<'PY'
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
for path in (root / "scripts" / "federation").glob("*.py"):
    compile(path.read_bytes(), str(path), "exec")
PY

cd -- "$project_root"
if [[ "${SKIP_GO_TEST:-0}" != "1" ]]; then
  if [[ "${RACE:-0}" == "1" ]]; then
    go test -race ./internal/federation ./internal/daemon ./cmd/agent-sessions ./cmd/agent-sessions-hub
  else
    go test ./internal/federation ./internal/daemon ./cmd/agent-sessions ./cmd/agent-sessions-hub
  fi
fi
if ! grep -Fq '# Federation protocol version 4' docs/federation/PROTOCOL.md ||
   ! grep -Fq 'broadcasts one complete roster to every' docs/federation/PROTOCOL.md ||
   ! grep -Fq 'drains accepted work' docs/federation/PROTOCOL.md; then
  printf 'protocol documentation does not pin uniform protocol-4 behavior\n' >&2
  exit 1
fi
