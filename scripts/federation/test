#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
	link_target="$(readlink -- "$script_path")"
	if [[ "$link_target" == /* ]]; then script_path="$link_target"; else script_path="$script_dir/$link_target"; fi
done
project_root="$(cd -- "$(dirname -- "$script_path")/../.." && pwd -P)"

bash -n "$script_path"
python3 - "$project_root/scripts/federation/integration_test.py" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
compile(path.read_bytes(), str(path), "exec")
PY

cd -- "$project_root"
if [[ "${SKIP_GO_TEST:-0}" != 1 ]]; then
	mode=normal
	go_test_options=(-count=1 -json)
	if [[ "${RACE:-0}" == 1 ]]; then
		mode=race
		go_test_options=(-race "${go_test_options[@]}")
	fi

	run_go_cell() {
		local cell="$1"
		local package="$2"
		local expression="$3"
		local expected_csv="$4"
		local log_file
		log_file="$(mktemp "${TMPDIR:-/tmp}/agent-sessions-federation-cell.XXXXXX")"
		if ! go test "${go_test_options[@]}" "$package" -run "^(${expression})$" >"$log_file"; then
			cat -- "$log_file" >&2
			rm -f -- "$log_file"
			printf 'federation acceptance cell %s failed in %s mode\n' "$cell" "$mode" >&2
			exit 1
		fi
		python3 - "$cell" "$mode" "$package" "$expected_csv" "$log_file" <<'PY'
import json
import pathlib
import platform
import sys

cell, mode, package, expected_csv, log_name = sys.argv[1:]
expected = set(expected_csv.split(","))
ran: set[str] = set()
passed: set[str] = set()
skipped: set[str] = set()
for line in pathlib.Path(log_name).read_text().splitlines():
    event = json.loads(line)
    test = event.get("Test")
    action = event.get("Action")
    if action == "skip" and isinstance(test, str) and any(
        test == root or test.startswith(root + "/") for root in expected
    ):
        skipped.add(test)
    if test not in expected:
        continue
    if action == "run":
        ran.add(test)
    elif action == "pass":
        passed.add(test)
if ran != expected or passed != expected or skipped:
    raise SystemExit(
        f"cell {cell} did not run and pass its exact test inventory: "
        f"expected={sorted(expected)} ran={sorted(ran)} passed={sorted(passed)} skipped={sorted(skipped)}"
    )
print(json.dumps({
    "type": "unified.federation.cell.passed",
    "cell": cell,
    "mode": mode,
    "platform": platform.system().lower(),
    "package": package,
    "tests": sorted(expected),
}, separators=(",", ":")))
PY
		rm -f -- "$log_file"
	}

	run_go_cell hub-cli-runtime ./cmd/agent-sessions-hub \
		'TestHubServePublishesIndependentStatusAndSupportsProtocolProbe|TestHubStatusUnavailableDoesNotCreateStateOrStartService|TestAcceptanceResourcePreflightCoversExactInstalledFailureInventory' \
		'TestHubServePublishesIndependentStatusAndSupportsProtocolProbe,TestHubStatusUnavailableDoesNotCreateStateOrStartService,TestAcceptanceResourcePreflightCoversExactInstalledFailureInventory'
	run_go_cell hub-role-lifecycle ./internal/federation \
		'TestHubRoleDescriptorUsesDistinctSelectedBinaryAndSharedServiceEngine|TestCoLocatedHostAndHubUseIndependentReleaseSelectionUpgradeRollbackAndRemoval|TestHubInstalledListenerIsStableInjectionSafeAndMatchesBoundWildcard' \
		'TestHubRoleDescriptorUsesDistinctSelectedBinaryAndSharedServiceEngine,TestCoLocatedHostAndHubUseIndependentReleaseSelectionUpgradeRollbackAndRemoval,TestHubInstalledListenerIsStableInjectionSafeAndMatchesBoundWildcard'
	run_go_cell hub-release-preservation ./internal/releaseinstall \
		'TestRoleLayoutsAreDisjointAndReleaseIdentityIncludesContent|TestInstallStagesImmutableReleaseCommitsPointerAndRequiresReadiness|TestReadinessFailureRestoresExactPriorSelectionAndHookState|TestRoleNeutralRemovalPreservesStateAndPurgeIsRevisionBound' \
		'TestRoleLayoutsAreDisjointAndReleaseIdentityIncludesContent,TestInstallStagesImmutableReleaseCommitsPointerAndRequiresReadiness,TestReadinessFailureRestoresExactPriorSelectionAndHookState,TestRoleNeutralRemovalPreservesStateAndPurgeIsRevisionBound'
	run_go_cell hub-observability ./internal/federation \
		'TestHubObservabilityManifestIsClosedCompleteAndIndependent|TestEveryHubCoreObservabilitySinkUsesMetadataOnlyContentCanary|TestHubServiceManagerCapturedOutputUsesTheSameContentPolicy|TestHubStatusAndDoctorHaveStableSharedEnvelopeWithoutHostAuthority|TestHubDoctorRetainsCauseSpecificBoundedRemediation|TestHubProductionListenerAppliesResourcePreflightAndEveryMetadataOnlySink' \
		'TestHubObservabilityManifestIsClosedCompleteAndIndependent,TestEveryHubCoreObservabilitySinkUsesMetadataOnlyContentCanary,TestHubServiceManagerCapturedOutputUsesTheSameContentPolicy,TestHubStatusAndDoctorHaveStableSharedEnvelopeWithoutHostAuthority,TestHubDoctorRetainsCauseSpecificBoundedRemediation,TestHubProductionListenerAppliesResourcePreflightAndEveryMetadataOnlySink'
	run_go_cell hub-resource-preflight ./internal/federation \
		'TestHubResourceFailuresRejectBeforeDurableRegistrationOrWorkAcceptance|TestHubAdmissionReportsSuccessOnlyAfterDurableCommit|TestHubAdmissionHasNoAgentSessionsQuota' \
		'TestHubResourceFailuresRejectBeforeDurableRegistrationOrWorkAcceptance,TestHubAdmissionReportsSuccessOnlyAfterDurableCommit,TestHubAdmissionHasNoAgentSessionsQuota'
	run_go_cell three-host-peer-routing ./internal/federation \
		'TestCapabilityPublicationAndHubRegistryAreProtocolAndGenerationBound|TestRouterUsesGlobalGroupsHostSuffixesAndIdempotentMessageAdmission|TestHubDeliveryAdmissionAndOutcomeOwnershipFailClosed' \
		'TestCapabilityPublicationAndHubRegistryAreProtocolAndGenerationBound,TestRouterUsesGlobalGroupsHostSuffixesAndIdempotentMessageAdmission,TestHubDeliveryAdmissionAndOutcomeOwnershipFailClosed'
	run_go_cell all-product-remote-lanes ./internal/federation \
		'TestRemoteLaneDispatchCallsDestinationAuthorityDirectlyForEveryProduct|TestRemoteLaneDispatchPropagatesExactAttestedParentGroupsAndPermission|TestRemoteLaneDispatchIsIdempotentWithoutDuplicateDestinationWork|TestRemoteLaneResultPublishesOneContentFreeParentNotice|TestRemoteLaneDispatchHasNoLaneWatchProcessBoundary' \
		'TestRemoteLaneDispatchCallsDestinationAuthorityDirectlyForEveryProduct,TestRemoteLaneDispatchPropagatesExactAttestedParentGroupsAndPermission,TestRemoteLaneDispatchIsIdempotentWithoutDuplicateDestinationWork,TestRemoteLaneResultPublishesOneContentFreeParentNotice,TestRemoteLaneDispatchHasNoLaneWatchProcessBoundary'
	run_go_cell host-restart-reconnect ./internal/daemon \
		'TestEmbeddedFederationAdvertisesStableHostIdentityAndOnlyReadyProducts|TestEmbeddedFederationRecoversConnectionGenerationAndReadvertisesCurrentReadyProducts|TestEmbeddedFederationSuccessorKeepsHostIdentityAndPublishesNewRuntimeGeneration|TestFederationHubOutageIsRetryableBeforeAcceptanceWithoutLocalFallback' \
		'TestEmbeddedFederationAdvertisesStableHostIdentityAndOnlyReadyProducts,TestEmbeddedFederationRecoversConnectionGenerationAndReadvertisesCurrentReadyProducts,TestEmbeddedFederationSuccessorKeepsHostIdentityAndPublishesNewRuntimeGeneration,TestFederationHubOutageIsRetryableBeforeAcceptanceWithoutLocalFallback'
	run_go_cell protocol-interoperability ./internal/federation \
		'TestArbitrarySHABuildsInteroperateByProtocolVersionOnly|TestCapabilitiesGateOperationsWithoutCouplingReleases|TestProtocolMismatchNamesRequiredVersionBeforeRegistration|TestHostAgentHandshakesBeforePublishingSnapshot|TestHostAgentReconnectsWithTheSameAdvertisement|TestHostAgentRejectsMismatchedHelloBeforeSnapshot' \
		'TestArbitrarySHABuildsInteroperateByProtocolVersionOnly,TestCapabilitiesGateOperationsWithoutCouplingReleases,TestProtocolMismatchNamesRequiredVersionBeforeRegistration,TestHostAgentHandshakesBeforePublishingSnapshot,TestHostAgentReconnectsWithTheSameAdvertisement,TestHostAgentRejectsMismatchedHelloBeforeSnapshot'

	case "$(uname -s)" in
		Linux)
			run_go_cell hub-service-capture ./internal/servicecontrol \
				'TestLinuxServiceLifecycleUsesExactRoleDescriptor|TestEveryLinuxServiceCaptureDelegatesToSharedContentCanary' \
				'TestLinuxServiceLifecycleUsesExactRoleDescriptor,TestEveryLinuxServiceCaptureDelegatesToSharedContentCanary'
			;;
		Darwin)
			run_go_cell hub-service-capture ./internal/servicecontrol \
				'TestDarwinRoleDescriptorsRequireLoginStartKeepAliveAndSeparateOwnership|TestDarwinLaunchdCapturedOutputExcludesContentCanaries|TestDarwinSleepWakeObservesOneExistingOrReplacementJobWithoutLifecycleMutation' \
				'TestDarwinRoleDescriptorsRequireLoginStartKeepAliveAndSeparateOwnership,TestDarwinLaunchdCapturedOutputExcludesContentCanaries,TestDarwinSleepWakeObservesOneExistingOrReplacementJobWithoutLifecycleMutation'
			;;
	esac
fi

make -s build
platform="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
case "$platform" in
	linux-x86_64) platform=linux-x64 ;;
	linux-aarch64) platform=linux-arm64 ;;
	darwin-x86_64) platform=darwin-x64 ;;
	darwin-arm64) ;;
	*) printf 'unsupported federation integration platform %s\n' "$platform" >&2; exit 2 ;;
esac

python3 "$project_root/scripts/federation/integration_test.py" \
	"$project_root/bin/$platform/agent-sessions" \
	"$project_root/bin/$platform/agent-sessions-hub"

if [[ "$(uname -s)" == Linux && "${RACE:-0}" != 1 && "${SKIP_INSTALLED_HUB:-0}" != 1 ]]; then
	"$project_root/scripts/federation/test-installed-hub"
fi

if [[ "${RACE:-0}" != 1 && "${SKIP_BINARY_PAIRS:-0}" != 1 ]]; then
	"$project_root/scripts/federation/test-binary-pairs"
fi
