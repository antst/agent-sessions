#!/usr/bin/env bash
set -euo pipefail

# Repository orchestration for the unified two-image topology. Tests may use
# in-process daemon generations or the isolated service-manager fixture, but
# this runner never starts another production host daemon itself.

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P -- "$(dirname -- "$script_path")" && pwd)"
	link_target="$(readlink -- "$script_path")"
	if [[ "$link_target" == /* ]]; then script_path="$link_target"; else script_path="$script_dir/$link_target"; fi
done
plugin_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"

# Darwin's ambient TMPDIR is spelled through the /var -> /private/var alias.
# Test fixtures that intentionally exercise no-follow walks must begin from the
# canonical spelling, and socket fixtures benefit from the shorter root.
if [[ "$(uname -s)" == Darwin ]]; then
	export TMPDIR=/private/tmp
fi

bash -n \
	"$plugin_root/scripts/cachebuster" \
	"$plugin_root/scripts/package-release" \
	"$plugin_root/scripts/release-final-gate" \
	"$plugin_root/scripts/release-inventory" \
	"$plugin_root/scripts/release-publication-preflight" \
	"$plugin_root/scripts/release-tag-preflight" \
	"$plugin_root/scripts/release-tag-verify" \
	"$plugin_root/scripts/repair-history-projection" \
	"$plugin_root/scripts/native-entry" \
	"$plugin_root/scripts/ci-run-as-clean-systemd-user" \
	"$plugin_root/scripts/test-claude-contract" \
	"$plugin_root/scripts/federation/test" \
	"$plugin_root/scripts/federation/test-installed-hub" \
	"$plugin_root/scripts/test-unified-peers" \
	"$plugin_root/scripts/test-unified-lane-restart" \
	"$plugin_root/scripts/test-unified-lane-composition" \
	"$plugin_root/scripts/test-unified-migration" \
	"$plugin_root/scripts/test-unified-service" \
	"$plugin_root/scripts/test-unified-stress" \
	"$plugin_root/claude/skills/grok-lane/scripts/lane-preflight" \
	"$plugin_root/grok/scripts/native-entry" \
	"$plugin_root/qwen/scripts/native-entry" \
	"$plugin_root/scripts/test"

python3 - "$plugin_root" <<'PY'
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
for path in (
    root / "scripts/release-gate-manifest",
    root / "scripts/federation/integration_test.py",
):
    compile(path.read_bytes(), str(path), "exec")
PY

for native_entry_copy in \
	"$plugin_root/grok/scripts/native-entry" \
	"$plugin_root/qwen/scripts/native-entry"; do
	if ! cmp -s "$plugin_root/scripts/native-entry" "$native_entry_copy"; then
		printf 'plugin native-entry copy drifted from the canonical host entry point: %s\n' "$native_entry_copy" >&2
		exit 1
	fi
done

release_matrix="$("$plugin_root/scripts/release-inventory" matrix-json)"
release_package_inventory="$("$plugin_root/scripts/release-inventory" package-inventory-json)"
python3 - "$release_matrix" "$release_package_inventory" <<'PY'
import json
import sys

matrix = json.loads(sys.argv[1])
inventory = json.loads(sys.argv[2])
assert [row["platform"] for row in matrix["include"]] == [
    "linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64",
]
assert inventory["executables"] == ["agent-sessions", "agent-sessions-hub"]
assert [row["product"] for row in inventory["plugin_payloads"]] == [
    "codex", "claude", "grok", "qwen",
]
PY

temporary_root="$(mktemp -d "${TMPDIR:-/tmp}/agent-sessions-test.XXXXXX")"
cleanup() {
	find "$temporary_root" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

host_binary="$temporary_root/agent-sessions"
go build -o "$host_binary" "$plugin_root/cmd/agent-sessions"
while IFS= read -r alias; do
	[[ -n "$alias" && "$alias" != agent-sessions ]] || continue
	ln -s agent-sessions "$temporary_root/$alias"
done < <("$plugin_root/scripts/release-inventory" host-aliases)

host_help="$($host_binary help --json)"
python3 - "$host_help" <<'PY'
import json
import sys

document = json.loads(sys.argv[1])
assert document["ok"] is True
assert document["result"]["binaries"] == ["agent-sessions", "agent-sessions-hub"]
PY
while IFS='|' read -r product _plugin_paths; do
	for command in run start resume wait status interrupt archive list doctor; do
		"$temporary_root/$product-peer-lane" "$command" --help >/dev/null
	done
done < <("$plugin_root/scripts/release-inventory" plugins)

"$plugin_root/scripts/test-claude-contract"

cd -- "$plugin_root"
if [[ "${RACE:-0}" == 1 ]]; then
	go test -race ./...
	RACE=1 SKIP_GO_TEST=1 make -s federation-integration
else
	go test ./...
	SKIP_GO_TEST=1 make -s federation-integration
	make -s unified-live-contracts
fi
