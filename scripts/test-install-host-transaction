#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"
temporary_parent="${TMPDIR:-/tmp}"
if [[ "$(uname -s)" == Darwin ]]; then
  # The transaction still exercises the Linux service adapter, but the test
  # binary has Darwin's shorter Unix-domain socket limit. Keep its isolated
  # state root compact before the fixture replaces uname with its Linux shim.
  temporary_parent=/tmp
fi
temporary_parent="$(cd -P -- "$temporary_parent" && pwd)"
test_root="$(mktemp -d "$temporary_parent/agent-sessions-install-transaction.XXXXXX")"
service_pid=""
cleanup() {
  status=$?
  if [[ $status -ne 0 && -f "$test_root/service.log" ]]; then
    printf '%s\n' '--- isolated host service log ---' >&2
    sed -n '1,240p' "$test_root/service.log" >&2
  fi
  if [[ $status -ne 0 && -f "$test_root/claude-record" ]]; then
    printf '%s\n' '--- isolated Claude command log ---' >&2
    sed -n '1,240p' "$test_root/claude-record" >&2
  fi
  if [[ -f "$test_root/service.pid" ]]; then
    service_pid=$(cat "$test_root/service.pid" 2>/dev/null || true)
    if [[ "$service_pid" =~ ^[0-9]+$ ]]; then
      kill "$service_pid" >/dev/null 2>&1 || true
      for _ in {1..100}; do
        if ! kill -0 "$service_pid" >/dev/null 2>&1; then break; fi
        sleep 0.01
      done
    fi
  fi
  rm -rf -- "$test_root"
}
trap cleanup EXIT

host_binary="${AGENT_SESSIONS_TEST_HOST_BINARY:-$test_root/agent-sessions}"
if [[ -z "${AGENT_SESSIONS_TEST_HOST_BINARY:-}" ]]; then
  go build -o "$host_binary" "$root/cmd/agent-sessions"
fi
[[ -x "$host_binary" && ! -L "$host_binary" ]] || {
  printf 'transaction test requires a built Linux host binary: %s\n' "$host_binary" >&2
  exit 2
}

home="$test_root/home"
prefix="$test_root/prefix"
fake_bin="$test_root/bin"
state_root="$test_root/state"
real_npm=$(command -v npm)
mkdir -p "$home" "$prefix" "$fake_bin" "$state_root"

cat >"$fake_bin/qwen" <<'EOF'
#!/bin/sh
set -eu
case "$1 $2" in
  "extensions list")
    if [ -s "$TEST_QWEN_STATE" ]; then printf '%s\n' 'agent-sessions enabled'; fi
    ;;
  "extensions uninstall")
    if [ -n "${TEST_QWEN_UNINSTALL_RECORD:-}" ]; then
      if [ -d "$TEST_QWEN_UNINSTALL_RELEASE" ]; then
        printf '%s\n' release-present >>"$TEST_QWEN_UNINSTALL_RECORD"
      else
        printf '%s\n' release-missing >>"$TEST_QWEN_UNINSTALL_RECORD"
      fi
    fi
    rm -f -- "$TEST_QWEN_STATE"
    ;;
  "extensions install")
    if [ "${TEST_QWEN_FAIL_ONCE:-0}" = 1 ] && [ ! -e "$TEST_QWEN_FAILURE_MARKER" ]; then
      : >"$TEST_QWEN_FAILURE_MARKER"
      exit 44
    fi
    if [ -n "${TEST_QWEN_SIGNAL_INSTALLER:-}" ] && [ ! -e "$TEST_QWEN_SIGNAL_MARKER" ]; then
      : >"$TEST_QWEN_SIGNAL_MARKER"
      kill -s "$TEST_QWEN_SIGNAL_INSTALLER" "$PPID"
      exit 0
    fi
    printf '%s\n' "$3" >"$TEST_QWEN_STATE"
    ;;
  *) exit 91 ;;
esac
EOF
chmod 0700 "$fake_bin/qwen"

cat >"$fake_bin/opencode" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod 0700 "$fake_bin/opencode"

cat >"$fake_bin/kilo" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod 0700 "$fake_bin/kilo"

cat >"$fake_bin/pnpm" <<'EOF'
#!/bin/sh
set -eu
if [ "$1" = "--version" ]; then printf '%s\n' '10.28.1'; exit 0; fi
exit 91
EOF
chmod 0700 "$fake_bin/pnpm"

cat >"$fake_bin/dsh" <<'EOF'
#!/bin/sh
set -eu
printf '%s\n' "$*" >>"$TEST_DSH_RECORD"
if [ "$1" = "--version" ]; then printf '%s\n' "${TEST_DSH_VERSION:-dsh 0.1.2-alpha.5}"; exit 0; fi
[ "$1 $2 $3" = "plugin --profile agent-sessions" ] || exit 91
case "$4" in
  list)
    first=1
    printf '%s' '{"dependencies":{'
    for package in dsh-native dsh-comms dsh-lane; do
      if [ -e "$TEST_DSH_STATE_DIR/$package" ]; then
        if [ "$first" = 0 ]; then printf ','; fi
        printf '"@agent-sessions/%s":{}' "$package"
        first=0
      fi
    done
    printf '%s\n' '}}'
    ;;
  remove)
    package=${5#@agent-sessions/}
    rm -f -- "$TEST_DSH_STATE_DIR/$package"
    case "$package" in
      dsh-native) rm -rf -- "$TEST_DSH_LEGACY_ROOT" ;;
      dsh-comms) rm -rf -- "$TEST_DSH_COMMS_ROOT" ;;
      dsh-lane) rm -rf -- "$TEST_DSH_LANE_ROOT" ;;
      *) exit 93 ;;
    esac
    ;;
  add)
    case "${5##*/}" in
      agent-sessions-dsh-comms-*.tgz) package=dsh-comms; plugin_root=$TEST_DSH_COMMS_ROOT ;;
      agent-sessions-dsh-lane-*.tgz) package=dsh-lane; plugin_root=$TEST_DSH_LANE_ROOT ;;
      *) exit 92 ;;
    esac
    case "$5" in
      "$TEST_PREFIX"/libexec/agent-sessions/host/releases/*/integrations/dsh/*.tgz) ;;
      *) exit 92 ;;
    esac
    extract="$TEST_DSH_EXTRACT_ROOT/$package"
    rm -rf -- "$extract" "$plugin_root"
    mkdir -p "$extract" "$(dirname -- "$plugin_root")" "$TEST_DSH_STATE_DIR"
    tar -xzf "$5" -C "$extract"
    mv -- "$extract/package" "$plugin_root"
    : >"$TEST_DSH_STATE_DIR/$package"
    ;;
  *) exit 91 ;;
esac
EOF
chmod 0700 "$fake_bin/dsh"

cat >"$fake_bin/claude" <<'EOF'
#!/bin/sh
set -eu
printf '%s\n' "$*" >>"$TEST_CLAUDE_RECORD"
case "$1 $2" in
  "plugin validate") ;;
  "plugin marketplace")
    [ "$3" = add ] || exit 92
    eval "marketplace=\${$#}"
    printf '%s\n' "$marketplace" >"$TEST_CLAUDE_MARKETPLACE"
    ;;
  "plugin list")
    if [ -e "$TEST_CLAUDE_STATE" ]; then
      printf '[{"id":"agent-sessions@agent-sessions","scope":"user","installPath":"%s"}]\n' "$TEST_CLAUDE_CACHE"
    else
      printf '%s\n' '[]'
    fi
    ;;
  "plugin update")
    # Deliberately reproduce Claude's equal-version no-op.
    ;;
  "plugin uninstall")
    if [ -d "$TEST_CLAUDE_CACHE" ]; then
      find -P "$TEST_CLAUDE_CACHE" -type d -exec chmod u+rwx {} +
    fi
    rm -rf -- "$TEST_CLAUDE_CACHE"
    rm -f -- "$TEST_CLAUDE_STATE"
    ;;
  "plugin install")
    marketplace=$(cat "$TEST_CLAUDE_MARKETPLACE")
    if [ -d "$TEST_CLAUDE_CACHE" ]; then
      find -P "$TEST_CLAUDE_CACHE" -type d -exec chmod u+rwx {} +
    fi
    rm -rf -- "$TEST_CLAUDE_CACHE"
    mkdir -p "$TEST_CLAUDE_CACHE"
    cp -R -- "$marketplace/claude/." "$TEST_CLAUDE_CACHE/"
    : >"$TEST_CLAUDE_STATE"
    ;;
  *) exit 91 ;;
esac
EOF
chmod 0700 "$fake_bin/claude"

cat >"$fake_bin/systemctl" <<'EOF'
#!/bin/sh
set -eu
arguments=" $* "
stop_service() {
  if [ -f "$TEST_SERVICE_PID_FILE" ]; then
    pid=$(cat "$TEST_SERVICE_PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ]; then
      kill "$pid" >/dev/null 2>&1 || true
      i=0
      while kill -0 "$pid" >/dev/null 2>&1 && [ "$i" -lt 100 ]; do
        i=$((i + 1))
        sleep 0.01
      done
    fi
    rm -f -- "$TEST_SERVICE_PID_FILE"
  fi
}
case "$arguments" in
  *" disable --now agent-sessions.service "*) stop_service ;;
  *" restart agent-sessions.service "*)
    stop_service
    AGENT_SESSIONS_STATE_ROOT="$AGENT_SESSIONS_STATE_ROOT" \
      "$TEST_PREFIX/bin/agent-sessions" daemon >"$TEST_SERVICE_LOG" 2>&1 &
    printf '%s\n' "$!" >"$TEST_SERVICE_PID_FILE"
    ;;
  *" show agent-sessions.service "*)
    if [ -f "$TEST_SERVICE_PID_FILE" ] &&
       pid=$(cat "$TEST_SERVICE_PID_FILE" 2>/dev/null) &&
       kill -0 "$pid" >/dev/null 2>&1; then
      restarts=0 result=success active=active
    elif grep -Fq 'LU15 fixture daemon failure' "$TEST_SERVICE_LOG" 2>/dev/null; then
      restarts=1 result=exit-code active=failed
    else
      restarts=0 result=success active=inactive
    fi
    case "$arguments" in
      *" -p NRestarts --value "*) printf '%s\n' "$restarts" ;;
      *)
        printf 'NRestarts=%s\nResult=%s\nActiveState=%s\n' "$restarts" "$result" "$active"
        ;;
    esac
    ;;
esac
exit 0
EOF
chmod 0700 "$fake_bin/systemctl"

cat >"$fake_bin/journalctl" <<'EOF'
#!/bin/sh
set -eu
cat "$TEST_SERVICE_LOG"
EOF
chmod 0700 "$fake_bin/journalctl"

# This transaction tests the Linux service adapter on every CI host. Without
# an isolated uname, a macOS runner reaches its real launchd domain even
# though the rest of the fixture (platform key, systemctl, paths, and service
# process) is deliberately Linux-shaped.
cat >"$fake_bin/uname" <<'EOF'
#!/bin/sh
printf '%s\n' Linux
EOF
chmod 0700 "$fake_bin/uname"

candidate="$test_root/candidate-agent-sessions"
cp -- "$host_binary" "$candidate"
printf 'different-candidate\n' >>"$candidate"
chmod 0755 "$candidate"

failing_candidate="$test_root/failing-agent-sessions"
cat >"$failing_candidate" <<'EOF'
#!/bin/sh
set -eu
if [ "${1:-}" = daemon ]; then
  printf '%s\n' 'LU15 fixture daemon failure' >&2
  exit 1
fi
exec "$TEST_REAL_HOST_BINARY" "$@"
EOF
chmod 0755 "$failing_candidate"

common_env=(
  "HOME=$home"
  "XDG_CONFIG_HOME=$home/.config"
  "AGENT_SESSIONS_STATE_ROOT=$state_root"
  "PATH=$fake_bin:/usr/bin:/bin"
  "CODEX=missing-codex"
  "CLAUDE=claude"
  "GROK=missing-grok"
  "QWEN=qwen"
  "OPENCODE=opencode"
  "KILO=kilo"
  "DSH=dsh"
  "PNPM=pnpm"
  "NPM=$real_npm"
  "DSH_HOME=$home/.dsh"
  "TEST_PREFIX=$prefix"
  "TEST_QWEN_STATE=$test_root/qwen-source"
  "TEST_QWEN_FAILURE_MARKER=$test_root/qwen-failed-once"
  "TEST_CLAUDE_STATE=$test_root/claude-installed"
  "TEST_CLAUDE_CACHE=$test_root/claude-cache"
  "TEST_CLAUDE_MARKETPLACE=$test_root/claude-marketplace"
  "TEST_CLAUDE_RECORD=$test_root/claude-record"
  "TEST_DSH_STATE_DIR=$test_root/dsh-state"
  "TEST_DSH_RECORD=$test_root/dsh-record"
  "TEST_DSH_LEGACY_ROOT=$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-native"
  "TEST_DSH_COMMS_ROOT=$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-comms"
  "TEST_DSH_LANE_ROOT=$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-lane"
  "TEST_DSH_EXTRACT_ROOT=$test_root/dsh-extract"
  "TEST_SERVICE_PID_FILE=$test_root/service.pid"
  "TEST_SERVICE_LOG=$test_root/service.log"
  "TEST_REAL_HOST_BINARY=$host_binary"
)

mkdir -p "$test_root/dsh-state" "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-native"
: >"$test_root/dsh-state/dsh-native"

env "${common_env[@]}" "$root/scripts/install-host" \
  "$root" "$host_binary" "$prefix" 0.3.0 linux-x64 >/dev/null
release="$prefix/libexec/agent-sessions/host/releases/0.3.0"
prior_hash=$(sha256sum "$release/bin/agent-sessions" | awk '{print $1}')
[[ -n "$prior_hash" && "$(cat "$test_root/qwen-source")" == "$release/qwen" ]]
diff -qr -- "$release/claude" "$test_root/claude-cache" >/dev/null
cmp -- "$home/.config/opencode/plugins/agent-sessions.js" "$release/integrations/opencode/agent-sessions.mjs"
cmp -- "$home/.config/opencode/shared/live-session.js" "$release/integrations/shared/live-session.js"
cmp -- "$home/.config/kilo/plugins/agent-sessions.js" "$release/integrations/kilo/agent-sessions.mjs"
cmp -- "$home/.config/kilo/shared/live-session.js" "$release/integrations/shared/live-session.js"
cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-comms/plugin.cjs" "$release/integrations/dsh/comms/plugin.cjs"
cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-comms/shared/live-session.cjs" "$release/integrations/shared/live-session.js"
cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-lane/plugin.cjs" "$release/integrations/dsh/lane/plugin.cjs"
test ! -e "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-native"
test -f "$release/integrations/dsh/agent-sessions-dsh-comms-0.4.0.tgz"
test -f "$release/integrations/dsh/agent-sessions-dsh-lane-0.4.0.tgz"
test -x "$release/scripts/pack-packages"
legacy_remove_line=$(grep -nF 'plugin --profile agent-sessions remove @agent-sessions/dsh-native' "$test_root/dsh-record" | head -1 | cut -d: -f1)
comms_add_line=$(grep -nF 'plugin --profile agent-sessions add ' "$test_root/dsh-record" | head -1 | cut -d: -f1)
lane_add_line=$(grep -nF 'plugin --profile agent-sessions add ' "$test_root/dsh-record" | tail -1 | cut -d: -f1)
[[ "$legacy_remove_line" -lt "$comms_add_line" && "$comms_add_line" -lt "$lane_add_line" ]]
test -x "$release/scripts/release-inventory"
find -P "$release" -type d -exec chmod 0555 {} +

# Reproduce an equal-version active cache that differs from the selected
# release. The next install must refresh it through Claude's supported
# lifecycle before the deliberately later Qwen failure exercises rollback.
printf 'stale same-version cache\n' >>"$test_root/claude-cache/skills/codex-lane/SKILL.md"

set +e
env "${common_env[@]}" TEST_QWEN_FAIL_ONCE=1 "$root/scripts/install-host" \
  "$root" "$candidate" "$prefix" 0.3.0 linux-x64 \
  >"$test_root/failed.out" 2>"$test_root/failed.err"
failed_status=$?
set -e
if [[ $failed_status -eq 0 ]] || ! grep -Fq 'restored the prior host release and integrations' "$test_root/failed.err"; then
  printf 'failed_status=%s\n' "$failed_status" >&2
  cat "$test_root/failed.out" >&2
  cat "$test_root/failed.err" >&2
  printf 'candidate integration failure did not execute the rollback transaction\n' >&2
  exit 1
fi
after_hash=$(sha256sum "$release/bin/agent-sessions" | awk '{print $1}')
selected_release=$(cd -P -- "$prefix/libexec/agent-sessions/host/current" && pwd)
if [[ "$after_hash" != "$prior_hash" ]] ||
   [[ "$selected_release" != "$release" ]] ||
   [[ "$(cat "$test_root/qwen-source")" != "$release/qwen" ]] ||
   ! diff -qr -- "$release/claude" "$test_root/claude-cache" >/dev/null ||
   ! cmp -- "$home/.config/opencode/plugins/agent-sessions.js" "$release/integrations/opencode/agent-sessions.mjs" >/dev/null ||
   ! cmp -- "$home/.config/opencode/shared/live-session.js" "$release/integrations/shared/live-session.js" >/dev/null ||
   ! cmp -- "$home/.config/kilo/plugins/agent-sessions.js" "$release/integrations/kilo/agent-sessions.mjs" >/dev/null ||
   ! cmp -- "$home/.config/kilo/shared/live-session.js" "$release/integrations/shared/live-session.js" >/dev/null ||
   ! cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-comms/plugin.cjs" "$release/integrations/dsh/comms/plugin.cjs" >/dev/null ||
   ! cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-comms/shared/live-session.cjs" "$release/integrations/shared/live-session.js" >/dev/null ||
   ! cmp -- "$home/.dsh/profiles/agent-sessions/node_modules/@agent-sessions/dsh-lane/plugin.cjs" "$release/integrations/dsh/lane/plugin.cjs" >/dev/null; then
  printf 'failed host update did not restore the exact release selection and Qwen source\n' >&2
  exit 1
fi
if ! grep -Fxq 'plugin uninstall --scope user --keep-data agent-sessions@agent-sessions' \
    "$test_root/claude-record"; then
  printf 'same-version Claude cache was not refreshed with persistent data preserved\n' >&2
  exit 1
fi
if ! env "${common_env[@]}" "$prefix/bin/agent-sessions" status \
  >"$test_root/status.out" 2>"$test_root/status.err"; then
  cat "$test_root/status.err" >&2
  if [[ -f "$test_root/service.pid" ]]; then
    service_pid=$(cat "$test_root/service.pid" 2>/dev/null || true)
    if [[ "$service_pid" =~ ^[0-9]+$ ]] && ! kill -0 "$service_pid" >/dev/null 2>&1; then
      printf 'isolated restored host service pid %s is not alive\n' "$service_pid" >&2
    fi
  fi
  find "$state_root" -maxdepth 3 -print >&2
  exit 1
fi

: >"$test_root/service.log"
SECONDS=0
set +e
env "${common_env[@]}" "$root/scripts/install-host" \
  "$root" "$failing_candidate" "$prefix" 0.3.0 linux-x64 \
  >"$test_root/daemon-failure.out" 2>"$test_root/daemon-failure.err"
daemon_failure_status=$?
set -e
daemon_failure_seconds=$SECONDS
if [[ $daemon_failure_status -eq 0 ]] || [[ $daemon_failure_seconds -gt 3 ]] ||
   ! grep -Fq 'LU15 fixture daemon failure' "$test_root/daemon-failure.err"; then
  printf 'failed daemon was not surfaced immediately (status=%s seconds=%s)\n' \
    "$daemon_failure_status" "$daemon_failure_seconds" >&2
  cat "$test_root/daemon-failure.out" >&2
  cat "$test_root/daemon-failure.err" >&2
  exit 1
fi
if ! env "${common_env[@]}" "$prefix/bin/agent-sessions" status >/dev/null 2>&1; then
  printf 'daemon-failure rollback did not restore the ready prior service\n' >&2
  exit 1
fi

for signal_case in TERM INT; do
  signal_marker="$test_root/qwen-signal-$signal_case"
  case "$signal_case" in
    TERM) expected_status=143 ;;
    INT) expected_status=130 ;;
  esac
  set +e
  env "${common_env[@]}" \
    "TEST_QWEN_SIGNAL_INSTALLER=$signal_case" \
    "TEST_QWEN_SIGNAL_MARKER=$signal_marker" \
    "$root/scripts/install-host" "$root" "$candidate" "$prefix" 0.3.0 linux-x64 \
    >"$test_root/signal-$signal_case.out" 2>"$test_root/signal-$signal_case.err"
  signal_status=$?
  set -e
  after_hash=$(sha256sum "$release/bin/agent-sessions" | awk '{print $1}')
  selected_release=$(cd -P -- "$prefix/libexec/agent-sessions/host/current" && pwd)
  if [[ $signal_status -ne $expected_status ]] ||
     [[ "$after_hash" != "$prior_hash" ]] ||
     [[ "$selected_release" != "$release" ]] ||
     find "$prefix/libexec/agent-sessions/host/releases" -maxdepth 1 \
       \( -name '.previous-*' -o -name '.stage.*' \) -print -quit | grep -q .; then
    printf '%s signal did not restore the exact prior release (status=%s)\n' \
      "$signal_case" "$signal_status" >&2
    cat "$test_root/signal-$signal_case.out" >&2
    cat "$test_root/signal-$signal_case.err" >&2
    exit 1
  fi
done

legacy_alias_directory="$prefix/libexec/agent-sessions/bin/linux-x64"
ln -s "$legacy_alias_directory/peer" "$prefix/bin/peer"
ln -s /bin/true "$prefix/bin/user-tool"
old_release="$prefix/libexec/agent-sessions/host/releases/0.2.0"
orphan_backup="$prefix/libexec/agent-sessions/host/releases/.previous-0.2.0-123"
orphan_stage="$prefix/libexec/agent-sessions/host/releases/.stage.orphan"
stray_file="$prefix/libexec/agent-sessions/host/releases/unexpected-file"
stray_link="$prefix/libexec/agent-sessions/host/releases/unexpected-link"
unsafe_release="$prefix/libexec/agent-sessions/host/releases/0.1.0"
mkdir -p "$old_release" "$orphan_backup" "$orphan_stage"
mkdir -p "$unsafe_release"
: >"$old_release/stale"
: >"$orphan_backup/stale"
: >"$orphan_stage/stale"
: >"$stray_file"
ln -s /bin/true "$stray_link"
ln -s /bin/true "$unsafe_release/inner-link"
env "${common_env[@]}" "$root/scripts/install-host" \
  "$root" "$candidate" "$prefix" 0.3.0 linux-x64 >"$test_root/success.out"
candidate_hash=$(sha256sum "$candidate" | awk '{print $1}')
installed_hash=$(sha256sum "$release/bin/agent-sessions" | awk '{print $1}')
selected_release=$(cd -P -- "$prefix/libexec/agent-sessions/host/current" && pwd)
if [[ "$installed_hash" != "$candidate_hash" ]] ||
   [[ "$selected_release" != "$release" ]] ||
   [[ $(find "$prefix/libexec/agent-sessions/host/releases" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d '[:space:]') -ne 4 ]] ||
   [[ ! -f "$stray_file" || ! -L "$stray_link" || ! -L "$unsafe_release/inner-link" ]] ||
   ! grep -Fxq "Removed stale Agent Sessions release path $old_release." "$test_root/success.out" ||
   ! grep -Fxq "Removed stale Agent Sessions release path $orphan_backup." "$test_root/success.out" ||
   ! grep -Fxq "Removed stale Agent Sessions release path $orphan_stage." "$test_root/success.out" ||
   ! grep -Fxq "Left Agent Sessions release path $stray_file in place; it is not a real directory." "$test_root/success.out" ||
   ! grep -Fxq "Left Agent Sessions release path $stray_link in place; it is not a real directory." "$test_root/success.out" ||
   ! grep -Fxq "Left Agent Sessions release path $unsafe_release in place; safe removal was refused." "$test_root/success.out"; then
  printf 'successful host update did not prune only safely removable release paths\n' >&2
  cat "$test_root/success.out" >&2
  exit 1
fi
if [[ -e "$prefix/bin/peer" || -L "$prefix/bin/peer" ]] || [[ ! -L "$prefix/bin/user-tool" ]]; then
  printf 'successful host update did not prune only stale managed aliases\n' >&2
  exit 1
fi

# A pre-campaign prior release has no managed integrations or release
# inventory. Rollback must remove the replacement integrations before their
# release tree, restore only that prior host/service, and never point the new
# alias inventory at an old binary that cannot serve it.
find -P "$release" -type d -exec chmod u+rwx {} +
rm -rf -- "$release/integrations"
rm -f -- "$release/scripts/release-inventory"
cat >"$release/bin/agent-sessions.pre-managed" <<'EOF'
#!/bin/sh
set -eu
case "${1:-}" in
  daemon)
    trap 'exit 0' TERM INT
    while :; do sleep 1; done
    ;;
  status) exit 0 ;;
  *) exit 0 ;;
esac
EOF
chmod 0755 "$release/bin/agent-sessions.pre-managed"
mv -- "$release/bin/agent-sessions.pre-managed" "$release/bin/agent-sessions"
pre_managed_hash=$(sha256sum "$release/bin/agent-sessions" | awk '{print $1}')
hub_binary="$prefix/libexec/agent-sessions/hub/current/bin/agent-sessions-hub"
mkdir -p "$(dirname -- "$hub_binary")"
: >"$hub_binary"
ln -s "$hub_binary" "$prefix/bin/agent-sessions-hub"
rm -f -- "$test_root/qwen-failed-once"
: >"$test_root/qwen-uninstall-record"
set +e
env "${common_env[@]}" \
  "TEST_QWEN_UNINSTALL_RECORD=$test_root/qwen-uninstall-record" \
  "TEST_QWEN_UNINSTALL_RELEASE=$release" \
  TEST_QWEN_FAIL_ONCE=1 \
  "$root/scripts/install-host" "$root" "$host_binary" "$prefix" 0.3.0 linux-x64 \
  >"$test_root/pre-managed.out" 2>"$test_root/pre-managed.err"
pre_managed_status=$?
set -e
if [[ $pre_managed_status -eq 0 ]] ||
   ! grep -Fq "Prior release $release predates managed integrations; integrations were not restored — rerun that release's installer." \
     "$test_root/pre-managed.err" ||
   [[ $(grep -Fxc release-present "$test_root/qwen-uninstall-record") -ne 2 ]] ||
   grep -Fq release-missing "$test_root/qwen-uninstall-record" ||
   [[ $(sha256sum "$release/bin/agent-sessions" | awk '{print $1}') != "$pre_managed_hash" ]] ||
   [[ $(cd -P -- "$prefix/libexec/agent-sessions/host/current" && pwd) != "$release" ]] ||
   [[ ! -L "$prefix/bin/agent-sessions" ]] || [[ ! -L "$prefix/bin/agent-sessions-hub" ]] ||
   [[ $(readlink -- "$prefix/bin/agent-sessions-hub") != "$hub_binary" ]]; then
  printf 'pre-managed rollback did not restore only the prior host/service\n' >&2
  cat "$test_root/pre-managed.out" >&2
  cat "$test_root/pre-managed.err" >&2
  cat "$test_root/qwen-uninstall-record" >&2
  exit 1
fi
while IFS= read -r alias; do
  if [[ -e "$prefix/bin/$alias" || -L "$prefix/bin/$alias" ]]; then
    printf 'pre-managed rollback left unsupported alias %s\n' "$alias" >&2
    exit 1
  fi
done < <("$root/scripts/release-inventory" host-aliases)
if [[ -e "$home/.config/opencode/plugins/agent-sessions.js" ]] ||
   [[ -e "$home/.config/kilo/plugins/agent-sessions.js" ]] ||
   ! env "${common_env[@]}" "$prefix/bin/agent-sessions" status >/dev/null 2>&1; then
  printf 'pre-managed rollback restored new integrations or left its prior service unavailable\n' >&2
  exit 1
fi

: >"$test_root/dsh-record"
if ! env "${common_env[@]}" TEST_DSH_VERSION='dsh 0.1.2-rc.1' "$root/scripts/install-host" \
  "$root" "$candidate" "$prefix" 0.3.0 linux-x64 \
  >"$test_root/incompatible-dsh.out" 2>"$test_root/incompatible-dsh.err"; then
  cat "$test_root/incompatible-dsh.out" >&2
  cat "$test_root/incompatible-dsh.err" >&2
  printf 'an incompatible optional DSH aborted the host install\n' >&2
  exit 1
fi
if ! grep -Fq 'Skipping DSH lane integration: DSH version is incompatible; require exact 0.1.2-alpha.5.' \
    "$test_root/incompatible-dsh.out" ||
   ! grep -Fxq -- '--version' "$test_root/dsh-record" ||
   grep -Fvxq -- '--version' "$test_root/dsh-record"; then
  printf 'an incompatible optional DSH was not skipped before profile mutation\n' >&2
  cat "$test_root/incompatible-dsh.out" >&2
  cat "$test_root/dsh-record" >&2
  exit 1
fi
printf 'host install transaction rollback: PASS\n'
