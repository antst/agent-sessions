#!/usr/bin/env bash
set -euo pipefail

root=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$root/codex-mcp"
scratch=$(mktemp -d "${TMPDIR:-/tmp}/agentbus-codex-mcp.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT
record="$scratch/record"
state="$scratch/state"
codex="$scratch/codex"
peer="$scratch/codex-peer"

cat >"$codex" <<'EOF'
#!/bin/sh
set -eu
printf '%s\n' "$*" >>"$TEST_CODEX_RECORD"
case "$1 $2" in
  "mcp remove")
    [ "${TEST_CODEX_FAIL_REMOVE:-0}" = 0 ] || exit 43
    rm -f -- "$TEST_CODEX_STATE"
    ;;
  "mcp add")
    [ "${TEST_CODEX_FAIL_ADD:-0}" = 0 ] || exit 42
    if [ "$*" = "mcp add --env AGENTBUS_GROUPS=[] agent_sessions -- $TEST_CODEX_PEER mcp" ]; then
      printf '%s\n' 'groups=[]' >"$TEST_CODEX_STATE"
    elif [ "$*" = "mcp add --env AGENTBUS_SOCKET=/tmp/agentbus-test.sock --env AGENTBUS_GROUPS=[\"team\"] agent_sessions -- $TEST_CODEX_PEER mcp" ]; then
      printf '%s\n' 'socket=/tmp/agentbus-test.sock groups=["team"]' >"$TEST_CODEX_STATE"
    else
      exit 91
    fi
    ;;
  "app-server daemon") [ "$*" = "app-server daemon restart" ] || exit 92 ;;
  *) exit 93 ;;
esac
EOF
chmod 0700 "$codex"
: >"$peer"
chmod 0700 "$peer"
export TEST_CODEX_RECORD="$record" TEST_CODEX_STATE="$state" TEST_CODEX_PEER="$peer"

for prior in disabled plugin-backed; do
  printf '%s\n' "$prior" >"$state"
  : >"$record"
  install_codex_mcp "$codex" "$peer"
  grep -Fxq 'mcp remove agent_sessions' "$record"
  grep -Fxq "mcp add --env AGENTBUS_GROUPS=[] agent_sessions -- $peer mcp" "$record"
  grep -Fxq 'app-server daemon restart' "$record"
  [[ $(cat "$state") = 'groups=[]' ]]
done

: >"$record"
export AGENTBUS_SOCKET=/tmp/agentbus-test.sock
install_codex_mcp "$codex" "$peer" '["team"]'
grep -Fxq "mcp add --env AGENTBUS_SOCKET=/tmp/agentbus-test.sock --env AGENTBUS_GROUPS=[\"team\"] agent_sessions -- $peer mcp" "$record"
[[ $(grep -Fxc 'app-server daemon restart' "$record") -eq 1 && $(cat "$state") = 'socket=/tmp/agentbus-test.sock groups=["team"]' ]]
unset AGENTBUS_SOCKET

rm -f -- "$state"
: >"$record"
remove_codex_mcp "$codex"
grep -Fxq 'mcp remove agent_sessions' "$record"
grep -Fxq 'app-server daemon restart' "$record"

: >"$record"
export TEST_CODEX_FAIL_REMOVE=1
if remove_codex_mcp "$codex"; then exit 1; else status=$?; fi
unset TEST_CODEX_FAIL_REMOVE
[[ $status -eq 43 && $(grep -Fc 'app-server daemon restart' "$record") -eq 0 ]]

printf '%s\n' current >"$state"
: >"$record"
export TEST_CODEX_FAIL_ADD=1
if install_codex_mcp "$codex" "$peer"; then exit 1; else status=$?; fi
unset TEST_CODEX_FAIL_ADD
[[ $status -eq 42 && $(grep -Fc 'app-server daemon restart' "$record") -eq 0 && ! -e "$state" ]]
printf '%s\n' 'Codex MCP install transaction: PASS'
