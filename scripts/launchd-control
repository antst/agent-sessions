#!/usr/bin/env bash

# Exact-label launchd replacement primitives shared by host and hub
# installers/removers. launchctl can return EIO while a previous user agent is
# still leaving its domain; retry only that exact label and prove the observed
# state transition instead of hiding bootout errors.

launchd_bootout_exact() {
  local target=$1 output="" attempt wait_attempt
  if ! launchctl print "$target" >/dev/null 2>&1; then
    return 0
  fi
  for ((attempt = 1; attempt <= 10; attempt++)); do
    if output=$(launchctl bootout "$target" 2>&1); then
      for ((wait_attempt = 1; wait_attempt <= 20; wait_attempt++)); do
        if ! launchctl print "$target" >/dev/null 2>&1; then
          return 0
        fi
        sleep 0.1
      done
    fi
    sleep 0.1
  done
  printf 'launchd bootout failed for %s: %s\n' "$target" "$output" >&2
  return 1
}

launchd_bootstrap_exact() {
  local domain=$1 target=$2 plist=$3 output="" attempt
  if launchctl print "$target" >/dev/null 2>&1; then
    printf 'launchd target is still loaded before bootstrap: %s\n' "$target" >&2
    return 1
  fi
  for ((attempt = 1; attempt <= 10; attempt++)); do
    if output=$(launchctl bootstrap "$domain" "$plist" 2>&1); then
      return 0
    fi
    # launchctl may report EIO after accepting the job. Its authoritative
    # domain inventory wins over the command's lossy diagnostic in that case.
    if launchctl print "$target" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  printf 'launchd bootstrap failed for %s: %s\n' "$target" "$output" >&2
  return 1
}

launchd_xml_sed_replacement() {
  local value=$1
  if [[ "$value" == *$'\n'* || "$value" == *$'\r'* ]]; then
    printf 'launchd plist value contains a line break\n' >&2
    return 1
  fi
  printf '%s' "$value" |
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' |
    sed -e 's/[\\&|]/\\&/g'
}

launchd_render_host_plist() {
  if [[ $# -ne 10 ]]; then
    printf 'launchd host plist renderer requires template, output, and eight values\n' >&2
    return 2
  fi
  local template=$1 output=$2 prefix=$3 state_root=$4 home=$5 service_path=$6
  local codex=$7 claude=$8 grok=$9 qwen=${10}
  local prefix_value state_root_value home_value service_path_value
  local codex_value claude_value grok_value qwen_value
  prefix_value=$(launchd_xml_sed_replacement "$prefix")
  state_root_value=$(launchd_xml_sed_replacement "$state_root")
  home_value=$(launchd_xml_sed_replacement "$home")
  service_path_value=$(launchd_xml_sed_replacement "$service_path")
  codex_value=$(launchd_xml_sed_replacement "$codex")
  claude_value=$(launchd_xml_sed_replacement "$claude")
  grok_value=$(launchd_xml_sed_replacement "$grok")
  qwen_value=$(launchd_xml_sed_replacement "$qwen")
  sed -e "s|@PREFIX@|$prefix_value|g" -e "s|@STATE_ROOT@|$state_root_value|g" \
    -e "s|@HOME@|$home_value|g" -e "s|@SERVICE_PATH@|$service_path_value|g" \
    -e "s|@CODEX_BIN@|$codex_value|g" -e "s|@CLAUDE_BIN@|$claude_value|g" \
    -e "s|@GROK_BIN@|$grok_value|g" -e "s|@QWEN_BIN@|$qwen_value|g" \
    "$template" >"$output"
}

launchd_render_hub_plist() {
  if [[ $# -ne 5 ]]; then
    printf 'launchd hub plist renderer requires template, output, prefix, home, and service path\n' >&2
    return 2
  fi
  local template=$1 output=$2 prefix=$3 home=$4 service_path=$5
  local prefix_value home_value service_path_value
  prefix_value=$(launchd_xml_sed_replacement "$prefix")
  home_value=$(launchd_xml_sed_replacement "$home")
  service_path_value=$(launchd_xml_sed_replacement "$service_path")
  sed -e "s|@PREFIX@|$prefix_value|g" -e "s|@HOME@|$home_value|g" \
    -e "s|@SERVICE_PATH@|$service_path_value|g" "$template" >"$output"
}
