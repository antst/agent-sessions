#!/usr/bin/env python3
"""Real managed-Qwen interactive and messaging acceptance runner.

The caller supplies an authenticated, test-owned Qwen profile.  The runner
never copies credentials and never falls back to the default profile.
"""

from __future__ import annotations

import json
import hashlib
import os
import pathlib
import platform
import queue
import shlex
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid


TIMEOUT = 120.0


def fail(message: str) -> None:
    raise AssertionError(message)


def wait_for(predicate, description: str, timeout: float = TIMEOUT):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        try:
            result = predicate()
            if result:
                return result
        except Exception as error:  # retain the final transient diagnostic
            last = error
        time.sleep(0.05)
    fail(f"timed out waiting for {description}; last={last}")


class Managed:
    def __init__(self, argv: list[str], environment: dict[str, str], log: pathlib.Path,
                 stdin: bool = False, stdout: bool = False):
        self.log = log.open("ab", buffering=0)
        self.process = subprocess.Popen(
            argv,
            env=environment,
            stdin=subprocess.PIPE if stdin else subprocess.DEVNULL,
            stdout=subprocess.PIPE if stdout else self.log,
            stderr=self.log,
            start_new_session=True,
        )

    def stop(self) -> None:
        if self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait(timeout=5)
        self.log.close()


class Fixture(Managed):
    def __init__(self, binary: pathlib.Path, runtime: pathlib.Path,
                 environment: dict[str, str], log: pathlib.Path):
        self.session_id = str(uuid.uuid4())
        super().__init__([
            str(binary), "--runtime-dir", str(runtime), "--session", self.session_id,
            "--product", "codex", "--name", "qwen-contract-fixture",
            "--groups", "qwen-contract",
        ], environment, log, stdin=True, stdout=True)
        self.events: queue.Queue[dict] = queue.Queue()
        self.pending: list[dict] = []
        threading.Thread(target=self._read, daemon=True).start()
        self.wait_event(lambda row: row.get("event") == "ready", "fixture readiness")

    def _read(self) -> None:
        assert self.process.stdout is not None
        for line in self.process.stdout:
            try:
                self.events.put(json.loads(line))
            except Exception as error:
                self.events.put({"event": "decode_error", "error": str(error),
                                 "line": line.decode(errors="replace")})

    def wait_event(self, predicate, description: str, timeout: float = TIMEOUT):
        for index, row in enumerate(self.pending):
            if predicate(row):
                return self.pending.pop(index)
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                row = self.events.get(timeout=min(0.2, deadline - time.monotonic()))
            except queue.Empty:
                if self.process.poll() is not None:
                    fail(f"{description}: fixture exited {self.process.returncode}")
                continue
            if predicate(row):
                return row
            self.pending.append(row)
        fail(f"timed out waiting for {description}; pending={self.pending}")

    def command(self, kind: str, **fields):
        command_id = str(uuid.uuid4())
        frame = {"version": 1, "type": kind, "message_id": command_id, **fields}
        body = json.dumps({"id": command_id, "frame": frame}, separators=(",", ":")) + "\n"
        assert self.process.stdin is not None
        self.process.stdin.write(body.encode())
        self.process.stdin.flush()
        result = self.wait_event(
            lambda row: row.get("event") == "result" and row.get("id") == command_id,
            f"fixture {kind} result",
        )
        if "error" in result:
            fail(f"fixture {kind} failed: {result}")
        return result["result"]

    def peers(self) -> list[dict]:
        return self.command("discover").get("peers", [])

    def wait_content(self, content: str):
        return self.wait_event(
            lambda row: row.get("event") == "delivery" and
            row.get("frame", {}).get("content") == content,
            f"delivery content {content!r}",
        )["frame"]


class TmuxPeer:
    def __init__(self, tmux: str, server: str, name: str, command: list[str],
                 environment: dict[str, str], root: pathlib.Path):
        self.tmux = tmux
        self.server = server
        self.name = name
        self.log = root / f"{name}.pane.log"
        workspace = root / "workspace"
        workspace.mkdir(mode=0o700, exist_ok=True)
        assignments = [f"{key}={value}" for key, value in sorted(environment.items())]
        shell_command = shlex.join(["env", *assignments, *command])
        subprocess.run([tmux, "-L", server, "new-session", "-d", "-s", name,
                        "-c", str(workspace),
                        "exec " + shell_command], check=True)
        subprocess.run([tmux, "-L", server, "pipe-pane", "-o", "-t", name,
                        f"cat >> {shlex.quote(str(self.log))}"], check=True)

    def alive(self) -> bool:
        return subprocess.run(
            [self.tmux, "-L", self.server, "has-session", "-t", self.name],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0

    def capture(self) -> str:
        if not self.alive():
            return self.log.read_text(errors="replace") if self.log.exists() else ""
        return subprocess.run(
            [self.tmux, "-L", self.server, "capture-pane", "-p", "-J", "-t", self.name,
        ], check=True, text=True, stdout=subprocess.PIPE).stdout

    def key(self, value: str) -> None:
        subprocess.run([self.tmux, "-L", self.server, "send-keys", "-t", self.name, value], check=True)

    def quit(self) -> None:
        if not self.alive():
            return
        self.key("/quit")
        self.key("Enter")
        wait_for(lambda: not self.alive(), f"normal exit of {self.name}", 20)

    def terminate(self) -> None:
        if self.alive():
            subprocess.run([self.tmux, "-L", self.server, "kill-session", "-t", self.name], check=False)


def platform_name() -> str:
    machine = platform.machine()
    value = f"{platform.system().lower()}-{machine}"
    return {
        "linux-x86_64": "linux-x64",
        "linux-aarch64": "linux-arm64",
        "darwin-x86_64": "darwin-x64",
        "darwin-arm64": "darwin-arm64",
    }.get(value, value)


def registration(config: pathlib.Path, data: pathlib.Path, session_id: str) -> dict | None:
    paths = list((config / "sessions").glob("*.json"))
    paths.extend((data / "sessions").glob("*/state.json"))
    for path in paths:
        try:
            row = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if row.get("sessionId") == session_id:
            return row
    return None


def assert_real_socket(row: dict) -> None:
    raw_path = row.get("socketPath") or row.get("socket") or ""
    if not raw_path:
        fail(f"managed Qwen registration omits its delivery socket: {row}")
    path = pathlib.Path(raw_path)
    mode = path.lstat().st_mode
    if stat.S_ISLNK(mode) or not stat.S_ISSOCK(mode):
        fail(f"managed Qwen delivery endpoint is not a real Unix socket: {path}")


def state_snapshot(roots: list[pathlib.Path]) -> dict[str, tuple]:
    snapshot: dict[str, tuple] = {}
    for root in roots:
        if not root.exists():
            continue
        for path in sorted(root.rglob("*")):
            relative = f"{root.name}/{path.relative_to(root)}"
            info = path.lstat()
            if stat.S_ISREG(info.st_mode):
                snapshot[relative] = (
                    "file", stat.S_IMODE(info.st_mode), hashlib.sha256(path.read_bytes()).hexdigest(),
                )
            elif stat.S_ISDIR(info.st_mode):
                snapshot[relative] = ("directory", stat.S_IMODE(info.st_mode))
            elif stat.S_ISLNK(info.st_mode):
                snapshot[relative] = ("symlink", os.readlink(path))
            elif stat.S_ISSOCK(info.st_mode):
                snapshot[relative] = ("socket", stat.S_IMODE(info.st_mode))
            else:
                snapshot[relative] = ("other", stat.S_IFMT(info.st_mode))
    return snapshot


def main() -> int:
    qwen_home_raw = os.environ.get("QWEN_TEST_HOME", "")
    qwen_runtime_raw = os.environ.get("QWEN_TEST_RUNTIME_DIR", "")
    if not qwen_home_raw or not qwen_runtime_raw:
        fail("set QWEN_TEST_HOME and QWEN_TEST_RUNTIME_DIR to test-owned absolute paths")
    qwen_home = pathlib.Path(qwen_home_raw)
    qwen_runtime = pathlib.Path(qwen_runtime_raw)
    if not qwen_home.is_absolute() or not qwen_runtime.is_absolute():
        fail("QWEN_TEST_HOME and QWEN_TEST_RUNTIME_DIR must be absolute")
    if not qwen_home.is_dir() or not qwen_runtime.is_dir():
        fail("QWEN_TEST_HOME and QWEN_TEST_RUNTIME_DIR must already exist")
    tmux = shutil.which("tmux")
    if not tmux:
        fail("tmux is required for the real interactive Qwen contract")

    repo = pathlib.Path(__file__).resolve().parents[1]
    start = time.monotonic()
    temporary_parent = pathlib.Path("/tmp") if platform.system() == "Darwin" else None
    root = pathlib.Path(tempfile.mkdtemp(prefix="qwen-contract.", dir=temporary_parent))
    managed: list[Managed] = []
    tmux_peers: list[TmuxPeer] = []
    tmux_server = f"qwen-contract-{os.getpid()}"
    success = False
    try:
        subprocess.run(["make", "-s", "build"], cwd=repo, check=True)
        binary_root = repo / "bin" / platform_name()
        federator = binary_root / "peer-federator"
        qwen_peer = binary_root / "qwen-peer"
        runtime = root / "agent-runtime"
        state = root / "agent-state"
        config = root / "claude"
        data = root / "data"
        xdg_runtime = root / "xdg-runtime"
        for path in (runtime, state, config, data, xdg_runtime):
            path.mkdir(mode=0o700)
        fixture_binary = root / "grouped-peer-fixture"
        subprocess.run(["go", "build", "-o", fixture_binary,
                        "./scripts/federation/grouped_peer_fixture.go"], cwd=repo, check=True)

        environment = os.environ.copy()
        # This runner is launched from an arbitrary operator shell. Never let
        # that shell's current Agent Sessions/Codex identity attest the Qwen
        # process or the isolated host agent created below.
        for key in (
            "CODEX_SESSION_ID",
            "CODEX_THREAD_ID",
            "AGENT_SESSIONS_SESSION_ID",
            "AGENT_SESSIONS_PRODUCT",
            "AGENT_SESSIONS_QWEN_CAPABILITY",
        ):
            environment.pop(key, None)
        environment.update({
            "PATH": str(binary_root) + os.pathsep + environment.get("PATH", ""),
            "QWEN_HOME": str(qwen_home),
            "QWEN_RUNTIME_DIR": str(qwen_runtime),
            "CLAUDE_PEER_DATA_DIR": str(data),
            "CLAUDE_PEER_CLAUDE_CONFIG_DIR": str(config),
            "CODEX_HOME": str(root / "codex"),
            "XDG_RUNTIME_DIR": str(xdg_runtime),
            "XDG_STATE_HOME": str(root / "xdg-state"),
            "AGENT_SESSIONS_AGENT_RUNTIME_DIR": str(runtime),
            "TERM": "xterm-256color",
        })
        for key in ("CODEX_HOME", "XDG_STATE_HOME"):
            pathlib.Path(environment[key]).mkdir(mode=0o700)

        extension = subprocess.run(
            ["qwen", "extensions", "list"], env=environment, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=True,
        ).stdout
        if "agent-sessions (0.2.4)" not in extension:
            fail("selected Qwen profile does not contain exact Agent Sessions 0.2.4 integration")

        agent = Managed([
            str(federator), "agent", "--host", "qwen-contract", "--name", "qwen-contract",
            "--runtime-dir", str(runtime), "--state-dir", str(state),
            "--claude-config-dir", str(config),
        ], environment, root / "agent.log")
        managed.append(agent)
        wait_for(lambda: (runtime / "agent.sock").is_socket(), "Qwen contract host agent")
        fixture = Fixture(fixture_binary, runtime, environment, root / "fixture.log")
        managed.append(fixture)

        # Conflicting wrapper/native permission choices are rejected before
        # executable resolution, readiness, child creation, or state mutation.
        conflict_marker = root / "conflict-native-executed"
        conflict_qwen = root / "conflict-qwen"
        conflict_qwen.write_text(
            "#!/bin/sh\nprintf executed >" + shlex.quote(str(conflict_marker)) + "\nexit 99\n",
            encoding="utf-8",
        )
        conflict_qwen.chmod(0o700)
        before_conflict = state_snapshot([state, config, data, xdg_runtime])
        conflict_environment = environment.copy()
        conflict_environment["QWEN_PEER_QWEN_BIN"] = str(conflict_qwen)
        conflict = subprocess.run([
            str(qwen_peer), "--runtime-dir", str(runtime), "--state-dir", str(state),
            "--name", "qwen-conflict", "--yolo", "--approval-mode", "plan",
        ], env=conflict_environment, text=True, stdout=subprocess.PIPE,
           stderr=subprocess.STDOUT, timeout=20, check=False)
        if conflict.returncode != 2 or conflict_marker.exists():
            fail(f"Qwen permission conflict crossed the pre-child boundary: {conflict.returncode} {conflict.stdout}")
        if state_snapshot([state, config, data, xdg_runtime]) != before_conflict:
            fail("Qwen permission conflict mutated isolated state")

        # Delegate every session-free readiness probe to the real authenticated
        # Qwen executable, then fail only the managed dual-output child. This
        # proves a post-readiness native authentication failure rolls the
        # preparation and catalog back instead of publishing a partial peer.
        real_qwen = shutil.which("qwen", path=os.environ.get("PATH", ""))
        if not real_qwen:
            fail("real Qwen executable is unavailable for native-authentication rollback")
        auth_marker = root / "native-authentication-failed"
        auth_qwen = root / "auth-fault-qwen"
        auth_qwen.write_text(
            "#!/bin/sh\n"
            "for argument in \"$@\"; do\n"
            "  if [ \"$argument\" = --chat-recording=true ]; then\n"
            "    printf failed >" + shlex.quote(str(auth_marker)) + "\n"
            "    printf 'Qwen native authentication failed after readiness\\n' >&2\n"
            "    exit 1\n"
            "  fi\n"
            "done\n"
            "exec " + shlex.quote(real_qwen) + " \"$@\"\n",
            encoding="utf-8",
        )
        auth_qwen.chmod(0o700)
        before_auth = state_snapshot([state, config, data, xdg_runtime])
        auth_environment = environment.copy()
        auth_environment["QWEN_PEER_QWEN_BIN"] = str(auth_qwen)
        auth_failure = subprocess.run([
            str(qwen_peer), "--runtime-dir", str(runtime), "--state-dir", str(state),
            "--name", "qwen-auth-failure", "--group", "qwen-contract", "--yolo",
            "--prompt-interactive", "This prompt must never run.",
        ], env=auth_environment, text=True, stdout=subprocess.PIPE,
           stderr=subprocess.STDOUT, timeout=TIMEOUT, check=False)
        if auth_failure.returncode == 0 or not auth_marker.exists() or \
                "authentication failed" not in auth_failure.stdout.lower():
            fail(f"post-readiness native authentication fault was not observed: {auth_failure.returncode} {auth_failure.stdout}")
        wait_for(lambda: not any(item.get("name") == "qwen-auth-failure" for item in fixture.peers()),
                 "post-authentication-failure roster rollback")
        wait_for(lambda: state_snapshot([state, config, data, xdg_runtime]) == before_auth,
                 "post-authentication-failure exact state rollback", 20)

        prompt = (
            "Use only the agent_sessions MCP tools. Discover the unique peer named "
            "qwen-contract-fixture, send it content exactly QWEN_DIRECT_FROM_QWEN, then "
            "broadcast content exactly QWEN_BROADCAST_FROM_QWEN to group qwen-contract. "
            "When an Agent Sessions delivery asks for a reply, reply to its exact source "
            "with the exact requested content. Do not exit the interactive session."
        )
        peer = TmuxPeer(tmux, tmux_server, "qwen-main", [
            str(qwen_peer), "--runtime-dir", str(runtime), "--state-dir", str(state),
            "--name", "qwen-live", "--group", "qwen-contract", "--yolo",
            "--prompt-interactive", prompt,
        ], environment, root)
        tmux_peers.append(peer)

        discovered = wait_for(
            lambda: next((item for item in fixture.peers() if item.get("name") == "qwen-live"), None),
            "managed Qwen discovery",
        )
        session_id = discovered["session_id"]
        row = wait_for(lambda: registration(config, data, session_id), "managed Qwen registration")
        assert_real_socket(row)
        fixture.wait_content("QWEN_DIRECT_FROM_QWEN")
        fixture.wait_content("QWEN_BROADCAST_FROM_QWEN")

        sent = fixture.command(
            "send", targets=["qwen-live"],
            content="Reply to my exact source with content exactly QWEN_REPLY_TO_FIXTURE.",
        )
        if sent.get("deliveries", [{}])[0].get("status") != "accepted":
            fail(f"fixture-to-Qwen delivery was not accepted: {sent}")
        reply = fixture.wait_content("QWEN_REPLY_TO_FIXTURE")
        if reply.get("source", {}).get("session_id") != session_id:
            fail(f"Qwen reply source changed: {reply}")

        # The selected plugin may be visible to bare Qwen, but exact process
        # attestation must keep its structured tools inactive. Exercise the MCP
        # server directly so this security assertion does not depend on a
        # language model choosing a tool or completing within a network budget.
        bare_environment = environment.copy()
        bare_environment["AGENT_SESSIONS_PRODUCT"] = "qwen"
        bare_requests = "\n".join((
            json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                        "params": {"protocolVersion": "2025-06-18"}}),
            json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                        "params": {"name": "list_peers", "arguments": {}}}),
            "",
        ))
        bare = subprocess.run(
            [str(binary_root / "agent-session-runtime"), "mcp"],
            env=bare_environment, input=bare_requests, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20, check=True,
        )
        bare_responses = [json.loads(line) for line in bare.stdout.splitlines() if line.strip()]
        if len(bare_responses) != 2 or \
                "inactive outside an attested peer session" not in json.dumps(bare_responses[1]):
            fail(f"bare Qwen did not report inactive Agent Sessions authority: {bare.stdout} {bare.stderr}")
        live_names = {item.get("name") for item in fixture.peers()}
        if live_names != {"qwen-live"}:
            fail(f"bare Qwen altered the managed peer roster: {live_names}")

        # Exercise Qwen's native mutable permission UI. Agent Sessions records
        # the launch request but deliberately does not lock or rewrite the live
        # native mode.
        before = peer.capture()
        peer.key("BTab")

        def changed_qwen_capture():
            current = peer.capture()
            return current if current != before else None

        wait_for(changed_qwen_capture, "visible Qwen Shift+Tab approval-mode change")

        peer.quit()
        wait_for(lambda: registration(config, data, session_id) is None, "normal Qwen cleanup")

        resume = TmuxPeer(tmux, tmux_server, "qwen-resume", [
            str(qwen_peer), "--runtime-dir", str(runtime), "--state-dir", str(state),
            "--resume", "qwen-live", "--yolo", "--prompt-interactive",
            "Send content exactly QWEN_RESUMED_SAME_TRANSCRIPT to qwen-contract-fixture "
            "using agent_sessions.send_message, then remain interactive.",
        ], environment, root)
        tmux_peers.append(resume)
        fixture.wait_content("QWEN_RESUMED_SAME_TRANSCRIPT")
        resumed = wait_for(
            lambda: next((item for item in fixture.peers() if item.get("name") == "qwen-live"), None),
            "resumed Qwen discovery",
        )
        if resumed.get("session_id") != session_id:
            fail(f"Qwen resume changed native transcript identity: {resumed}")
        assert_real_socket(wait_for(lambda: registration(config, data, session_id), "resumed registration"))
        resume.quit()
        wait_for(lambda: registration(config, data, session_id) is None, "resumed Qwen cleanup")

        # All four launch contracts must reach native admission. The main cell
        # covered --yolo; use one short interactive turn for the remaining
        # native-default, exact --no-yolo, and pass-through plan contracts.
        for label, options in (
            ("default", []),
            ("non-yolo", ["--no-yolo"]),
            ("plan", ["--approval-mode", "plan"]),
        ):
            mode_peer = TmuxPeer(tmux, tmux_server, f"qwen-{label}", [
                str(qwen_peer), "--runtime-dir", str(runtime), "--state-dir", str(state),
                "--name", f"qwen-{label}", "--group", "qwen-contract", *options,
                "--prompt-interactive", f"Return only QWEN_MODE_{label.upper().replace('-', '_')}_OK.",
            ], environment, root)
            tmux_peers.append(mode_peer)
            mode_row = wait_for(
                lambda label=label: next((item for item in fixture.peers()
                                           if item.get("name") == f"qwen-{label}"), None),
                f"{label} Qwen publication",
            )
            assert_real_socket(wait_for(
                lambda mode_row=mode_row: registration(config, data, mode_row["session_id"]),
                f"{label} Qwen real socket",
            ))
            wait_for(lambda mode_peer=mode_peer, label=label:
                     f"QWEN_MODE_{label.upper().replace('-', '_')}_OK" in mode_peer.capture(),
                     f"{label} Qwen response")
            mode_peer.quit()
            wait_for(lambda mode_row=mode_row: registration(config, data, mode_row["session_id"]) is None,
                     f"{label} Qwen cleanup")

        elapsed = time.monotonic() - start
        if elapsed >= 300:
            fail(f"documented Qwen workflow took {elapsed:.3f}s, want under 300s")
        success = True
        print(json.dumps({
            "type": "qwen.contract.passed", "elapsed_seconds": round(elapsed, 3),
            "session_id": session_id, "delivery_socket_type": "unix",
            "hub_round_trips": 0,
        }, sort_keys=True))
        return 0
    finally:
        for peer in reversed(tmux_peers):
            peer.terminate()
        subprocess.run([tmux, "-L", tmux_server, "kill-server"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for process in reversed(managed):
            process.stop()
        if not success:
            for path in sorted(root.glob("*.log")):
                if path.exists() and path.stat().st_size:
                    print(f"===== {path.name} =====", file=sys.stderr)
                    print(path.read_text(errors="replace"), file=sys.stderr)
        shutil.rmtree(root)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (AssertionError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
        print(f"Qwen interactive contract: FAIL: {error}", file=sys.stderr)
        raise SystemExit(1)
