#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$root/scripts/managed-tree"
temporary_parent="${TMPDIR:-/tmp}"
if [[ "$(uname -s)" == Darwin ]]; then temporary_parent=/tmp; fi
temporary_parent="$(cd -P -- "$temporary_parent" && pwd)"
test_root="$(mktemp -d "$temporary_parent/agent-sessions-removal.XXXXXX")"
cleanup() {
  if [[ -f "$test_root/service.pid" ]]; then
    pid=$(cat "$test_root/service.pid" 2>/dev/null || true)
    if [[ "$pid" =~ ^[0-9]+$ ]]; then
      kill "$pid" >/dev/null 2>&1 || true
      for _ in {1..100}; do
        if ! kill -0 "$pid" >/dev/null 2>&1; then break; fi
        sleep 0.01
      done
    fi
  fi
  if [[ -d "$test_root" ]]; then
    find -P "$test_root" -type d -exec chmod u+rwx {} + 2>/dev/null || true
  fi
  rm -rf -- "$test_root"
}
trap cleanup EXIT

guard_parent="$test_root/managed-tree-guard"
guard_tree="$guard_parent/release"
guard_external="$test_root/external-canary"
mkdir -p "$guard_tree" "$guard_external"
printf 'must survive\n' >"$guard_external/canary"
ln -s "$guard_external" "$guard_tree/indirect"
set +e
remove_managed_tree "$guard_tree" "$guard_parent" \
  >"$test_root/managed-tree.out" 2>"$test_root/managed-tree.err"
guard_status=$?
set -e
if [[ $guard_status -eq 0 ]] ||
   ! grep -Fq 'containing a symbolic link' "$test_root/managed-tree.err" ||
   [[ ! -L "$guard_tree/indirect" ]] || [[ ! -f "$guard_external/canary" ]]; then
  printf 'managed-tree removal did not fail closed around an indirect child\n' >&2
  exit 1
fi
rm -f -- "$guard_tree/indirect"
remove_managed_tree "$guard_tree" "$guard_parent"
[[ -f "$guard_external/canary" ]]

host_binary="${AGENT_SESSIONS_TEST_HOST_BINARY:-$test_root/agent-sessions}"
hub_binary="${AGENT_SESSIONS_TEST_HUB_BINARY:-$test_root/agent-sessions-hub}"
if [[ -z "${AGENT_SESSIONS_TEST_HOST_BINARY:-}" ]]; then
  go build -o "$host_binary" "$root/cmd/agent-sessions"
fi
if [[ -z "${AGENT_SESSIONS_TEST_HUB_BINARY:-}" ]]; then
  go build -o "$hub_binary" "$root/cmd/agent-sessions-hub"
fi

home="$test_root/home"
prefix="$test_root/prefix"
fake_bin="$test_root/bin"
state_root="$test_root/unified-state"
mkdir -p "$home" "$prefix" "$fake_bin" "$state_root"

cat >"$fake_bin/uname" <<'EOF'
#!/bin/sh
printf '%s\n' Linux
EOF

cat >"$fake_bin/qwen" <<'EOF'
#!/bin/sh
set -eu
case "$1 $2" in
  "extensions list")
    if [ -s "$TEST_QWEN_STATE" ]; then printf '%s\n' 'agent-sessions enabled'; fi
    ;;
  "extensions uninstall")
    if [ "${TEST_QWEN_REMOVE_FAIL_ONCE:-0}" = 1 ] && [ ! -e "$TEST_QWEN_REMOVE_MARKER" ]; then
      : >"$TEST_QWEN_REMOVE_MARKER"
      exit 45
    fi
    rm -f -- "$TEST_QWEN_STATE"
    ;;
  "extensions install") printf '%s\n' "$3" >"$TEST_QWEN_STATE" ;;
  *) exit 91 ;;
esac
EOF

cat >"$fake_bin/opencode" <<'EOF'
#!/bin/sh
exit 0
EOF

cat >"$fake_bin/kilo" <<'EOF'
#!/bin/sh
exit 0
EOF

cat >"$fake_bin/dsh" <<'EOF'
#!/bin/sh
exit 0
EOF

cat >"$fake_bin/pnpm" <<'EOF'
#!/bin/sh
set -eu
if [ "${1:-}" = --version ]; then
  printf '%s\n' 10.28.1
  exit 0
fi
profile=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = --dir ]; then
    profile=$2
    shift 2
  else
    shift
  fi
done
[ -n "$profile" ] || exit 91
mkdir -p "$profile/node_modules/@agent-sessions"
ln -sfn ../../agent-sessions-plugin "$profile/node_modules/@agent-sessions/dsh-plugin"
EOF

cat >"$fake_bin/grok" <<'EOF'
#!/bin/sh
set -eu
printf '%s\n' "$*" >>"$TEST_GROK_LOG"
if [ "$1" = "--version" ]; then
  printf '%s\n' 'grok 1.0.13'
  exit 0
fi
if [ "$1" = "--no-auto-update" ] && [ "$2" = "--help" ]; then
  printf '%s\n' 'Grok Build TUI' 'Usage: grok [OPTIONS]' '--leader-socket <PATH>' 'Commands:' '  agent' '  leader'
  exit 0
fi
if [ "$1 $2" = "plugin list" ]; then
  if [ -e "$TEST_GROK_STATE" ]; then printf '%s\n' '[{"name":"agent-sessions"}]'; else printf '%s\n' '[]'; fi
  exit 0
fi
if [ "$1 $2" = "plugin validate" ]; then exit 0; fi
if [ "$1 $2" = "plugin install" ]; then
  source_root=$3
  if [ -d "$TEST_GROK_PLUGIN_ROOT" ]; then
    find -P "$TEST_GROK_PLUGIN_ROOT" -type d -exec chmod u+rwx {} +
    rm -rf -- "$TEST_GROK_PLUGIN_ROOT"
  fi
  mkdir -p "$TEST_GROK_PLUGIN_ROOT"
  cp -R -- "$source_root/." "$TEST_GROK_PLUGIN_ROOT/"
  : >"$TEST_GROK_STATE"
  exit 0
fi
if [ "$1 $2" = "plugin uninstall" ]; then
  rm -f -- "$TEST_GROK_STATE"
  if [ "${4:-}" != "--keep-data" ] && [ -d "$TEST_GROK_PLUGIN_ROOT" ]; then
    find -P "$TEST_GROK_PLUGIN_ROOT" -type d -exec chmod u+rwx {} +
    rm -rf -- "$TEST_GROK_PLUGIN_ROOT"
  fi
  exit 0
fi
exit 91
EOF

cat >"$fake_bin/systemctl" <<'EOF'
#!/bin/sh
set -eu
arguments=" $* "
stop_service() {
  if [ -f "$TEST_SERVICE_PID_FILE" ]; then
    pid=$(cat "$TEST_SERVICE_PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ]; then
      kill "$pid" >/dev/null 2>&1 || true
      i=0
      while kill -0 "$pid" >/dev/null 2>&1 && [ "$i" -lt 100 ]; do
        i=$((i + 1)); sleep 0.01
      done
    fi
    rm -f -- "$TEST_SERVICE_PID_FILE"
  fi
}
case "$arguments" in
  *" stop agent-sessions.service "*|*" disable --now agent-sessions.service "*) stop_service ;;
  *" restart agent-sessions.service "*)
    stop_service
    AGENT_SESSIONS_STATE_ROOT="$AGENT_SESSIONS_STATE_ROOT" \
      "$TEST_PREFIX/bin/agent-sessions" daemon >"$TEST_SERVICE_LOG" 2>&1 &
    printf '%s\n' "$!" >"$TEST_SERVICE_PID_FILE"
    ;;
esac
exit 0
EOF
chmod 0700 "$fake_bin/uname" "$fake_bin/qwen" "$fake_bin/grok" "$fake_bin/opencode" "$fake_bin/kilo" "$fake_bin/dsh" "$fake_bin/pnpm" "$fake_bin/systemctl"

common_env=(
  "HOME=$home"
  "XDG_CONFIG_HOME=$home/.config"
  "AGENT_SESSIONS_STATE_ROOT=$state_root"
  "PATH=$fake_bin:/usr/bin:/bin"
  "CODEX=missing-codex"
  "CLAUDE=missing-claude"
  "GROK=grok"
  "QWEN=qwen"
  "OPENCODE=opencode"
  "KILO=kilo"
  "DSH=dsh"
  "PNPM=pnpm"
  "TEST_PREFIX=$prefix"
  "TEST_QWEN_STATE=$test_root/qwen-source"
  "TEST_QWEN_REMOVE_MARKER=$test_root/qwen-remove-failed"
  "TEST_GROK_STATE=$test_root/grok-installed"
  "TEST_GROK_PLUGIN_ROOT=$home/.grok/plugins/agent-sessions"
  "TEST_GROK_LOG=$test_root/grok.log"
  "TEST_SERVICE_PID_FILE=$test_root/service.pid"
  "TEST_SERVICE_LOG=$test_root/service.log"
)

install_host() {
  env "${common_env[@]}" "$root/scripts/install-host" \
    "$root" "$host_binary" "$prefix" 0.3.0 linux-x64 >/dev/null
}

install_host
release="$prefix/libexec/agent-sessions/host/releases/0.3.0"
cmp -- "$home/.config/opencode/plugins/agent-sessions.js" "$release/integrations/opencode/agent-sessions.mjs"
cmp -- "$home/.config/opencode/shared/live-session.js" "$release/integrations/shared/live-session.js"
cmp -- "$home/.config/kilo/plugins/agent-sessions.js" "$release/integrations/kilo/agent-sessions.mjs"
cmp -- "$home/.config/kilo/shared/live-session.js" "$release/integrations/shared/live-session.js"
dsh_profile="$home/.dsh/profiles/agent-sessions"
cmp -- "$dsh_profile/package.json" "$release/integrations/dsh/profile/package.json"
cmp -- "$dsh_profile/agent-sessions-plugin/plugin.cjs" "$release/integrations/dsh/plugin.cjs"
cmp -- "$dsh_profile/shared/live-session.js" "$release/integrations/shared/live-session.js"
[[ "$(cd -P -- "$dsh_profile/node_modules/@agent-sessions/dsh-plugin" && pwd)" == "$dsh_profile/agent-sessions-plugin" ]]
find -P "$release" -type d -exec chmod 0555 {} +
printf 'unified-state-canary\n' >"$state_root/canary"
printf 'unified-config-canary\n' >"$home/.config/agent-sessions/preserved"
mkdir -p "$home/.qwen" "$prefix/libexec/agent-sessions/hub"
printf 'vendor-profile-canary\n' >"$home/.qwen/vendor-canary"
printf 'hub-canary\n' >"$prefix/libexec/agent-sessions/hub/preserved"

set +e
env "${common_env[@]}" TEST_QWEN_REMOVE_FAIL_ONCE=1 \
  "$root/scripts/remove-host" "$prefix" >"$test_root/remove-fail.out" 2>"$test_root/remove-fail.err"
failed_status=$?
set -e
if [[ $failed_status -eq 0 ]] ||
   ! grep -Fq 'restored the installed integrations and service' "$test_root/remove-fail.err" ||
   [[ ! -x "$release/bin/agent-sessions" ]] ||
   [[ "$(cat "$test_root/qwen-source")" != "$release/qwen" ]] ||
   [[ ! -f "$test_root/grok-installed" ]] ||
   [[ ! -f "$home/.grok/plugins/agent-sessions/.grok-plugin/plugin.json" ]] ||
   ! cmp -- "$home/.config/opencode/plugins/agent-sessions.js" "$release/integrations/opencode/agent-sessions.mjs" >/dev/null ||
   ! cmp -- "$home/.config/opencode/shared/live-session.js" "$release/integrations/shared/live-session.js" >/dev/null ||
   ! cmp -- "$home/.config/kilo/plugins/agent-sessions.js" "$release/integrations/kilo/agent-sessions.mjs" >/dev/null ||
   ! cmp -- "$home/.config/kilo/shared/live-session.js" "$release/integrations/shared/live-session.js" >/dev/null ||
   ! cmp -- "$dsh_profile/package.json" "$release/integrations/dsh/profile/package.json" >/dev/null ||
   ! cmp -- "$dsh_profile/agent-sessions-plugin/plugin.cjs" "$release/integrations/dsh/plugin.cjs" >/dev/null ||
   ! cmp -- "$dsh_profile/shared/live-session.js" "$release/integrations/shared/live-session.js" >/dev/null; then
  printf 'failed removal did not restore the installed host transaction\n' >&2
  exit 1
fi
env "${common_env[@]}" "$prefix/bin/agent-sessions" status >/dev/null

env "${common_env[@]}" "$root/scripts/remove-host" "$prefix" >/dev/null
if [[ -e "$prefix/libexec/agent-sessions/host" ]] ||
   [[ -e "$prefix/bin/agent-sessions" || -L "$prefix/bin/agent-sessions" ]] ||
   [[ -e "$test_root/qwen-source" ]] ||
   [[ -e "$test_root/grok-installed" ]] ||
   [[ -e "$home/.grok/plugins/agent-sessions" ]] ||
   [[ -e "$home/.config/opencode/plugins/agent-sessions.js" || -L "$home/.config/opencode/plugins/agent-sessions.js" ]] ||
   [[ -e "$home/.config/opencode/shared/live-session.js" || -L "$home/.config/opencode/shared/live-session.js" ]] ||
   [[ -e "$home/.config/kilo/plugins/agent-sessions.js" || -L "$home/.config/kilo/plugins/agent-sessions.js" ]] ||
   [[ -e "$home/.config/kilo/shared/live-session.js" || -L "$home/.config/kilo/shared/live-session.js" ]] ||
   [[ -e "$dsh_profile" || -L "$dsh_profile" ]] ||
   [[ ! -f "$state_root/canary" ]] ||
   [[ ! -f "$home/.config/agent-sessions/preserved" ]] ||
   [[ ! -f "$home/.qwen/vendor-canary" ]] ||
   [[ ! -f "$prefix/libexec/agent-sessions/hub/preserved" ]]; then
  if [[ -f "$test_root/grok.log" ]]; then
    printf '%s\n' '--- isolated Grok command log ---' >&2
    sed -n '1,160p' "$test_root/grok.log" >&2
  fi
  find "$home/.grok/plugins/agent-sessions" -maxdepth 3 -print >&2 2>/dev/null || true
  printf 'default host removal did not preserve exact non-owned and unified-state boundaries\n' >&2
  exit 1
fi

install_host
printf 'purge-state\n' >"$state_root/purge-canary"
printf 'purge-config\n' >"$home/.config/agent-sessions/purge-canary"
env "${common_env[@]}" "$root/scripts/remove-host" "$prefix" --purge >/dev/null
if [[ -e "$state_root" ]] || [[ -e "$home/.config/agent-sessions" ]] ||
   [[ ! -f "$home/.qwen/vendor-canary" ]] ||
   [[ ! -f "$prefix/libexec/agent-sessions/hub/preserved" ]]; then
  printf 'explicit purge did not remove only unified state and config\n' >&2
  exit 1
fi

env "${common_env[@]}" "$root/scripts/install-hub" \
  "$root" "$hub_binary" "$prefix" 0.3.0 linux-x64 >/dev/null
hub_release="$prefix/libexec/agent-sessions/hub/releases/0.3.0"
find -P "$hub_release" -type d -exec chmod 0555 {} +
mkdir -p "$prefix/libexec/agent-sessions/host"
printf 'host-canary\n' >"$prefix/libexec/agent-sessions/host/preserved"
env "${common_env[@]}" "$root/scripts/remove-hub" "$prefix" >/dev/null
if [[ -e "$prefix/libexec/agent-sessions/hub" ]] ||
   [[ -e "$prefix/bin/agent-sessions-hub" || -L "$prefix/bin/agent-sessions-hub" ]] ||
   [[ ! -f "$prefix/libexec/agent-sessions/host/preserved" ]]; then
  printf 'hub removal did not preserve the independent host root\n' >&2
  exit 1
fi
printf 'host and hub removal transactions: PASS\n'
