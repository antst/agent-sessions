<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.antst.agent-sessions</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PREFIX@/libexec/agent-sessions/host/current/bin/agent-sessions</string>
    <string>daemon</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@STATE_ROOT@/logs/agent-sessions.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@STATE_ROOT@/logs/agent-sessions.stderr.log</string>
</dict>
</plist>
