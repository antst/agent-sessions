<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.antst.peer-federator.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/.local/bin/peer-federator</string>
    <string>agent</string>
    <string>--hub</string><string>10.2.17.1:7419</string>
    <string>--host</string><string>workstation-a</string>
    <string>--name</string><string>workstation-a</string>
    <!-- Add the enable-remote-lanes command-line flag only when every host on the hub is
         trusted to execute native lane commands as this user. -->
  </array>
  <!-- Optional exact Qwen profile/launcher. Omit these keys for Qwen's native
       default profile; if supplied, paths must be absolute and non-symlinked. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PEER_FEDERATOR_QWEN_LANE</key><string>/Users/CHANGE_ME/.local/bin/qwen-peer-lane</string>
    <key>QWEN_PEER_QWEN_BIN</key><string>/Users/CHANGE_ME/.local/bin/qwen</string>
    <key>QWEN_HOME</key><string>/Users/CHANGE_ME/.qwen</string>
    <key>QWEN_RUNTIME_DIR</key><string>/Users/CHANGE_ME/Library/Caches/qwen</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/peer-federator-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/peer-federator-agent.log</string>
</dict>
</plist>
