<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>net.antst.peer-federator.hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/CHANGE_ME/.local/bin/peer-federator</string>
    <string>hub</string>
    <string>--listen</string><string>:7419</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/peer-federator-hub.log</string>
  <key>StandardErrorPath</key><string>/tmp/peer-federator-hub.log</string>
</dict>
</plist>
