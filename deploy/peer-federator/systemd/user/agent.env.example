PEER_FEDERATOR_HUB=10.2.17.1:7419
PEER_FEDERATOR_HOST=workstation-a
PEER_FEDERATOR_NAME=workstation-a
# Remote lane execution grants every host connected to this trusted hub the ability to run
# native lane commands as this user. It is disabled unless explicitly enabled.
PEER_FEDERATOR_ENABLE_REMOTE_LANES=false
# Optional launcher overrides. When enabled and unset, the agent searches PATH and ~/.local/bin.
# PEER_FEDERATOR_CODEX_LANE=/home/USER/.local/bin/codex-peer-lane
# PEER_FEDERATOR_CLAUDE_LANE=/home/USER/.local/bin/claude-peer-lane
# PEER_FEDERATOR_GROK_LANE=/home/USER/.local/bin/grok-peer-lane
# PEER_FEDERATOR_QWEN_LANE=/home/USER/.local/bin/qwen-peer-lane
# Qwen readiness uses the exact profile selected for this agent. Leave both
# unset for Qwen's native ~/.qwen/default runtime, or set absolute non-symlink
# paths that match the profile where make install-qwen was run.
# QWEN_HOME=/home/USER/.qwen
# QWEN_RUNTIME_DIR=/run/user/1000/qwen
