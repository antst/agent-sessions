[Unit]
Description=Peer Federator VLAN hub
Documentation=https://github.com/antst/agent-sessions/blob/main/docs/FEDERATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/peer-federator/hub.env
ExecStart=/usr/bin/env peer-federator hub
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
