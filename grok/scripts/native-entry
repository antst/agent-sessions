#!/usr/bin/env bash
set -euo pipefail

# Grok starts this stdio MCP entry in both peer and lane mode.
peer_binary="${SESSIONBUS_GROK_PEER_BINARY:-${HOME}/.local/bin/grok-peer}"
if [[ ! -x "$peer_binary" ]]; then
  printf 'sessionbus: grok-peer is not installed\n' >&2
  exit 1
fi
exec "$peer_binary" mcp
