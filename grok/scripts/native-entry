#!/usr/bin/env bash
set -euo pipefail

# Installed stateless connector entry point; never falls back to a legacy runtime.

host_binary="${AGENT_SESSIONS_HOST_BINARY:-}"
if [[ -z "$host_binary" ]]; then
  default_binary="${HOME}/.local/libexec/agent-sessions/host/current/bin/agent-sessions"
  if [[ -x "$default_binary" ]]; then
    host_binary="$default_binary"
  else
    host_binary="$(command -v agent-sessions 2>/dev/null || true)"
  fi
fi
if [[ -z "$host_binary" || ! -x "$host_binary" ]]; then
  printf 'agent-sessions: unified host binary is not installed; run make install-all first\n' >&2
  exit 1
fi
exec "$host_binary" "$@"
