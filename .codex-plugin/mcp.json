{
  "mcpServers": {
    "agent_sessions": {
      "command": "codex-peer",
      "args": [
        "mcp"
      ],
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "AGENTBUS_SOCKET",
        "AGENTBUS_LOCAL_KEY",
        "AGENTBUS_SESSION_ID",
        "AGENTBUS_SESSION_NAME",
        "AGENTBUS_GROUPS",
        "CODEX_HOME"
      ],
      "tool_timeout_sec": 86520
    }
  }
}
