{
  "mcpServers": {
    "sessionbus": {
      "command": "codex-peer",
      "args": [
        "mcp"
      ],
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "SESSIONBUS_SOCKET",
        "SESSIONBUS_LOCAL_KEY",
        "SESSIONBUS_SESSION_ID",
        "SESSIONBUS_SESSION_NAME",
        "SESSIONBUS_GROUPS",
        "CODEX_HOME"
      ],
      "tool_timeout_sec": 86520
    }
  }
}
