#!/bin/sh
set -eu

# Read-only preflight for the canonical host client. It never starts, installs,
# configures, or repairs the user daemon.

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g')"
}

json_bool() {
  if [ "$1" = "1" ]; then printf 'true'; else printf 'false'; fi
}

json_string_field() {
  awk -v key="\"$1\"" '
    {
      start = index($0, key)
      if (start == 0) next
      value = substr($0, start + length(key))
      if (sub(/^[[:space:]]*:[[:space:]]*"/, "", value) != 1) next
      finish = index(value, "\"")
      if (finish > 0) {
        print substr(value, 1, finish - 1)
        exit
      }
    }
  '
}

json_bool_field() {
  awk -v key="\"$1\"" '
    {
      start = index($0, key)
      if (start == 0) next
      value = substr($0, start + length(key))
      if (sub(/^[[:space:]]*:[[:space:]]*/, "", value) != 1) next
      if (substr(value, 1, 4) == "true") {
        print "true"
        exit
      }
      if (substr(value, 1, 5) == "false") {
        print "false"
        exit
      }
    }
  '
}

launcher="$(command -v codex-peer-lane 2>/dev/null || true)"
launcher_found=0
[ -z "$launcher" ] || launcher_found=1
doctor_json=null
doctor_exit=1
authority=""
product=""
ready=""

if [ "$launcher_found" = "1" ]; then
  if doctor_json="$("$launcher" doctor --json 2>/dev/null)"; then
    doctor_exit=0
  else
    doctor_exit=$?
  fi
  authority="$(printf '%s\n' "$doctor_json" | json_string_field authority)"
  product="$(printf '%s\n' "$doctor_json" | json_string_field product)"
  ready="$(printf '%s\n' "$doctor_json" | json_bool_field ready)"
fi

daemon_ready=0
if [ "$doctor_exit" = "0" ] && [ "$authority" = "daemon" ] &&
  [ "$product" = "codex" ] && [ "$ready" = "true" ]; then
  daemon_ready=1
fi

if [ "$launcher_found" = "0" ]; then
  summary="Codex lane launcher is not installed; show references/install.md and stop"
elif [ "$daemon_ready" = "0" ]; then
  summary="Codex lane daemon or adapter is unavailable; report doctor and stop"
else
  summary=ready
fi

peer_discovery=0
command -v claude >/dev/null 2>&1 && peer_discovery=1

printf '{\n'
printf '  "summary": %s,\n' "$(json_string "$summary")"
printf '  "launcher_found": %s,\n' "$(json_bool "$launcher_found")"
printf '  "invocation": %s,\n' "$(json_string "$launcher")"
printf '  "daemon_ready": %s,\n' "$(json_bool "$daemon_ready")"
printf '  "doctor_exit": %s,\n' "$doctor_exit"
printf '  "authority": %s,\n' "$(json_string "$authority")"
printf '  "product": %s,\n' "$(json_string "$product")"
printf '  "peer_discovery_cli": %s,\n' "$(json_bool "$peer_discovery")"
printf '  "doctor": %s\n' "$doctor_json"
printf '}\n'

[ "$daemon_ready" = "1" ]
