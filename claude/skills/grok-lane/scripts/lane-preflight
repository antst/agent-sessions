#!/bin/sh
set -eu

expected_contract_version=2
state_root="${AGENT_SESSIONS_STATE_ROOT:-${XDG_STATE_HOME:-${HOME}/.local/state}/agent-sessions}"

json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g')"
}
json_bool() {
  if [ "$1" = 1 ]; then printf true; else printf false; fi
}

runtime_path="$(command -v grok-peer-lane 2>/dev/null || true)"
launcher_found=0
[ -z "$runtime_path" ] || launcher_found=1
invocation="$runtime_path"

doctor_json=null
doctor_exit=1
contract_version=""
runtime_ready=0
if [ -n "$invocation" ]; then
  if doctor_json="$($invocation doctor --json 2>/dev/null)"; then
    doctor_exit=0
  else
    doctor_exit=$?
  fi
  contract_version="$(printf '%s' "$doctor_json" |
    sed -n 's/.*"contract_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n 1p)"
  if [ "$doctor_exit" = 0 ] && [ "$contract_version" = "$expected_contract_version" ]; then
    runtime_ready=1
  fi
fi

if [ "$runtime_ready" = 1 ]; then
  summary=ready
elif [ -z "$runtime_path" ]; then
  summary="Grok lane runtime is not installed; show references/install.md and stop"
else
  summary="Grok lane runtime or Grok Build preflight failed; report doctor and stop"
fi

printf '{\n'
printf '  "summary": %s,\n' "$(json_string "$summary")"
printf '  "launcher_found": %s,\n' "$(json_bool "$launcher_found")"
printf '  "runtime_found": %s,\n' "$(if [ -n "$runtime_path" ]; then printf true; else printf false; fi)"
printf '  "runtime_path": %s,\n' "$(json_string "$runtime_path")"
printf '  "invocation": %s,\n' "$(json_string "$invocation")"
printf '  "expected_contract_version": %s,\n' "$expected_contract_version"
printf '  "contract_version": %s,\n' "${contract_version:-null}"
printf '  "runtime_ready": %s,\n' "$(json_bool "$runtime_ready")"
printf '  "doctor_exit": %s,\n' "$doctor_exit"
printf '  "doctor": %s\n' "$doctor_json"
printf '}\n'

[ "$runtime_ready" = 1 ]
