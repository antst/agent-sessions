{
  "mcpServers": {
    "agent_sessions": {
      "command": "./scripts/native-entry",
      "args": [
        "connector",
        "codex",
        "mcp"
      ],
      "cwd": ".",
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "AGENT_SESSIONS_HOST_BINARY",
        "AGENT_SESSIONS_INTERNAL_ATTACHMENT_ID",
        "AGENT_SESSIONS_INTERNAL_LAUNCH_CAPABILITY",
        "AGENT_SESSIONS_INTERNAL_PRODUCT",
        "AGENT_SESSIONS_INTERNAL_SESSION_ID",
        "AGENT_SESSIONS_AGENT_RUNTIME_DIR",
        "CLAUDE_CONFIG_DIR",
        "CLAUDE_PEER_CLAUDE_BIN",
        "CLAUDE_PLUGIN_DATA",
        "CLAUDE_PEER_CLAUDE_CONFIG_DIR",
        "CLAUDE_PEER_DATA_DIR",
        "CODEX_HOME",
        "GROK_PEER_GROK_BIN",
        "PLUGIN_DATA",
        "TMPDIR",
        "XDG_RUNTIME_DIR",
        "XDG_STATE_HOME"
      ],
      "tool_timeout_sec": 86520
    }
  }
}
