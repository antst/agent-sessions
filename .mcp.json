{
  "mcpServers": {
    "agent_sessions": {
      "command": "./scripts/native-entry",
      "args": [
        "connector",
        "auto",
        "--release-identity",
        "@AGENT_SESSIONS_RELEASE_ID@"
      ],
      "cwd": ".",
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "AGENT_SESSIONS_AGENT_RUNTIME_DIR",
        "CLAUDE_CONFIG_DIR",
        "CLAUDE_PEER_CLAUDE_BIN",
        "CLAUDE_PLUGIN_DATA",
        "CLAUDE_PEER_CLAUDE_CONFIG_DIR",
        "AGENT_SESSIONS_STATE_ROOT",
        "CODEX_HOME",
        "GROK_PEER_GROK_BIN",
        "PLUGIN_DATA",
        "TMPDIR",
        "XDG_RUNTIME_DIR",
        "XDG_STATE_HOME"
      ],
      "tool_timeout_sec": 86520
    }
  }
}
